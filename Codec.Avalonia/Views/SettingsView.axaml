<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Codec.Converters"
             x:Class="Codec.Views.SettingsView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <converters:PngBytesToBitmapConverter x:Key="PngConverter" />
    <converters:BooleanNegationConverter x:Key="NotConverter" />
  </UserControl.Resources>

  <Border Classes="overlay" Width="560" MaxHeight="680" Padding="24">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Classes="title" FontSize="26" Text="Settings" />
          <TextBlock Classes="caption" Text="{Binding AppVersion}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon-quiet" Width="36" Height="36" Click="Close_Click" ToolTip.Tip="Close settings"><LucideIcon Kind="X" Size="16" StrokeWidth="1.75" /></Button>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="22">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="meta-value" Text="Scan on startup" />
              <TextBlock Classes="caption" Text="Keep installed games up to date." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScanOnStartup, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="meta-value" Text="Launch Steam quietly" />
              <TextBlock Classes="caption" Text="Start Steam without opening its window." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSteamSilent, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="meta-value" Text="Close to tray" />
              <TextBlock Classes="caption" Text="Keep Codec available in the background." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource CodecBorderBrush}" />

          <StackPanel Spacing="10">
            <TextBlock Classes="meta-label" Text="Steam" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="meta-value" Text="{Binding SteamAccountDisplay}" />
                <TextBlock Classes="caption" Text="{Binding SteamSyncProgressMessage}" IsVisible="{Binding IsSteamSyncProgressVisible}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Connect" Command="{Binding ConnectSteamCommand}" IsVisible="{Binding IsSteamConnected, Converter={StaticResource NotConverter}}" />
                <Button Content="Sync now" Command="{Binding SyncSteamLibraryCommand}" IsVisible="{Binding IsSteamConnected}" />
                <Button Content="Disconnect" Click="ShowDisconnect_Click" IsVisible="{Binding IsSteamConnected}" />
              </StackPanel>
            </Grid>
            <ProgressBar Minimum="0" Maximum="{Binding SteamSyncProgressMaximum}" Value="{Binding SteamSyncProgressValue}" IsIndeterminate="{Binding IsSteamSyncProgressIndeterminate}" IsVisible="{Binding IsSteamSyncProgressVisible}" />
            <Border Classes="detail-surface" Width="260" Padding="14" HorizontalAlignment="Left" IsVisible="{Binding IsSteamQrVisible}">
              <StackPanel Spacing="9">
                <Image Width="220" Height="220" Source="{Binding SteamQrCodePng, Converter={StaticResource PngConverter}}" />
                <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Scan with the Steam mobile app." />
                <Button Content="Cancel" Command="{Binding CancelSteamSignInCommand}" />
              </StackPanel>
            </Border>
            <Border x:Name="DisconnectConfirmation" Classes="detail-surface" Padding="14" IsVisible="False">
              <StackPanel Spacing="10">
                <TextBlock Classes="meta-value" Text="Disconnect Steam?" />
                <TextBlock Classes="caption" Text="Steam-owned games will be hidden until you connect again." TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Content="Cancel" Click="HideDisconnect_Click" />
                  <Button Grid.Column="1" Classes="primary" Content="Disconnect" Click="ConfirmDisconnect_Click" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource CodecBorderBrush}" />

          <StackPanel Spacing="9">
            <TextBlock Classes="meta-label" Text="Maintenance" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
              <Button Grid.Column="1" Content="Refresh covers" Command="{Binding RefreshCoversCommand}" />
              <Button Grid.Column="2" Content="Reset Codec" Click="ShowReset_Click" />
            </Grid>
            <Border x:Name="ResetConfirmation" Classes="detail-surface" Padding="14" IsVisible="False">
              <StackPanel Spacing="10">
                <TextBlock Classes="meta-value" Text="Reset Codec?" />
                <TextBlock Classes="caption" Text="Library, artwork, settings, logs, and Steam sign-in will be removed." TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Content="Cancel" Click="HideReset_Click" />
                  <Button Grid.Column="1" Classes="primary" Content="Reset" Command="{Binding ResetApplicationCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Button Grid.Row="2"
              Margin="0,18,0,0"
              Background="Transparent"
              BorderThickness="0"
              HorizontalAlignment="Left"
              Command="{Binding OpenExternalLinkCommand}"
              CommandParameter="https://github.com/mkj777/codec">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="GitHub" />
          <LucideIcon Kind="ExternalLink" Size="15" StrokeWidth="1.75" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
