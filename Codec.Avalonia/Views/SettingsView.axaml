<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             xmlns:converters="using:Codec.Converters"
             x:Class="Codec.Views.SettingsView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <converters:PngBytesToBitmapConverter x:Key="PngConverter" />
    <converters:BooleanNegationConverter x:Key="NotConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The disclosure draws no border, so keyboard focus needs its ring drawn here. -->
    <Style Selector="Button.hidden-games:focus-visible">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryLineHoverBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <!--
    One surface, rows inside it. No cards within cards. The host gives this view a fixed
    height and the surface hangs from its top, so a row that opens grows the surface downward
    instead of re-centring it under the pointer.
  -->
  <Border Classes="overlay" Width="440" MaxHeight="560" Padding="22" VerticalAlignment="Top">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Settings" />
          <TextBlock Classes="caption" Text="{Binding AppVersion}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon-quiet" Click="Close_Click" ToolTip.Tip="Close settings"><LucideIcon Kind="X" Size="16" StrokeWidth="1.75" /></Button>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="22">
          <StackPanel Spacing="0">
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="2">
                  <TextBlock Classes="meta-value" Text="Scan on startup" />
                  <TextBlock Classes="caption" Text="Keep installed games up to date." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ScanOnStartup, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="2">
                  <TextBlock Classes="meta-value" Text="Launch Steam quietly" />
                  <TextBlock Classes="caption" Text="Start Steam without opening its window." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LaunchSteamSilent, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="2">
                  <TextBlock Classes="meta-value" Text="Close to tray" />
                  <TextBlock Classes="caption" Text="Keep Codec available in the background." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Classes="meta-label" Text="Steam" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="meta-value" Text="{Binding SteamAccountDisplay}" />
                <TextBlock Classes="caption" Text="{Binding SteamStatusCaption}" IsVisible="{Binding HasSteamStatusCaption}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="ghost ghost-primary" Content="Connect" Command="{Binding ConnectSteamCommand}" IsVisible="{Binding IsSteamConnected, Converter={StaticResource NotConverter}}" />
                <!-- The label changes while a sync runs; unseen copies of both hold the button at the longer one. -->
                <Button Classes="ghost" Command="{Binding SyncSteamLibraryCommand}" IsEnabled="{Binding AreSteamActionsEnabled}" IsVisible="{Binding IsSteamConnected}">
                  <Grid>
                    <TextBlock Text="{Binding SteamSyncButtonText}" />
                    <TextBlock Text="Sync now" Opacity="0" IsHitTestVisible="False" />
                    <TextBlock Text="Syncing..." Opacity="0" IsHitTestVisible="False" />

                  </Grid>
                </Button>
                <Button Classes="ghost" Content="Disconnect" Click="ShowDisconnect_Click" IsVisible="{Binding IsSteamConnected}" />
              </StackPanel>

              <!--
                The sync line hangs in the gap under the row, where the stack's spacing would
                have put it, without taking room: everything below would otherwise drop by a
                line when a sync starts and climb back when it ends.
              -->
              <controls:Hairline Grid.ColumnSpan="2"
                                 Classes="reveal-soft"
                                 Margin="0,0,0,-13"
                                 VerticalAlignment="Bottom"
                                 IsVisible="False"
                                 controls:Reveal.IsOpen="{Binding IsSteamSyncProgressVisible}"
                                 IsIndeterminate="{Binding IsSteamSyncProgressIndeterminate}"
                                 Value="{Binding SteamSyncProgressValue}"
                                 Maximum="{Binding SteamSyncProgressMaximum}" />
            </Grid>

            <StackPanel Classes="reveal"
                        Width="260"
                        Spacing="12"
                        HorizontalAlignment="Left"
                        IsVisible="False"
                        controls:Reveal.IsOpen="{Binding IsSteamQrVisible}">

              <Image Width="220" Height="220" Source="{Binding SteamQrCodePng, Converter={StaticResource PngConverter}}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Scan with the Steam mobile app." />
              <Button Classes="text-btn" HorizontalAlignment="Center" Content="Cancel" Command="{Binding CancelSteamSignInCommand}" />
            </StackPanel>

            <StackPanel x:Name="DisconnectConfirmation" Classes="reveal" Spacing="12" IsVisible="False">
              <Border Classes="rule" />
              <TextBlock Classes="meta-value" Text="Disconnect Steam?" />
              <TextBlock Classes="caption" Text="Steam-owned games will be hidden until you connect again." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Button Classes="play" Click="ConfirmDisconnect_Click" Content="Disconnect" />
                <Button Classes="text-btn" Click="HideDisconnect_Click" Content="Cancel" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Classes="meta-label" Text="Maintenance" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsUiEnabled}" />
              <Button Classes="ghost" Content="Reset Codec" Click="ShowReset_Click" IsEnabled="{Binding IsUiEnabled}" />
            </StackPanel>
            <StackPanel x:Name="ResetConfirmation" Classes="reveal" Spacing="12" IsVisible="False">

              <Border Classes="rule" />
              <TextBlock Classes="meta-value" Text="Reset Codec?" />
              <TextBlock Classes="caption" Text="Library, artwork, settings, logs, and Steam sign-in will be removed." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Button Classes="play" Content="Reset" Command="{Binding ResetApplicationCommand}" IsEnabled="{Binding IsUiEnabled}" />
                <Button Classes="text-btn" Click="HideReset_Click" Content="Cancel" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!--
            The way back for hidden games. It only exists while something is hidden, and the
            list opens in place under its row rather than as a page of its own.
          -->
          <StackPanel Classes="reveal"
                      Spacing="0"
                      IsVisible="False"
                      controls:Reveal.IsOpen="{Binding HasHiddenGames}">
            <Border Classes="meta-row" Padding="0">
              <Button Classes="disclosure hidden-games"
                      Classes.open="{Binding IsHiddenGamesExpanded}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0,11"
                      Command="{Binding ToggleHiddenGamesCommand}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Classes="meta-value" VerticalAlignment="Center" Text="Hidden and ignored" />
                  <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="{Binding HiddenGameCount}" />
                  <LucideIcon Grid.Column="2" Kind="ChevronDown" Size="13" StrokeWidth="1.75" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Border>

            <ItemsControl x:Name="HiddenGamesList"
                          Classes="reveal"
                          Margin="14,0,0,0"
                          IsVisible="False"
                          controls:Reveal.IsOpen="{Binding IsHiddenGamesExpanded}"
                          ItemsSource="{Binding HiddenGames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="meta-row" Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                      <TextBlock Classes="meta-value"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Name}" />
                      <Button Grid.Column="1"
                              Classes="text-btn"
                              VerticalAlignment="Center"
                              Content="Restore"
                              Command="{Binding DataContext.RestoreHiddenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The developer corner. Nothing here is for a player, so it only exists in a debug build. -->
          <StackPanel Spacing="12" IsVisible="{Binding IsDebugMode}">
            <TextBlock Classes="meta-label" Text="Debug" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="ghost" Margin="0,0,8,8" Content="Debug data" Command="{Binding DebugDumpDataCommand}" IsEnabled="{Binding IsUiEnabled}" />
              <Button Classes="ghost" Margin="0,0,8,8" Content="Refresh covers" Command="{Binding RefreshCoversCommand}" IsEnabled="{Binding IsUiEnabled}" />
              <Button Classes="ghost" Margin="0,0,8,8" Content="Check IDs" Command="{Binding DebugCheckIdsCommand}" IsEnabled="{Binding IsUiEnabled}" />
              <Button Classes="ghost" Margin="0,0,8,8" Content="Start Steam silent" Command="{Binding DebugLaunchSteamSilentCommand}" IsEnabled="{Binding IsUiEnabled}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Button Grid.Row="2"
              Classes="text-btn"
              Margin="0,22,0,0"
              HorizontalAlignment="Left"
              Foreground="{DynamicResource CodecTextMutedBrush}"
              Command="{Binding OpenExternalLinkCommand}"
              CommandParameter="https://github.com/mkj777/codec">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="GitHub" FontSize="13.5" />
          <LucideIcon Kind="ExternalLink" Size="13" StrokeWidth="1.75" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
