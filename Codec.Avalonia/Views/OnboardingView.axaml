<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             xmlns:converters="using:Codec.Converters"
             x:Class="Codec.Views.OnboardingView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <!-- the active dot stretches into a bar rather than swapping places -->
    <Style Selector="Border.step-dot">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
          <BrushTransition Property="Background" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <converters:PngBytesToBitmapConverter x:Key="PngConverter" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource CodecBackgroundBrush}">
    <!-- one warm bloom behind the first thing anyone sees of Codec -->
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="24%,34%" GradientOrigin="24%,34%" RadiusX="0.47" RadiusY="0.57">
          <GradientStop Offset="0" Color="#1CE76C2B" />
          <GradientStop Offset="1" Color="#00E76C2B" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <TextBlock Margin="40,30"
               Classes="wordmark"
               FontSize="16"
               LetterSpacing="-0.24"
               Opacity="0.85"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               Text="Codec" />

    <Grid x:Name="IntroStep"
          Classes="reveal"
          Margin="78,0"
          IsVisible="False"
          ColumnDefinitions="*,288"
          ColumnSpacing="50">
      <StackPanel VerticalAlignment="Center" Spacing="19">
        <TextBlock Classes="ob-title" Text="A quiet home&#x0a;for your games." />
        <TextBlock MaxWidth="330"
                   HorizontalAlignment="Left"
                   FontSize="15"
                   LineHeight="25"
                   Foreground="{DynamicResource CodecTextMutedBrush}"
                   Text="Codec gathers everything you own into one shelf, then gets out of the way."
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
          <Button Classes="play play-lg" Click="Begin_Click">
            <TextBlock Text="Begin" FontFamily="{StaticResource CodecDisplayFontFamily}" FontWeight="700" FontSize="14.5" />
          </Button>
          <Button Classes="text-btn" Content="Skip" Click="Skip_Click" />
        </StackPanel>
      </StackPanel>
      <Image Grid.Column="1"
             Width="288"
             Height="216"
             Stretch="Uniform"
             Opacity="0.95"
             Source="/Assets/shrimpSleep.png" />
    </Grid>

    <Grid x:Name="SetupStep"
          Classes="reveal"
          Margin="78,0"
          IsVisible="False"
          ColumnDefinitions="*,260"
          ColumnSpacing="50">
      <StackPanel VerticalAlignment="Center" Spacing="19">
        <TextBlock Classes="ob-subtitle" Text="Where should we look?" />
        <TextBlock MaxWidth="330"
                   HorizontalAlignment="Left"
                   FontSize="15"
                   LineHeight="25"
                   Foreground="{DynamicResource CodecTextMutedBrush}"
                   Text="Find games on this PC, or connect Steam. You can change this later."
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
          <Button Classes="play play-lg" Click="FindGames_Click">
            <TextBlock Text="Find games" FontFamily="{StaticResource CodecDisplayFontFamily}" FontWeight="700" FontSize="14.5" />
          </Button>
          <Button Classes="ghost" Content="Connect Steam" Command="{Binding ConnectSteamCommand}" />
          <Button Classes="text-btn" Content="Continue" Click="Continue_Click" />
        </StackPanel>

        <StackPanel Width="260"
                    HorizontalAlignment="Left"
                    Spacing="12"
                    IsVisible="{Binding IsSteamQrVisible}">
          <Image Width="220" Height="220" Source="{Binding SteamQrCodePng, Converter={StaticResource PngConverter}}" />
          <TextBlock Classes="caption" Text="Scan with the Steam mobile app." HorizontalAlignment="Center" />
          <Button Classes="text-btn" HorizontalAlignment="Center" Content="Cancel" Command="{Binding CancelSteamSignInCommand}" />
        </StackPanel>
      </StackPanel>
      <Image Grid.Column="1" Width="230" Stretch="Uniform" Source="/Assets/shrimpStand.png" />
    </Grid>

    <!-- the first-run scan: a sweeping hairline that goes solid when the shelf is ready -->
    <StackPanel x:Name="ReadyStep"
                Classes="reveal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                IsVisible="False">
      <TextBlock Classes="screen-title" HorizontalAlignment="Center" Text="{Binding ScanScreenTitle}" />
      <controls:Hairline Width="190"
                         HorizontalAlignment="Center"
                         IsIndeterminate="{Binding IsScanScreenBusy}"
                         IsComplete="{Binding IsScanScreenComplete}" />
      <!--
        The note and the button share one slot the height of the button. The step is centred,
        so swapping one for the other in the stack would move the title as the scan finishes.
      -->
      <Grid>
        <TextBlock Classes="caption hold"
                   Classes.shown="{Binding IsScanScreenBusy}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Text="This takes a moment." />
        <!-- Faded on a wrapper, because the button's own disabled style sets its opacity. -->
        <Panel Classes="hold"
               Classes.shown="{Binding IsScanScreenComplete}"
               HorizontalAlignment="Center">
          <Button Classes="play play-lg"
                  IsEnabled="{Binding IsScanScreenComplete}"
                  Click="OpenLibrary_Click">
            <TextBlock Text="Open library" FontFamily="{StaticResource CodecDisplayFontFamily}" FontWeight="700" FontSize="14.5" />
          </Button>
        </Panel>

      </Grid>

    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="78,0,0,40"
                Orientation="Horizontal"
                Spacing="7">
      <Border x:Name="Progress0" Classes="step-dot" Width="18" Background="{DynamicResource CodecPrimaryBrush}" />
      <Border x:Name="Progress1" Classes="step-dot" Opacity="0.35" Background="{DynamicResource CodecTextMutedBrush}" />
      <Border x:Name="Progress2" Classes="step-dot" Opacity="0.35" Background="{DynamicResource CodecTextMutedBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
