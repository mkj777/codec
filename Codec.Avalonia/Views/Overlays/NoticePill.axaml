<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             x:Class="Codec.Views.Overlays.NoticePill"
             x:CompileBindings="False">
  <!--
    One activity, one line, one progress value. Background work reports itself
    here and never blocks the shelf.
  -->
  <StackPanel Classes="reveal"
              Spacing="8"
              IsVisible="False"
              controls:Reveal.IsOpen="{Binding IsNoticeVisible}">
    <Border Classes="notice" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
        <Ellipse Width="7"
                 Height="7"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource CodecPrimaryBrush}"
                 IsVisible="{Binding !IsNoticeBusy}" />
        <Ellipse Classes="breathe"
                 Width="7"
                 Height="7"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource CodecAccentBrush}"
                 IsVisible="{Binding IsNoticeBusy}" />

        <!--
          One line, and a second only where the first would be a fact without a meaning:
          knowing Codec is running as Administrator is no use without knowing what it costs.
        -->
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="NoticeLine"
                     FontSize="13.5"
                     Foreground="{DynamicResource CodecTextBrush}"
                     Text="{Binding NoticeText}" />
          <TextBlock Classes="caption"
                     MaxWidth="360"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasNoticeDetail}"
                     Text="{Binding NoticeDetail}" />
        </StackPanel>

        <Button Classes="text-btn"
                VerticalAlignment="Center"
                Margin="4,0,0,0"
                Foreground="{DynamicResource CodecPrimaryBrush}"
                FontSize="13.5"
                FontWeight="600"
                IsVisible="{Binding HasNoticeAction}"
                Content="{Binding NoticeActionText}"
                Command="{Binding RestartToUpdateCommand}" />

        <Button Classes="icon-quiet"
                Width="22"
                Height="22"
                VerticalAlignment="Center"
                Margin="2,0,-6,0"
                Foreground="{DynamicResource CodecTextMutedBrush}"
                IsVisible="{Binding IsNoticeDismissible}"
                Command="{Binding DismissNoticeCommand}"
                AutomationProperties.Name="Dismiss"
                ToolTip.Tip="Dismiss">
          <LucideIcon Kind="X" Size="13" StrokeWidth="1.75" />
        </Button>
      </StackPanel>
    </Border>

    <!--
      The line keeps its place under every notice and only fades. The pill hangs from the
      bottom of the window, so a line that came and went would lift and drop it each time work
      started or finished.
    -->
    <controls:Hairline Classes="hold"
                       Classes.shown="{Binding IsNoticeProgressVisible}"
                       Width="220"
                       HorizontalAlignment="Center"

                       IsIndeterminate="{Binding IsNoticeIndeterminate}"
                       Value="{Binding NoticeProgress}"
                       Maximum="100" />
  </StackPanel>
</UserControl>
