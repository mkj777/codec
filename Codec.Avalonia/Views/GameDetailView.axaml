<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             xmlns:converters="using:Codec.Converters"
             xmlns:media="using:Codec.Media"
             xmlns:views="using:Codec.Views"
             x:Class="Codec.Views.GameDetailView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <converters:BooleanNegationConverter x:Key="NotConverter" />
    <converters:DateToStringConverter x:Key="DateConverter" />
    <converters:DateToYearConverter x:Key="YearConverter" />
    <converters:FirstItemConverter x:Key="FirstItemConverter" />
    <converters:FirstNonEmptyConverter x:Key="FirstNonEmptyConverter" />
    <converters:HasTextConverter x:Key="HasTextConverter" />
    <converters:MediaTypeConverter x:Key="MediaTypeConverter" />
    <converters:NullOrEmptyToFallbackConverter x:Key="FallbackConverter" />
    <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    <converters:StringToUriConverter x:Key="StringToUriConverter" />
  </UserControl.Resources>

  <Grid x:Name="PageRoot"
        Classes="detail-page"
        Background="{DynamicResource CodecBackgroundBrush}">
    <!-- The bar lies over the page, so a page that starts or stops scrolling keeps its width. -->
    <ScrollViewer x:Name="DetailScroller"
                  Classes="persistent-scroll overlay-bar"
                  AllowAutoHide="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!--
          Cinema. The art stays sharp and fills the first viewport; the page
          reads as a lower third over it.
        -->
        <Grid x:Name="HeroBand" MinHeight="470" ClipToBounds="True">
          <!--
            The band is as tall as the artwork wants to be at this width, never the whole
            viewport. A 3:1 hero forced into a viewport-tall frame has to lose most of its sides
            to cover it, which is what read as zoomed in. The code-behind holds the band at a
            hero's height before the bitmap decodes, so the lower third does not drop under it.
          -->
          <media:CodecImage IntrinsicSize="True"
                            Stretch="Uniform"
                            VerticalAlignment="Top"
                            MaxHeight="{Binding #DetailScroller.Bounds.Height}">
            <media:CodecImage.Source>
              <MultiBinding Converter="{StaticResource FirstNonEmptyConverter}">
                <Binding Path="SelectedGame.LibraryHero" />
                <Binding Path="SelectedGame.LibraryCapsule" />
              </MultiBinding>
            </media:CodecImage.Source>
          </media:CodecImage>

          <!-- veil 1: the lower third rises out of the art -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#FB181613" />
                <GradientStop Offset="0.17" Color="#F0181613" />
                <GradientStop Offset="0.36" Color="#A8181613" />
                <GradientStop Offset="0.57" Color="#33181613" />
                <GradientStop Offset="0.76" Color="#00181613" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- veil 2: settles the caption strip -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#E0181613" />
                <GradientStop Offset="0.22" Color="#59181613" />
                <GradientStop Offset="0.38" Color="#00181613" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- veil 3: the game's own colour, rising from the bottom centre -->
          <Border media:ArtTint.GlowSource="{Binding SelectedGame.LibraryCapsule}" />

          <!--
            The lower third holds a column of copy and a column of meta. At the narrowest of
            the three page widths the meta drops below the copy rather than squeezing it; the
            column width and the row it lands in both come from the page's own layout pass.
          -->
          <Grid x:Name="HeroCopyGrid"
                Classes="hero-copy"
                VerticalAlignment="Bottom"
                ZIndex="3"
                RowSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Classes="hero-text"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Classes="factline shadow-meta"
                           Text="{Binding SelectedGame.ImportedFromDisplay}" />
                <TextBlock Classes="factline shadow-meta"
                           IsVisible="{Binding SelectedGame.HasIgdbGenres}"
                           Text="{Binding SelectedGame.Genres, Converter={StaticResource FirstItemConverter}}" />
                <TextBlock Classes="factline shadow-meta"
                           Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource YearConverter}}" />
              </StackPanel>

              <media:CodecImage IsVisible="{Binding SelectedGame.HasLogo}"
                                Source="{Binding SelectedGame.LibraryLogo}"
                                IntrinsicSize="True"
                                Stretch="Uniform"
                                Height="132"
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                ZIndex="6"
                                IsHitTestVisible="False" />

              <TextBlock Classes="page-title shadow-title"
                         IsVisible="{Binding !SelectedGame.HasLogo}"
                         Text="{Binding SelectedGame.Name}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="2"
                         TextWrapping="Wrap" />

              <TextBlock Classes="blurb shadow-body"
                         MaxWidth="440"
                         HorizontalAlignment="Left"
                         TextWrapping="Wrap"
                         MaxLines="3"
                         TextTrimming="WordEllipsis"
                         Text="{Binding SelectedGame.Description, Converter={StaticResource FallbackConverter}}" />

              <!--
                The launch hairline hangs 16px under the row, where the stack's spacing would
                have put it, but outside the row's measure: the copy is anchored to the bottom,
                so a line that took up room would lift all of it the moment Play is pressed.
              -->
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <Button Classes="play play-lg"
                          controls:Interaction.PulseOnClick="True"
                          Command="{Binding PlayGameCommand}"
                          IsEnabled="{Binding CanPlaySelectedGame}"
                          ToolTip.Tip="{Binding PlayButtonToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <LucideIcon Kind="Play" Size="14" StrokeWidth="2" />
                      <TextBlock Text="{Binding PlayButtonText}"
                                 FontFamily="{StaticResource CodecDisplayFontFamily}"
                                 FontWeight="700"
                                 FontSize="14.5" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="GameSettingsButton"
                          Classes="icon-ghost"
                          Command="{Binding ToggleGameSettingsCommand}"
                          ToolTip.Tip="Game settings">
                    <LucideIcon Kind="Settings" Size="17" StrokeWidth="1.75" />
                  </Button>
                  <TextBlock Classes="quiet-note shadow-meta"
                             VerticalAlignment="Center"
                             IsVisible="{Binding SelectedGame.IsInstalled, Converter={StaticResource NotConverter}}"
                             Text="Not installed" />

                  <!-- The same game, already in the Steam library: worth knowing before buying twice. -->
                  <Border Classes="own-badge"
                          VerticalAlignment="Center"
                          IsVisible="{Binding SelectedGame.IsAlsoOwnedOnSteam}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <LucideIcon VerticalAlignment="Center"
                                  Kind="Library"
                                  Size="12"
                                  StrokeWidth="1.75"
                                  Foreground="{DynamicResource CodecAccentBrush}" />
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="11.5"
                                 FontWeight="600"
                                 Foreground="{DynamicResource CodecTextBrush}"
                                 Text="You also own this on Steam" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <controls:Hairline Classes="reveal-soft"
                                   Width="120"
                                   Margin="0,0,0,-17"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   IsIndeterminate="True"
                                   IsVisible="False"
                                   controls:Reveal.IsOpen="{Binding IsLaunchSpinnerVisible}" />
              </Grid>
            </StackPanel>

            <StackPanel Classes="hero-meta"
                        Margin="0,0,0,4"
                        VerticalAlignment="Bottom">
              <Border Classes="meta-row on-art">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                  <TextBlock Classes="meta-label shadow-meta" Text="Developer" />
                  <TextBlock Grid.Column="1"
                             Classes="meta-value shadow-meta"
                             FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                             TextAlignment="Right"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding SelectedGame.Developer, Converter={StaticResource FallbackConverter}}" />
                </Grid>
              </Border>
              <Border Classes="meta-row on-art">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                  <TextBlock Classes="meta-label shadow-meta" Text="Released" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="meta-value shadow-meta"
                               FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                               TextAlignment="Right"
                               Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource DateConverter}}" />
                    <!-- A remaster carries the date of the game it remade as well. -->
                    <TextBlock Classes="caption shadow-meta"
                               TextAlignment="Right"
                               IsVisible="{Binding SelectedGame.HasOriginalReleaseDate}"
                               Text="{Binding SelectedGame.OriginalReleaseDisplay}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="meta-row on-art">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                  <TextBlock Classes="meta-label shadow-meta" Text="Main story" />
                  <TextBlock Grid.Column="1"
                             Classes="meta-value shadow-meta"
                             FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                             TextAlignment="Right"
                             Opacity="{Binding SelectedGame.MainStoryOpacity}"
                             Text="{Binding SelectedGame.DisplayMainStory}" />
                </Grid>
              </Border>

              <Button Classes="disclosure"
                      Classes.open="{Binding IsDetailMoreOpen}"
                      Foreground="{DynamicResource CodecTextMutedBrush}"
                      Command="{Binding ToggleDetailMoreCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <!-- Both labels sit unseen under the live one, so the chevron stays put when it flips. -->
                  <Grid>
                    <TextBlock Classes="shadow-meta" FontSize="12.5" Text="{Binding DetailMoreLabel}" />
                    <TextBlock FontSize="12.5" Text="More" Opacity="0" IsHitTestVisible="False" />
                    <TextBlock FontSize="12.5" Text="Less" Opacity="0" IsHitTestVisible="False" />
                  </Grid>
                  <LucideIcon Kind="ChevronDown" Size="11" StrokeWidth="1.75" />
                </StackPanel>

              </Button>

              <StackPanel Classes="reveal"
                          Spacing="0"
                          IsVisible="False"
                          controls:Reveal.IsOpen="{Binding IsDetailMoreOpen}">
                <Border Classes="meta-row on-art">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <TextBlock Classes="meta-label shadow-meta" Text="Publisher" />
                    <TextBlock Grid.Column="1"
                               Classes="meta-value shadow-meta"
                               FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedGame.Publisher, Converter={StaticResource FallbackConverter}}" />
                  </Grid>
                </Border>
                <Border Classes="meta-row on-art">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <TextBlock Classes="meta-label shadow-meta" Text="Age rating" />
                    <TextBlock Grid.Column="1"
                               Classes="meta-value shadow-meta"
                               FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Opacity="{Binding SelectedGame.AgeRatingOpacity}"
                               Text="{Binding SelectedGame.DisplayAgeRating}" />
                  </Grid>
                </Border>
                <Border Classes="meta-row on-art">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <TextBlock Classes="meta-label shadow-meta" Text="Price" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="7"
                                HorizontalAlignment="Right">
                      <TextBlock Classes="meta-value shadow-meta"
                                 FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                                 Text="{Binding SelectedGame.Price, Converter={StaticResource FallbackConverter}}" />
                      <TextBlock Classes="caption shadow-meta"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource CodecSecondaryBrush}"
                                 IsVisible="{Binding SelectedGame.PriceDiscount, Converter={StaticResource HasTextConverter}}"
                                 Text="{Binding SelectedGame.PriceDiscount}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="meta-row on-art">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <TextBlock Classes="meta-label shadow-meta" Text="Completionist" />
                    <TextBlock Grid.Column="1"
                               Classes="meta-value shadow-meta"
                               FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                               TextAlignment="Right"
                               Opacity="{Binding SelectedGame.CompletionistOpacity}"
                               Text="{Binding SelectedGame.DisplayCompletionist}" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>

        <!--
          The quiet section. Cinema carries four facts; everything else Codec
          knows continues here in the same row language, on the canvas.
        -->
        <StackPanel Classes="page-lower" Spacing="28">
          <StackPanel Spacing="0">
            <TextBlock Classes="meta-label" Margin="0,0,0,4" Text="Summary" />
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <TextBlock Classes="meta-label" Text="Steam reviews" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="meta-value"
                             FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                             TextAlignment="Right"
                             Opacity="{Binding SelectedGame.SteamReviewOpacity}"
                             Text="{Binding SelectedGame.DisplaySteamReviewSummary}" />
                  <!-- How many people said so, which is what makes the summary mean anything. -->
                  <TextBlock Classes="caption"
                             TextAlignment="Right"
                             IsVisible="{Binding SelectedGame.DisplaySteamReviewCount, Converter={StaticResource HasTextConverter}}"
                             Text="{Binding SelectedGame.DisplaySteamReviewCount}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <TextBlock Classes="meta-label" Text="Completionist" />
                <TextBlock Grid.Column="1"
                           Classes="meta-value"
                           FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                           TextAlignment="Right"
                           Opacity="{Binding SelectedGame.CompletionistOpacity}"
                           Text="{Binding SelectedGame.DisplayCompletionist}" />
              </Grid>
            </Border>
            <Border Classes="meta-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <TextBlock Classes="meta-label" Text="Controller" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="meta-value"
                             FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                             TextAlignment="Right"
                             Text="{Binding SelectedGame.ControllerSupportDisplay}" />
                  <TextBlock Classes="caption"
                             TextAlignment="Right"
                             Foreground="{DynamicResource CodecSecondaryBrush}"
                             IsVisible="{Binding SelectedGame.HasControllerRecommendation}"
                             Text="Recommended" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="meta-row" IsVisible="{Binding SelectedGame.HasSteamAchievementProgress}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="meta-label" Text="Steam achievements" />
                <TextBlock Grid.Column="1"
                           Classes="meta-value"
                           FontSize="{Binding DetailsValueFontSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                           TextAlignment="Right"
                           Text="{Binding SelectedGame.SteamAchievementProgressDisplay}" />
                <!-- Progress is a hairline, not a bar. -->
                <controls:Hairline Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Value="{Binding SelectedGame.SteamAchievementsUnlocked}"
                                   Maximum="{Binding SelectedGame.SteamAchievementsTotal}" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Classes="meta-label" Text="Description" />
            <TextBlock Classes="body"
                       Foreground="#CCF3EDC9"
                       TextWrapping="Wrap"
                       Text="{Binding SelectedGame.Description, Converter={StaticResource FallbackConverter}}" />
          </StackPanel>

          <StackPanel Spacing="18" IsVisible="{Binding SelectedGame.HasAnyIgdbTaxonomy}">
            <StackPanel Spacing="8" IsVisible="{Binding SelectedGame.HasIgdbGenres}">
              <TextBlock Classes="meta-label" Text="Genres" />
              <ItemsControl ItemsSource="{Binding SelectedGame.Genres}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Classes="taxonomy-chip" Margin="0,0,8,8"><TextBlock Classes="caption" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding SelectedGame.HasThemes}">
              <TextBlock Classes="meta-label" Text="Themes" />
              <ItemsControl ItemsSource="{Binding SelectedGame.Themes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Classes="taxonomy-chip" Margin="0,0,8,8"><TextBlock Classes="caption" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding SelectedGame.HasGameModes}">
              <TextBlock Classes="meta-label" Text="Game modes" />
              <ItemsControl ItemsSource="{Binding SelectedGame.GameModes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Classes="taxonomy-chip" Margin="0,0,8,8"><TextBlock Classes="caption" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding SelectedGame.HasMedia}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="meta-label" Text="Media" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SelectedGame.MediaCount}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- An ItemsControl clips to its bounds unless told otherwise; a hovered thumb grows past them. -->
              <ItemsControl ItemsSource="{Binding SelectedGame.MediaPreviewItems}" ClipToBounds="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="media-thumb"
                            Command="{Binding DataContext.OpenMediaOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Grid>
                        <media:CodecImage Source="{Binding}" Stretch="UniformToFill" IsVisible="{Binding Converter={StaticResource MediaTypeConverter}, ConverterParameter=image}" />
                        <LucideIcon HorizontalAlignment="Center" VerticalAlignment="Center" Kind="Play" Size="17" StrokeWidth="1.75" IsVisible="{Binding Converter={StaticResource MediaTypeConverter}, ConverterParameter=video}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- The shelf shows three; the rest are one click away rather than gone. -->
              <Button Classes="media-thumb media-more"
                      Command="{Binding OpenMediaOverlayCommand}"
                      IsVisible="{Binding SelectedGame.HasAdditionalMedia}"
                      AutomationProperties.Name="Open all media"
                      ToolTip.Tip="Open all media">
                <TextBlock Classes="caption" Text="{Binding SelectedGame.AdditionalMediaDisplay}" />
              </Button>
            </StackPanel>
          </StackPanel>

          <Grid x:Name="LowerSplitGrid" Classes="lower-split" RowSpacing="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="10" VerticalAlignment="Top">
              <TextBlock Classes="meta-label" Text="Platforms" />
              <ItemsControl ItemsSource="{Binding SelectedGame.PlatformLogoUris}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <media:CodecImage Width="{Binding DetailsPlatformIconSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                                      Height="{Binding DetailsPlatformIconSize, RelativeSource={RelativeSource AncestorType=views:GameDetailView}}"
                                      Source="{Binding}"
                                      Stretch="Uniform" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="link-row"
                      Margin="0,8,0,0"
                      Command="{Binding OpenFranchiseOverlayCommand}"
                      IsVisible="{Binding SelectedGame.FranchiseGames, Converter={StaticResource NullToBoolConverter}}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Franchise" />
                  <LucideIcon Grid.Column="1" Kind="ChevronRight" Size="15" StrokeWidth="1.75" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Classes="lower-links"
                        Spacing="0"
                        VerticalAlignment="Top">
              <TextBlock Classes="meta-label" Margin="0,0,0,4" Text="Links" />
              <Button Classes="link-row" Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding SelectedGame.OfficialWebsiteUrl}" IsVisible="{Binding SelectedGame.OfficialWebsiteUrl, Converter={StaticResource NullToBoolConverter}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Website" /><LucideIcon Grid.Column="1" Kind="ExternalLink" Size="13" StrokeWidth="1.75" /></Grid></Button>
              <Button Classes="link-row" Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding SelectedGame.SteamPageUrl}" IsVisible="{Binding SelectedGame.SteamPageUrl, Converter={StaticResource NullToBoolConverter}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Steam" /><LucideIcon Grid.Column="1" Kind="ExternalLink" Size="13" StrokeWidth="1.75" /></Grid></Button>
              <Button Classes="link-row" Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding SelectedGame.RawgUrl}" IsVisible="{Binding SelectedGame.RawgUrl, Converter={StaticResource NullToBoolConverter}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="RAWG" /><LucideIcon Grid.Column="1" Kind="ExternalLink" Size="13" StrokeWidth="1.75" /></Grid></Button>
              <Button Classes="link-row" Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding SelectedGame.IgdbUrl}" IsVisible="{Binding SelectedGame.IgdbUrl, Converter={StaticResource NullToBoolConverter}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="IGDB" /><LucideIcon Grid.Column="1" Kind="ExternalLink" Size="13" StrokeWidth="1.75" /></Grid></Button>
              <Button Classes="link-row" Command="{Binding OpenExternalLinkCommand}" CommandParameter="{Binding SelectedGame.HltbUrl}" IsVisible="{Binding SelectedGame.HltbUrl, Converter={StaticResource NullToBoolConverter}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="HowLongToBeat" /><LucideIcon Grid.Column="1" Kind="ExternalLink" Size="13" StrokeWidth="1.75" /></Grid></Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Nothing appears instantly: the drawer arrives from the edge it lives on. -->
    <Border x:Name="SettingsDrawer"
            Classes="settings-drawer reveal-drawer"
            HorizontalAlignment="Right"
            ZIndex="20"
            IsVisible="False"
            controls:Reveal.IsOpen="{Binding IsGameSettingsOpen}">
      <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
          <TextBlock Classes="heading" Text="Game Settings" />
          <Button Grid.Column="1" Classes="icon-quiet" Command="{Binding CloseGameSettingsCommand}" ToolTip.Tip="Close game settings"><LucideIcon Kind="X" Size="16" StrokeWidth="1.75" /></Button>
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="22">
            <StackPanel Spacing="0">
              <Border Classes="meta-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <TextBlock Classes="meta-label" Text="Folder size" />
                  <TextBlock Grid.Column="1" Classes="meta-value" TextAlignment="Right" Text="{Binding SelectedGame.FolderSizeDisplay}" />
                </Grid>
              </Border>
              <Border Classes="meta-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <TextBlock Classes="meta-label" Text="Imported from" />
                  <TextBlock Grid.Column="1" Classes="meta-value" TextAlignment="Right" Text="{Binding SelectedGame.ImportedFromDisplay}" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="meta-label" Text="Launch options" />
              <TextBlock Classes="caption" Text="{Binding SelectedGame.LaunchOptionsDisplay}" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Stretch" Command="{Binding ChangeLaunchScriptCommand}" Content="Choose launch script" />
              <Button HorizontalAlignment="Stretch" Command="{Binding ChangeExecutableCommand}" Content="Choose executable" />
              <Button HorizontalAlignment="Stretch" Command="{Binding ResetLaunchOptionsCommand}" Content="Use detected launch target" IsEnabled="{Binding SelectedGame.HasCustomLaunchOptions}" />
            </StackPanel>
            <Button HorizontalAlignment="Stretch" Command="{Binding OpenGameFolderCommand}" Content="Open game folder" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="12" Margin="0,22,0,0">
          <Button HorizontalAlignment="Stretch" Click="ShowHideConfirmation_Click" Content="Hide and ignore" />
          <StackPanel x:Name="HideConfirmation" Classes="reveal" Spacing="12" IsVisible="False">

            <TextBlock Classes="meta-value" Text="Are you sure?" />
            <TextBlock Classes="caption" Text="Hidden from your library and ignored by scans. Undo it in Settings." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Button Classes="play" Click="ConfirmHide_Click" Content="Hide" />
              <Button Classes="text-btn" Click="CancelHideConfirmation_Click" Content="Cancel" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Classes="reveal-soft"
          ZIndex="40"
          IsVisible="False"
          controls:Reveal.IsOpen="{Binding IsMediaOverlayOpen}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="MediaScrim_PointerPressed" />
      <Border Classes="overlay reveal"
              Margin="44"
              Padding="18"
              IsVisible="False"
              controls:Reveal.IsOpen="{Binding IsMediaOverlayOpen}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,14">
            <TextBlock Classes="heading" Text="Media" />
            <Button Grid.Column="1" Classes="icon-quiet" Click="CloseMediaOverlay_Click" ToolTip.Tip="Close media"><LucideIcon Kind="X" Size="16" StrokeWidth="1.75" /></Button>
          </Grid>
          <!--
            The carousel has no navigation of its own, so without the two steps only the
            thumbnail that was clicked could ever be seen. They stand beside the picture rather
            than on it: a trailer is a native child window, and a native window paints over
            anything Avalonia lays on top of it.
          -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="media-step"
                    VerticalAlignment="Center"
                    Click="PreviousMedia_Click"
                    IsVisible="{Binding SelectedGame.HasMultipleMedia}"
                    AutomationProperties.Name="Previous"
                    ToolTip.Tip="Previous">
              <LucideIcon Kind="ChevronLeft" Size="20" StrokeWidth="1.75" />
            </Button>

            <Carousel x:Name="MediaCarousel"
                      Grid.Column="1"
                      ItemsSource="{Binding SelectedGame.Media}"
                      SelectedIndex="{Binding SelectedMediaIndex, Mode=TwoWay}">
              <Carousel.DataTemplates>
                <media:MediaTemplateSelector>
                  <DataTemplate x:Key="image">
                    <media:CodecImage Source="{Binding}" Stretch="Uniform" />
                  </DataTemplate>
                  <!-- A trailer waits to be started, the way it did before. -->
                  <DataTemplate x:Key="video">
                    <media:CodecVideoView Source="{Binding Converter={StaticResource StringToUriConverter}}" />
                  </DataTemplate>
                </media:MediaTemplateSelector>
              </Carousel.DataTemplates>
            </Carousel>

            <Button Classes="media-step"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="NextMedia_Click"
                    IsVisible="{Binding SelectedGame.HasMultipleMedia}"
                    AutomationProperties.Name="Next"
                    ToolTip.Tip="Next">
              <LucideIcon Kind="ChevronRight" Size="20" StrokeWidth="1.75" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Classes="reveal-soft"
          ZIndex="50"
          IsVisible="False"
          controls:Reveal.IsOpen="{Binding IsFranchiseOverlayOpen}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="FranchiseScrim_PointerPressed" />
      <Border Classes="overlay reveal"
              Margin="44"
              Padding="24"
              IsVisible="False"
              controls:Reveal.IsOpen="{Binding IsFranchiseOverlayOpen}">
        <Grid RowDefinitions="Auto,*">
          <Button Classes="icon-quiet" HorizontalAlignment="Right" Command="{Binding CloseFranchiseOverlayCommand}" ToolTip.Tip="Close franchise"><LucideIcon Kind="X" Size="16" StrokeWidth="1.75" /></Button>
          <views:FranchiseTimelineControl Grid.Row="1" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
