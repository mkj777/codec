<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             xmlns:media="using:Codec.Media"
             x:Class="Codec.Views.LibraryView"
             x:CompileBindings="False">
  <Grid Margin="44,48,44,64"
        RowDefinitions="Auto,*">
    <!--
      Two stable header rows: views and the count, then sources and sort.
      Controls keep their place as sources appear and disappear.
    -->
    <StackPanel Spacing="14"
                Margin="0,0,0,22"
                IsVisible="{Binding HasGames}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Bottom">
          <Button Classes="lib-tab"
                  Classes.on="{Binding IsAllTabActive}"
                  Command="{Binding SelectLibraryTabCommand}"
                  CommandParameter="0"
                  Content="All" />
          <Button Classes="lib-tab"
                  Classes.on="{Binding IsInstalledTabActive}"
                  Command="{Binding SelectLibraryTabCommand}"
                  CommandParameter="1"
                  Content="Installed" />
          <Button Classes="lib-tab"
                  Classes.on="{Binding IsRecentTabActive}"
                  Command="{Binding SelectLibraryTabCommand}"
                  CommandParameter="2"
                  Content="Recent" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
          <TextBlock Classes="lib-count" HorizontalAlignment="Right">
            <Run Text="{Binding LibraryGameCount}" />
            <Run Text=" " />
            <Run Text="{Binding LibraryGameLabel}" />
          </TextBlock>
          <TextBlock Classes="lib-count"
                     HorizontalAlignment="Right"
                     Text="{Binding LibraryTotalSizeText}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost"
                  Content="All sources"
                  Click="ClearSourceFilter_Click" />
          <ItemsControl ItemsSource="{Binding AvailableImportSources}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Classes="chip"
                              Content="{Binding Name}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ToggleButton x:Name="SortToggle"
                      Grid.Column="1"
                      Classes="dropdown"
                      VerticalAlignment="Center">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding SortLabel}" VerticalAlignment="Center" />
            <LucideIcon Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource CodecTextMutedBrush}"
                        Kind="ChevronDown"
                        Size="14"
                        StrokeWidth="1.75" />
          </Grid>
        </ToggleButton>

        <Popup PlacementTarget="{Binding #SortToggle}"
               Placement="BottomEdgeAlignedRight"
               VerticalOffset="6"
               IsLightDismissEnabled="True"
               IsOpen="{Binding #SortToggle.IsChecked, Mode=TwoWay}">
          <Border Classes="dropdown-popup" MinWidth="180">
            <ListBox x:Name="SortList"
                     Classes="dropdown-list"
                     SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                     SelectionChanged="SortList_SelectionChanged">
              <ListBoxItem Content="Alphabetic ↓" />
              <ListBoxItem Content="Alphabetic ↑" />
              <ListBoxItem Content="Folder size ↓" />
              <ListBoxItem Content="Folder size ↑" />
              <ListBoxItem Content="Date added ↓" />
              <ListBoxItem Content="Date added ↑" />
            </ListBox>
          </Border>
        </Popup>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding HasGames}">
        <ItemsRepeater ItemsSource="{Binding DisplayedGames}" Margin="0,0,10,0">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="210"
                               MinItemHeight="315"
                               MinColumnSpacing="22"
                               MinRowSpacing="22"
                               ItemsStretch="Fill"
                               ItemsJustification="Start" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <Grid Classes="cover-card"
                    Height="315"
                    Opacity="{Binding LibraryCardOpacity}">
                <Border Classes="cover">
                  <media:CodecImage Source="{Binding LibraryCapsule}"
                                    Stretch="UniformToFill" />
                </Border>

                <!-- hover ring and glow, lit by the cover's own colour -->
                <Border Classes="cover-ring"
                        media:ArtTint.RingSource="{Binding LibraryCapsule}" />

                <Button Classes="cover-hitbox"
                        Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                <Button Classes="favorite"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Opacity="{Binding FavoriteOpacity}"
                        ToolTip.Tip="{Binding FavoriteToolTip}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <LucideIcon Kind="Star" Size="16" StrokeWidth="1.75" />
                </Button>

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="10"
                            Spacing="6">
                  <Border Classes="cover-tag"
                          IsVisible="{Binding DataContext.ShowFolderSizeTag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Classes="caption"
                               Foreground="{DynamicResource CodecTextBrush}"
                               Text="{Binding FolderSizeDisplay}" />
                  </Border>
                  <Border Classes="cover-tag"
                          IsVisible="{Binding DataContext.ShowDateAddedTag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Classes="caption"
                               Foreground="{DynamicResource CodecTextBrush}"
                               Text="{Binding DateAddedDisplay}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="24"
                  IsVisible="{Binding IsEmptyLibrary}">
        <Image Width="250"
               Height="180"
               Stretch="Uniform"
               Source="/Assets/shrimpSleep.png" />
        <TextBlock Classes="empty-title"
                   HorizontalAlignment="Center"
                   Text="Nothing here yet." />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="14">
          <Button Classes="play play-lg"
                  Command="{Binding AddGameFromPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <LucideIcon Kind="Plus" Size="14" StrokeWidth="2" />
              <TextBlock Text="Add games" FontFamily="{StaticResource CodecDisplayFontFamily}" FontWeight="700" FontSize="15.5" />
            </StackPanel>
          </Button>
          <Button Classes="text-btn"
                  Content="Scan a folder"
                  Command="{Binding ScanGamesCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="22"
                  IsVisible="{Binding IsInitialLoading}">
        <TextBlock Classes="screen-title"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingTitle}" />
        <controls:Hairline Width="260"
                           IsIndeterminate="{Binding IsLoadingIndeterminate}"
                           Value="{Binding LoadingProgress}"
                           Maximum="100" />
        <TextBlock Classes="caption"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingSubtitle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
