<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codec.Controls"
             xmlns:media="using:Codec.Media"
             x:Class="Codec.Views.LibraryView"
             x:CompileBindings="False">
  <!--
    The caption strip above supplies 34px of empty space, so the library's own
    top inset is small. Together they land on the reference's opening measure.
  -->
  <Grid Margin="32,12,32,46"
        RowDefinitions="Auto,*">
    <StackPanel Spacing="10"
                Margin="0,0,0,16"
                IsVisible="{Binding HasGames}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
          <Grid>
            <Button Classes="lib-tab"
                    Classes.on="{Binding IsAllTabActive}"
                    Command="{Binding SelectLibraryTabCommand}"
                    CommandParameter="0"
                    Content="All" />
            <Border Classes="tab-underline" Classes.on="{Binding IsAllTabActive}" />
          </Grid>
          <Grid>
            <Button Classes="lib-tab"
                    Classes.on="{Binding IsInstalledTabActive}"
                    Command="{Binding SelectLibraryTabCommand}"
                    CommandParameter="1"
                    Content="Installed" />
            <Border Classes="tab-underline" Classes.on="{Binding IsInstalledTabActive}" />
          </Grid>
          <Grid>
            <Button Classes="lib-tab"
                    Classes.on="{Binding IsRecentTabActive}"
                    Command="{Binding SelectLibraryTabCommand}"
                    CommandParameter="2"
                    Content="Recent" />
            <Border Classes="tab-underline" Classes.on="{Binding IsRecentTabActive}" />
          </Grid>
        </StackPanel>

        <ToggleButton x:Name="SortToggle"
                      Grid.Column="2"
                      Classes="dropdown"
                      VerticalAlignment="Bottom">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding SortLabel}" VerticalAlignment="Center" />
            <LucideIcon Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource CodecTextMutedBrush}"
                        Kind="ChevronDown"
                        Size="13"
                        StrokeWidth="1.75" />
          </Grid>
        </ToggleButton>

        <!-- one line, so a second line can never push the tabs down -->
        <TextBlock Grid.Column="3"
                   Classes="lib-count"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,8"
                   Text="{Binding LibrarySummaryText}" />

        <Popup PlacementTarget="{Binding #SortToggle}"
               Placement="BottomEdgeAlignedRight"
               VerticalOffset="6"
               IsLightDismissEnabled="True"
               IsOpen="{Binding #SortToggle.IsChecked, Mode=TwoWay}">
          <Border Classes="dropdown-popup" MinWidth="160">
            <ListBox x:Name="SortList"
                     Classes="dropdown-list"
                     SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                     SelectionChanged="SortList_SelectionChanged">
              <ListBoxItem Content="Alphabetic ↓" />
              <ListBoxItem Content="Alphabetic ↑" />
              <ListBoxItem Content="Folder size ↓" />
              <ListBoxItem Content="Folder size ↑" />
              <ListBoxItem Content="Date added ↓" />
              <ListBoxItem Content="Date added ↑" />
            </ListBox>
          </Border>
        </Popup>
      </Grid>

      <!-- a single source needs no chips, so the row is absent entirely -->
      <StackPanel Orientation="Horizontal"
                  Spacing="7"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasMultipleImportSources}">
        <Button Classes="ghost"
                Content="All sources"
                Click="ClearSourceFilter_Click" />
        <ItemsControl ItemsSource="{Binding AvailableImportSources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Classes="chip"
                            Content="{Binding Name}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding HasGames}">
        <!--
          Fill decides the width, CoverGrid derives the matching height, so columns
          fill the shelf, the gap stays fixed and the card stays 2:3.
        -->
        <ItemsRepeater ItemsSource="{Binding DisplayedGames}"
                       controls:CoverGrid.TargetWidth="210"
                       controls:CoverGrid.Gap="16">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="210"
                               MinItemHeight="315"
                               MinColumnSpacing="16"
                               MinRowSpacing="16"
                               ItemsStretch="Fill"
                               ItemsJustification="Start" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <Grid Classes="cover-card"
                    controls:Interaction.PressClass="True"
                    Opacity="{Binding LibraryCardOpacity}">
                <Border Classes="cover">
                  <media:CodecImage Source="{Binding LibraryCapsule}"
                                    Stretch="UniformToFill"
                                    LetterboxWideArt="True" />
                </Border>

                <!-- hover ring and glow, lit by the cover's own colour -->
                <Border Classes="cover-ring"
                        media:ArtTint.RingSource="{Binding LibraryCapsule}" />

                <Button Classes="cover-hitbox"
                        Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                <Button Classes="favorite"
                        Classes.on="{Binding IsFavorite}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Opacity="{Binding FavoriteOpacity}"
                        ToolTip.Tip="{Binding FavoriteToolTip}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <LucideIcon Kind="Star" Size="14" StrokeWidth="1.75" />
                </Button>

                <Border Classes="cover-flag"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        IsVisible="{Binding IsNotInstalled}">
                  <TextBlock Text="NOT INSTALLED" />
                </Border>

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            Spacing="5">
                  <Border Classes="cover-tag"
                          IsVisible="{Binding DataContext.ShowFolderSizeTag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Classes="caption"
                               Foreground="{DynamicResource CodecTextBrush}"
                               Text="{Binding FolderSizeDisplay}" />
                  </Border>
                  <Border Classes="cover-tag"
                          IsVisible="{Binding DataContext.ShowDateAddedTag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Classes="caption"
                               Foreground="{DynamicResource CodecTextBrush}"
                               Text="{Binding DateAddedDisplay}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <StackPanel Classes="reveal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="18"
                  IsVisible="False"
                  controls:Reveal.IsOpen="{Binding IsEmptyLibraryVisible}">
        <Image Width="200"
               Height="144"
               Stretch="Uniform"
               Source="/Assets/shrimpSleep.png" />
        <TextBlock Classes="empty-title"
                   HorizontalAlignment="Center"
                   Text="Nothing here yet." />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12">
          <Button Classes="play play-lg"
                  controls:Interaction.PulseOnClick="True"
                  Command="{Binding AddGameFromPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <LucideIcon Kind="Plus" Size="13" StrokeWidth="2" />
              <TextBlock Text="Add games" FontFamily="{StaticResource CodecDisplayFontFamily}" FontWeight="700" FontSize="14.5" />
            </StackPanel>
          </Button>
          <Button Classes="text-btn"
                  Content="Scan a folder"
                  Command="{Binding ScanGamesCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Classes="reveal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  IsVisible="False"
                  controls:Reveal.IsOpen="{Binding IsInitialLoading}">
        <TextBlock Classes="screen-title"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingTitle}" />
        <controls:Hairline Width="190"
                           IsIndeterminate="{Binding IsLoadingIndeterminate}"
                           Value="{Binding LoadingProgress}"
                           Maximum="100" />
        <TextBlock Classes="caption"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingSubtitle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
