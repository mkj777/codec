<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Codec.Converters"
        xmlns:overlays="using:Codec.Views.Overlays"
        xmlns:views="using:Codec.Views"
        x:Class="Codec.Views.MainWindow"
        x:CompileBindings="False"
        Title=""
        Width="1280"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{DynamicResource CodecBackgroundBrush}"
        Foreground="{DynamicResource CodecTextBrush}"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="34">
  <Window.Resources>
    <converters:BooleanNegationConverter x:Key="NotConverter" />
    <converters:BooleanToDoubleConverter x:Key="SidebarWidthConverter"
                                         Expanded="240"
                                         Collapsed="0" />
  </Window.Resources>

  <Grid ColumnDefinitions="Auto,*"
        RowDefinitions="34,*">
    <Grid Grid.ColumnSpan="2">
      <Border x:Name="DragRegion"
              Background="#141210"
              PointerPressed="TitleBar_PointerPressed" />

      <Button Classes="icon-quiet"
              Width="34"
              Height="34"
              Margin="8,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Command="{Binding ToggleSidebarCommand}"
              IsVisible="{Binding IsSidebarCollapsed}"
              AutomationProperties.Name="Open sidebar"
              ToolTip.Tip="Open sidebar">
        <LucideIcon Kind="PanelLeftOpen" Size="18" StrokeWidth="1.75" />
      </Button>

      <StackPanel HorizontalAlignment="Right"
                  Orientation="Horizontal">
        <Button Classes="chrome"
                Click="MinimizeWindow_Click"
                AutomationProperties.Name="Minimize"
                ToolTip.Tip="Minimize">
          <LucideIcon Kind="Minus" Size="16" StrokeWidth="1.75" />
        </Button>
        <Button Classes="chrome"
                Click="MaximizeWindow_Click"
                AutomationProperties.Name="Maximize or restore"
                ToolTip.Tip="Maximize or restore">
          <LucideIcon Kind="Square" Size="14" StrokeWidth="1.75" />
        </Button>
        <Button Classes="chrome"
                Click="CloseWindow_Click"
                AutomationProperties.Name="Close"
                ToolTip.Tip="Close">
          <LucideIcon Kind="X" Size="17" StrokeWidth="1.75" />
        </Button>
      </StackPanel>
    </Grid>

    <Border x:Name="Sidebar"
            Grid.Row="1"
            Grid.Column="0"
            Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidthConverter}}"
            Background="{DynamicResource CodecSidebarBrush}"
            BorderBrush="{DynamicResource CodecBorderBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True"
            PointerPressed="Sidebar_PointerPressed">
      <Grid Margin="20,12,20,0"
            RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto"
              Margin="0,0,0,14">
          <TextBlock Classes="brand"
                     VerticalAlignment="Center"
                     Text="Codec" />
          <Button Grid.Column="1"
                  Classes="icon-quiet"
                  Command="{Binding ToggleSidebarCommand}"
                  AutomationProperties.Name="Close sidebar"
                  ToolTip.Tip="Close sidebar">
            <LucideIcon Kind="PanelLeftClose" Size="18" StrokeWidth="1.75" />
          </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource CodecBorderBrush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="16,10,*">
            <LucideIcon VerticalAlignment="Center"
                        Foreground="{DynamicResource CodecTextMutedBrush}"
                        Kind="Search"
                        Size="16"
                        StrokeWidth="1.75" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     Classes="sidebar-search"
                     PlaceholderText="Search"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <ListBox Grid.Row="2"
                 Classes="sidebar-list"
                 ItemsSource="{Binding SidebarFilteredGames}"
                 SelectedItem="{Binding SidebarSelectedItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Classes="sidebar-game"
                      Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      Opacity="{Binding SidebarOpacity}">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Image Grid.Row="3"
               Margin="0,8,0,12"
               Height="104"
               Stretch="Uniform"
               Source="/Assets/shrimpSleep.png" />

        <Grid Grid.Row="4"
              ColumnDefinitions="*,*"
              ColumnSpacing="8"
              Margin="0,0,0,12">
          <Button Grid.Column="0"
                  Classes="primary sidebar-action"
                  Command="{Binding AddGameFromPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <LucideIcon Kind="Plus" Size="16" StrokeWidth="1.75" />
              <TextBlock Text="Add" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Classes="sidebar-action"
                  Command="{Binding ScanGamesCommand}"
                  IsEnabled="{Binding CanStartScan}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <LucideIcon Kind="Search" Size="16" StrokeWidth="1.75" />
              <TextBlock Text="Scan" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="5"
                Margin="-20,0,-20,0"
                Padding="20,4,20,0"
                BorderBrush="{DynamicResource CodecBorderBrush}"
                BorderThickness="0,1,0,0">
          <Button Classes="sidebar-settings"
                  Click="SettingsButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <LucideIcon Kind="Settings" Size="16" StrokeWidth="1.75" />
              <TextBlock Text="Settings" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Grid.Column="1"
          Background="{DynamicResource CodecBackgroundBrush}">
      <views:LibraryView IsVisible="{Binding IsLibraryGridVisible}" />

      <views:GameDetailView IsVisible="{Binding IsDetailsVisible}" />
    </Grid>

    <overlays:NotificationStack Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                ZIndex="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,18,18" />

    <Grid Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="30"
          Background="{DynamicResource CodecScrimBrush}"
          IsVisible="{Binding IsScanProgressVisible}">
      <Border Classes="overlay" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="330" Spacing="12">
          <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{Binding ScanProgressMessage}" />
          <ProgressBar Minimum="{Binding ScanProgressMinimum}" Maximum="{Binding ScanProgressMaximum}" Value="{Binding ScanProgressValue}" IsIndeterminate="{Binding ScanProgressIsIndeterminate}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="40"
          IsVisible="{Binding IsSettingsVisible}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="SettingsScrim_PointerPressed" />
      <views:SettingsView HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <views:OnboardingView Grid.RowSpan="2"
                          Grid.ColumnSpan="2"
                          ZIndex="50"
                          IsVisible="{Binding IsOnboardingVisible}" />

    <Grid Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="60"
          IsVisible="{Binding IsCloseChoiceVisible}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="CloseChoiceScrim_PointerPressed" />
      <Border Classes="overlay" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Classes="heading" Text="Keep Codec open?" />
          <TextBlock Classes="body" Foreground="{DynamicResource CodecTextMutedBrush}" Text="Codec can stay in the tray when you close the window." TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
            <Button Grid.Column="0" Content="Close Codec" Click="CloseCodec_Click" />
            <Button Grid.Column="1" Classes="primary" Content="Keep open" Click="KeepCodecOpen_Click" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
