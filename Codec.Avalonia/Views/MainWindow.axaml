<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:Codec.Controls"
        xmlns:converters="using:Codec.Converters"
        xmlns:overlays="using:Codec.Views.Overlays"
        xmlns:views="using:Codec.Views"
        x:Class="Codec.Views.MainWindow"
        x:CompileBindings="False"
        Title=""
        Width="1280"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{DynamicResource CodecBackgroundBrush}"
        Foreground="{DynamicResource CodecTextBrush}"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="34">
  <Window.Resources>
    <converters:BooleanNegationConverter x:Key="NotConverter" />
    <converters:BooleanToDoubleConverter x:Key="SidebarWidthConverter"
                                         Expanded="240"
                                         Collapsed="0" />
  </Window.Resources>

  <Grid ColumnDefinitions="Auto,*"
        RowDefinitions="34,*">
    <!-- The rail runs the full height, so the sink reaches the top edge. -->
    <Border x:Name="Sidebar"
            Classes="rail-shell"
            Classes.collapsed="{Binding IsSidebarCollapsed}"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidthConverter}}"
            Background="{DynamicResource CodecSinkBrush}"
            BorderBrush="{DynamicResource CodecLine2Brush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True"
            PointerPressed="Sidebar_PointerPressed">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <!--
          Exactly the height of the caption strip. The collapse toggle here and the expand
          toggle over there then share a centre line, so the control does not appear to jump
          when the rail closes.
        -->
        <Grid Margin="0,0,0,8"
              Background="Transparent"
              RowDefinitions="34,Auto"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
          <!--
            The top 34 matches the caption strip exactly, so the toggle here and the toggle
            that replaces it when the rail closes share a centre line.
          -->
          <Button Grid.Row="0"
                  Classes="icon-quiet"
                  Width="28"
                  Height="26"
                  Margin="0,0,10,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Opacity="0.7"
                  Foreground="{DynamicResource CodecTextMutedBrush}"
                  Command="{Binding ToggleSidebarCommand}"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  AutomationProperties.Name="Hide the sidebar"
                  ToolTip.Tip="Hide the sidebar">
            <LucideIcon Kind="PanelLeftClose" Size="15" StrokeWidth="1.75" />
          </Button>

          <!-- The wordmark is the way back to the shelf, as it was before the migration. -->
          <Button Grid.Row="1"
                  Classes="wordmark-home"
                  Margin="16,0,16,0"
                  HorizontalAlignment="Left"
                  Command="{Binding BackCommand}"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  AutomationProperties.Name="Back to the library"
                  ToolTip.Tip="Back to the library">
            <TextBlock Classes="wordmark" Text="Codec" />
          </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="16,0,16,6"
                Padding="0,0,0,8"
                IsVisible="{Binding HasGames}"
                BorderBrush="{DynamicResource CodecLine2Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="13,9,*">
            <LucideIcon VerticalAlignment="Center"
                        Foreground="{DynamicResource CodecTextMutedBrush}"
                        Kind="Search"
                        Size="13"
                        StrokeWidth="1.75" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     Classes="rail-search"
                     PlaceholderText="Search"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <ListBox Classes="rail-list"
                   ItemContainerTheme="{StaticResource RailItemTheme}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemsSource="{Binding SidebarFilteredGames}"
                   SelectedItem="{Binding SidebarSelectedItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Button Classes="rail-item"
                          HorizontalAlignment="Stretch"
                          Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Opacity="{Binding SidebarOpacity}">
                    <TextBlock Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                  </Button>
                  <Border Classes="rail-marker" Margin="2,7" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Margin="18,8"
                     VerticalAlignment="Top"
                     FontSize="12.5"
                     Opacity="0.7"
                     Foreground="{DynamicResource CodecTextMutedBrush}"
                     Text="{Binding SidebarEmptyMessage}"
                     IsVisible="{Binding IsSidebarEmpty}" />
        </Grid>

        <!-- The mascot rests here only while there is a collection to rest beside. -->
        <Image Grid.Row="3"
               Margin="13,2,13,5"
               Height="84"
               Stretch="Uniform"
               IsVisible="{Binding HasGames}"
               Source="/Assets/shrimpSleep.png" />

        <Grid Grid.Row="4"
              ColumnDefinitions="*,*"
              ColumnSpacing="7"
              Margin="13,8,13,10">
          <Button Grid.Column="0"
                  Classes="ghost ghost-primary"
                  Command="{Binding AddGameFromPickerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <LucideIcon Kind="Plus" Size="12" StrokeWidth="1.75" />
              <TextBlock Text="Add" FontSize="12.5" FontWeight="600" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Classes="ghost"
                  Command="{Binding ScanGamesCommand}"
                  IsEnabled="{Binding CanStartScan}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <LucideIcon Kind="Search" Size="12" StrokeWidth="1.75" />
              <TextBlock Text="Scan" FontSize="12.5" FontWeight="600" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="5"
                BorderBrush="{DynamicResource CodecLine2Brush}"
                BorderThickness="0,1,0,0">
          <Button Classes="rail-settings"
                  HorizontalAlignment="Stretch"
                  Click="SettingsButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <LucideIcon Kind="Settings" Size="14" StrokeWidth="1.75" />
              <TextBlock Text="Settings" FontSize="12.5" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>


    <Grid Grid.Row="1"
          Grid.Column="1"
          Background="{DynamicResource CodecBackgroundBrush}">
      <views:LibraryView Classes="reveal-soft"
                         IsVisible="False"
                         controls:Reveal.IsOpen="{Binding IsLibraryGridVisible}" />
    </Grid>

    <!--
      Details spans the caption row as well, so its artwork reaches the top edge of the window
      and the caption strip sits on the picture rather than beside it.
    -->
    <views:GameDetailView Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="1"
                          Classes="reveal-soft"
                          IsVisible="False"
                          controls:Reveal.IsOpen="{Binding IsDetailsVisible}" />

    <!-- caption strip, drawn over whatever the content column is showing -->
    <Grid Grid.Row="0" Grid.Column="1" ZIndex="10">
      <Border x:Name="DragRegion"
              Background="Transparent"
              chrome:WindowDecorationProperties.ElementRole="TitleBar" />

      <!--
        The left of the strip is one line of chrome, the same line the window buttons sit on.
        The toggle only appears here while the rail is closed, so with the rail open Back takes
        the leading position on its own.
      -->
      <StackPanel HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="10,0,0,0">
        <Button Classes="icon-quiet"
                Width="28"
                Height="26"
                Opacity="0.7"
                Foreground="{DynamicResource CodecTextMutedBrush}"
                Command="{Binding ToggleSidebarCommand}"
                IsVisible="{Binding IsSidebarCollapsed}"
                chrome:WindowDecorationProperties.ElementRole="User"
                AutomationProperties.Name="Show the sidebar"
                ToolTip.Tip="Show the sidebar">
          <LucideIcon Kind="PanelLeftOpen" Size="15" StrokeWidth="1.75" />
        </Button>

        <Button Classes="back"
                controls:Interaction.PulseOnClick="True"
                IsVisible="{Binding IsDetailsVisible}"
                Command="{Binding BackCommand}"
                chrome:WindowDecorationProperties.ElementRole="User"
                AutomationProperties.Name="Back to the library"
                ToolTip.Tip="Back to the library">
          <LucideIcon Kind="ChevronLeft" Size="16" StrokeWidth="1.75" />
        </Button>
      </StackPanel>

      <StackPanel HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Orientation="Horizontal"
                  Spacing="0">
        <Button Classes="chrome"
                Click="MinimizeWindow_Click"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                AutomationProperties.Name="Minimize"
                ToolTip.Tip="Minimize">
          <LucideIcon Kind="Minus" Size="13" StrokeWidth="1.5" />
        </Button>
        <Button Classes="chrome"
                Click="MaximizeWindow_Click"
                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                AutomationProperties.Name="Maximize or restore"
                ToolTip.Tip="Maximize or restore">
          <LucideIcon x:Name="MaximizeGlyph" Kind="Square" Size="11" StrokeWidth="1.5" />
        </Button>
        <Button Classes="chrome close"
                Click="CloseWindow_Click"
                chrome:WindowDecorationProperties.ElementRole="CloseButton"
                AutomationProperties.Name="Close"
                ToolTip.Tip="Close">
          <LucideIcon Kind="X" Size="13" StrokeWidth="1.5" />
        </Button>
      </StackPanel>
    </Grid>

    <!--
      One notice at a time, centred, never blocking the shelf. It sits above
      every overlay: work started from Settings must still report back, and the
      pill never accepts input that an overlay should have taken.
    -->
    <overlays:NoticePill Grid.RowSpan="2"
                         Grid.ColumnSpan="2"
                         ZIndex="70"
                         IsHitTestVisible="{Binding !IsAnyModalOpen}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,26" />

    <Grid Classes="reveal-soft"
          Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="40"
          IsVisible="False"
          controls:Reveal.IsOpen="{Binding IsSettingsVisible}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="SettingsScrim_PointerPressed" />
      <views:SettingsView Classes="reveal"
                          IsVisible="False"
                          controls:Reveal.IsOpen="{Binding IsSettingsVisible}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
    </Grid>

    <views:OnboardingView Classes="reveal-soft"
                          Grid.RowSpan="2"
                          Grid.ColumnSpan="2"
                          ZIndex="50"
                          IsVisible="False"
                          controls:Reveal.IsOpen="{Binding IsOnboardingVisible}" />

    <Grid Classes="reveal-soft"
          Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="60"
          IsVisible="False"
          controls:Reveal.IsOpen="{Binding IsCloseChoiceVisible}">
      <Border Background="{DynamicResource CodecScrimBrush}" PointerPressed="CloseChoiceScrim_PointerPressed" />
      <Border Classes="overlay reveal"
              IsVisible="False"
              controls:Reveal.IsOpen="{Binding IsCloseChoiceVisible}"
              Width="360"
              Padding="22"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Classes="heading" Text="Keep Codec open?" />
          <TextBlock Classes="body" Foreground="{DynamicResource CodecTextMutedBrush}" Text="Codec can stay in the tray when you close the window." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
            <Button Classes="play" Content="Keep open" Click="KeepCodecOpen_Click" />
            <Button Classes="text-btn" Content="Close Codec" Click="CloseCodec_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!--
      The launch sequence. It owns the window until the library is ready, so it sits above
      every other layer and takes itself down from code.
    -->
    <overlays:StartupOverlay x:Name="Startup"
                             Grid.RowSpan="2"
                             Grid.ColumnSpan="2"
                             ZIndex="100" />
  </Grid>
</Window>
