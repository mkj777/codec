<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!--
      Codec v2 runs two faces: Sansation carries display type, Nunito carries UI.

      Sizes are scaled from the 1800px reference to Codec's 1280px window.
      Display type scales near 0.72 because it is proportional to the canvas.
      Body and UI type barely move: 13px is 13px at any canvas width.
      LetterSpacing is absolute in Avalonia, so -0.015em is resolved per size.
    -->
    <FontFamily x:Key="CodecDisplayFontFamily">avares://Codec/Assets/fonts#Sansation</FontFamily>
    <FontFamily x:Key="CodecUiFontFamily">avares://Codec/Assets/fonts#Nunito</FontFamily>
  </Styles.Resources>

  <!-- Foreground is inherited, so a button can colour its own label. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="400" />
  </Style>

  <!-- display -->
  <Style Selector="TextBlock.wordmark, TextBlock.brand">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.27" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="56" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.84" />
    <Setter Property="LineHeight" Value="56" />
  </Style>
  <Style Selector="TextBlock.ob-title">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="48" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.72" />
    <Setter Property="LineHeight" Value="49" />
  </Style>
  <Style Selector="TextBlock.ob-subtitle">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.42" />
  </Style>
  <Style Selector="TextBlock.screen-title">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.39" />
  </Style>
  <Style Selector="TextBlock.empty-title">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.36" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.32" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="-0.24" />
  </Style>

  <!-- ui -->
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style Selector="TextBlock.blurb">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="#E6F3EDC9" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.factline">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LetterSpacing" Value="0.25" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.meta-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.meta-value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="TextBlock.lib-count">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.quiet-note">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
</Styles>
