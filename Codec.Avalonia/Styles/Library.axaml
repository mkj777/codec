<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The rail closes over time. A width binding on its own moves 240 to 0 in a single frame,
    which is what the WinUI build spent 150ms of slide and fade avoiding.
  -->
  <Style Selector="Border.rail-shell">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.rail-shell.collapsed">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- rail -->
  <Style Selector="ListBox.rail-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,8,9,7" />
  </Style>
  <Style Selector="ListBox.rail-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!--
    SimpleTheme paints its own bright hover and selection on ListBoxItem. The rail draws both
    itself, on the button and the marker inside the row, so the container has to stay clear in
    every state or two highlights stack.
  -->
  <Style Selector="ListBox.rail-list ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rail-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rail-list ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rail-list ListBoxItem:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.rail-item">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="400" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="Button.rail-item:pressed">
    <Setter Property="Background" Value="{DynamicResource CodecPressWashBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected Button.rail-item">
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>

  <!-- The selection bar slides in from the left rather than blinking on. -->
  <Style Selector="Border.rail-marker">
    <Setter Property="Width" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="RenderTransformOrigin" Value="0%,50%" />
    <Setter Property="RenderTransform" Value="scaleY(0)" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
          <TransformOperationsTransition.Easing>
            <SplineEasing X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:selected Border.rail-marker">
    <Setter Property="RenderTransform" Value="scaleY(1)" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.rail-settings">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="400" />
  </Style>
  <Style Selector="Button.rail-settings:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="Button.rail-settings:pressed">
    <Setter Property="Background" Value="{DynamicResource CodecPressWashBrush}" />
  </Style>

  <!-- covers -->
  <Style Selector="Border.cover">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 8 22 0 #5C000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.cover-hitbox">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.cover-hitbox:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cover-hitbox:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cover-hitbox:focus-visible">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryBrush}" />
  </Style>

  <!-- The lift is the one place Codec allows real movement. -->
  <Style Selector="Grid.cover-card">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
          <TransformOperationsTransition.Easing>
            <SplineEasing X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.cover-card:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-7px)" />
  </Style>
  <Style Selector="Grid.cover-card:pointerover Border.cover">
    <Setter Property="BoxShadow" Value="0 18 40 0 #80000000" />
  </Style>
  <!--
    Pressing settles the card most of the way back down. The state has to come from
    Interaction.PressClass: the pointer events belong to the hitbox, the movement belongs to
    the card above it, and no selector reaches upwards.
  -->
  <Style Selector="Grid.cover-card.pressed-in">
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <!--
    The art-coloured ring and glow live on their own layer so they can fade in
    on hover while carrying a per-game brush set by ArtTint.
  -->
  <Style Selector="Border.cover-ring">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3">
          <DoubleTransition.Easing>
            <SplineEasing X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
          </DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.cover-card:pointerover Border.cover-ring">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.favorite">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="#B81C1A17" />
    <Setter Property="BorderBrush" Value="#52D4A832" />
    <Setter Property="Foreground" Value="{DynamicResource CodecAccentBrush}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.favorite:pointerover">
    <Setter Property="Background" Value="#D91C1A17" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecAccentBrush}" />
  </Style>
  <Style Selector="Button.favorite:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <!-- A favorited game reads as marked, not merely as slightly less faded. -->
  <Style Selector="Button.favorite.on">
    <Setter Property="Background" Value="{DynamicResource CodecAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecAccentBrush}" />
    <Setter Property="Foreground" Value="#221E19" />
  </Style>
  <Style Selector="Button.favorite.on:pointerover">
    <Setter Property="Background" Value="#E8BC46" />
    <Setter Property="BorderBrush" Value="#E8BC46" />
    <Setter Property="Foreground" Value="#221E19" />
  </Style>

  <!-- restored from the WinUI covers: an uninstalled game says so on its own card -->
  <Style Selector="Border.cover-flag">
    <Setter Property="Background" Value="#E61C1A17" />
    <Setter Property="BorderBrush" Value="#90D4A832" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,3" />
  </Style>
  <Style Selector="Border.cover-flag TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="0.41" />
    <Setter Property="Foreground" Value="{DynamicResource CodecAccentBrush}" />
  </Style>

  <Style Selector="Border.cover-tag">
    <Setter Property="Background" Value="#D91C1A17" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,3" />
  </Style>
</Styles>
