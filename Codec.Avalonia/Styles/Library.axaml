<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ListBox.sidebar-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.sidebar-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.sidebar-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceBrush}" />
  </Style>
  <Style Selector="Button.sidebar-game">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="500" />
  </Style>
  <Style Selector="Button.sidebar-game:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.cover-hitbox">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Button.cover-hitbox:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.cover-hitbox:pressed">
    <Setter Property="Opacity" Value="0.74" />
  </Style>
  <Style Selector="Button.favorite">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="#B81C1A17" />
    <Setter Property="BorderBrush" Value="#52D4A832" />
    <Setter Property="Foreground" Value="{DynamicResource CodecAccentBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Border.cover-tag">
    <Setter Property="Background" Value="#D91C1A17" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ToggleButton.filter-chip">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
