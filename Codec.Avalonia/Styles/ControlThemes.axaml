<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Codec.Controls">
  <Styles.Resources>
    <!--
      Hairline replaces ProgressBar. One pixel of track, a sweeping gradient
      while indeterminate, a left-anchored fill where a real value exists.
    -->
    <ControlTheme x:Key="{x:Type controls:Hairline}" TargetType="controls:Hairline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CodecLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CodecPrimaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="{TemplateBinding Background}" ClipToBounds="True">
            <Border Name="PART_Fill"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"
                    Width="{TemplateBinding FillWidth}"
                    IsVisible="{TemplateBinding ShowFill}" />
            <Border Name="PART_Sweep"
                    HorizontalAlignment="Left"
                    Width="{TemplateBinding SweepWidth}"
                    IsVisible="{TemplateBinding ShowSweep}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#00E76C2B" />
                  <GradientStop Offset="0.5" Color="#FFE76C2B" />
                  <GradientStop Offset="1" Color="#00E76C2B" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      The thumb fills its lane, so the lane's own width is what makes the bar slim. Shape and
      state live here rather than in an outer /template/ style: nested theme styles are the
      part that reliably reaches a control inside another control's template.
    -->
    <ControlTheme x:Key="CodecScrollThumbTheme" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource CodecScrollThumbBrush}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource CodecScrollThumbHoverBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource CodecScrollThumbDragBrush}" />
      </Style>
    </ControlTheme>
    <!--
      Overlay scrollbar. WinUI handed this shape over for free; SimpleTheme
      ships a rail with arrow buttons that reserves layout width.

      Only the ScrollBar is re-templated. SimpleTheme's own ScrollViewer keeps
      the sizing logic that honours HorizontalScrollBarVisibility, and
      AllowAutoHide is what lifts the bar off the layout.
    -->
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" Background="Transparent">
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Classes="scroll-page" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Classes="scroll-page" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Name="thumb" Theme="{StaticResource CodecScrollThumbTheme}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
      <!--
        A track counts upward from its start, and for a vertical bar the start is the
        bottom, the way a slider reads. Scrolling counts downward, so the vertical track
        runs the other way; SimpleTheme's own template does the same.
      -->
      <Style Selector="^:vertical /template/ Track#PART_Track">
        <Setter Property="IsDirectionReversed" Value="True" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!-- the track's paging areas are invisible but still clickable -->
  <Style Selector="RepeatButton.scroll-page">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- the bar reserves no width and fades in only while it matters -->
  <Style Selector="ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <!--
    The lane itself carries the weight: 4px at rest, 10px once the pointer is on it, with the
    change animated. The thumb simply fills whatever lane it is given.
  -->
  <Style Selector="ScrollBar[Orientation=Vertical]">
    <Setter Property="Width" Value="4" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar[Orientation=Horizontal]">
    <Setter Property="Height" Value="4" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar[Orientation=Vertical]:pointerover">
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar[Orientation=Horizontal]:pointerover">
    <Setter Property="Height" Value="10" />
  </Style>
  <!-- A page the reader is working through keeps its bar instead of fading it away. -->
  <Style Selector="ScrollViewer.persistent-scroll /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollBar:expanded">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!--
    Any ProgressBar left in the tree renders as a hairline rather than a block,
    so a missed call site cannot reintroduce the square bar.
  -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Height" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodecLineBrush}" />
  </Style>
</Styles>
