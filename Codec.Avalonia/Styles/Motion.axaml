<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Codec v2 easing. Nothing bounces and nothing spins. -->
    <SplineEasing x:Key="CodecEase" X1="0.2" Y1="0.7" X2="0.2" Y2="1" />
    <SplineEasing x:Key="CodecSweepEase" X1="0.5" Y1="0" X2="0.5" Y2="1" />
  </Styles.Resources>

  <!--
    reveal: the entrance and exit for anything that comes and goes.

    These are transitions on a class, not animations on a static one. An animation attached
    through a fixed Classes value runs when the style first matches, which is once, at attach.
    Toggling IsVisible never matches it again, so every such entrance in Codec played invisibly
    during window load and never afterwards. Reveal drives the `revealed` class instead, and
    holds the control in the tree long enough for the exit half to be seen.
  -->
  <Style Selector=":is(Control).reveal">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(10px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="{StaticResource CodecEase}" />
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.22"
                                       Easing="{StaticResource CodecEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).reveal.revealed">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- reveal-soft: the same contract without movement, for whole-page swaps. -->
  <Style Selector=":is(Control).reveal-soft">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="{StaticResource CodecEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).reveal-soft.revealed">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!--
    state-shift: the moment the window changes size.

    Maximizing re-columns the shelf in a single frame, which is the part that reads as abrupt;
    the frame itself is animated by the compositor. Dipping the content through the change
    turns the snap into a dissolve. FillMode stays None so the content returns to whatever
    owns it afterwards.
  -->
  <Style Selector=":is(Control).state-shift">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="{StaticResource CodecEase}" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="30%">
          <Setter Property="Opacity" Value="0.4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- breathe: the notice dot while work is in flight -->
  <Style Selector=":is(Control).breathe">
    <Style.Animations>
      <Animation Duration="0:0:1.5"
                 IterationCount="Infinite"
                 Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
