<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="CodecBackgroundColor">#1C1A17</Color>
    <Color x:Key="CodecSurfaceColor">#24211E</Color>
    <Color x:Key="CodecSurfaceRaisedColor">#292622</Color>
    <Color x:Key="CodecSurfaceHoverColor">#2B2722</Color>
    <Color x:Key="CodecPrimaryColor">#E76C2B</Color>
    <Color x:Key="CodecPrimaryHoverColor">#F07A37</Color>
    <Color x:Key="CodecPrimaryPressedColor">#CF5920</Color>
    <Color x:Key="CodecAccentColor">#D4A832</Color>
    <Color x:Key="CodecSecondaryColor">#C4956A</Color>
    <Color x:Key="CodecTextColor">#F3EDC9</Color>
    <Color x:Key="CodecTextMutedColor">#9E8E78</Color>
    <Color x:Key="CodecTextDisabledColor">#62584B</Color>
    <Color x:Key="CodecScrimColor">#B8141311</Color>

    <!--
      Codec v2 separation model: warm alpha lines over whatever sits beneath them.

      The interaction washes are deliberately quiet but not invisible. At the original 3.5%
      alpha a hover measured identically to rest on a near-black rail, which is what made the
      app read as unresponsive rather than as restrained.
    -->
    <Color x:Key="CodecLineColor">#17F3EDC9</Color>
    <Color x:Key="CodecLine2Color">#0EF3EDC9</Color>
    <Color x:Key="CodecLineStrongColor">#2EF3EDC9</Color>
    <Color x:Key="CodecOnArtLineColor">#29F3EDC9</Color>
    <Color x:Key="CodecSinkColor">#38000000</Color>
    <Color x:Key="CodecHoverWashColor">#14F3EDC9</Color>
    <Color x:Key="CodecPressWashColor">#1FF3EDC9</Color>
    <Color x:Key="CodecCaptionHoverColor">#17F3EDC9</Color>
    <Color x:Key="CodecPrimaryWashColor">#1AE76C2B</Color>
    <Color x:Key="CodecPrimaryLineColor">#52E76C2B</Color>
    <Color x:Key="CodecPrimaryLineHoverColor">#99E76C2B</Color>
    <Color x:Key="CodecPrimaryWashHoverColor">#12E76C2B</Color>
    <Color x:Key="CodecPrimarySelectedColor">#2BE76C2B</Color>
    <!-- The cinema veils sit on #181613, one step below the canvas. -->
    <Color x:Key="CodecVeilColor">#181613</Color>
    <Color x:Key="CodecNoticeColor">#F0141210</Color>

    <SolidColorBrush x:Key="CodecBackgroundBrush" Color="{StaticResource CodecBackgroundColor}" />
    <SolidColorBrush x:Key="CodecSurfaceBrush" Color="{StaticResource CodecSurfaceColor}" />
    <SolidColorBrush x:Key="CodecSurfaceRaisedBrush" Color="{StaticResource CodecSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="CodecSurfaceHoverBrush" Color="{StaticResource CodecSurfaceHoverColor}" />
    <SolidColorBrush x:Key="CodecPrimaryBrush" Color="{StaticResource CodecPrimaryColor}" />
    <SolidColorBrush x:Key="CodecPrimaryHoverBrush" Color="{StaticResource CodecPrimaryHoverColor}" />
    <SolidColorBrush x:Key="CodecPrimaryPressedBrush" Color="{StaticResource CodecPrimaryPressedColor}" />
    <SolidColorBrush x:Key="CodecAccentBrush" Color="{StaticResource CodecAccentColor}" />
    <SolidColorBrush x:Key="CodecSecondaryBrush" Color="{StaticResource CodecSecondaryColor}" />
    <SolidColorBrush x:Key="CodecTextBrush" Color="{StaticResource CodecTextColor}" />
    <SolidColorBrush x:Key="CodecTextMutedBrush" Color="{StaticResource CodecTextMutedColor}" />
    <SolidColorBrush x:Key="CodecTextDisabledBrush" Color="{StaticResource CodecTextDisabledColor}" />
    <SolidColorBrush x:Key="CodecScrimBrush" Color="{StaticResource CodecScrimColor}" />

    <SolidColorBrush x:Key="CodecLineBrush" Color="{StaticResource CodecLineColor}" />
    <SolidColorBrush x:Key="CodecLine2Brush" Color="{StaticResource CodecLine2Color}" />
    <SolidColorBrush x:Key="CodecLineStrongBrush" Color="{StaticResource CodecLineStrongColor}" />
    <SolidColorBrush x:Key="CodecOnArtLineBrush" Color="{StaticResource CodecOnArtLineColor}" />
    <SolidColorBrush x:Key="CodecSinkBrush" Color="{StaticResource CodecSinkColor}" />
    <SolidColorBrush x:Key="CodecHoverWashBrush" Color="{StaticResource CodecHoverWashColor}" />
    <SolidColorBrush x:Key="CodecPressWashBrush" Color="{StaticResource CodecPressWashColor}" />
    <SolidColorBrush x:Key="CodecCaptionHoverBrush" Color="{StaticResource CodecCaptionHoverColor}" />
    <SolidColorBrush x:Key="CodecPrimaryWashBrush" Color="{StaticResource CodecPrimaryWashColor}" />
    <SolidColorBrush x:Key="CodecPrimaryLineBrush" Color="{StaticResource CodecPrimaryLineColor}" />
    <SolidColorBrush x:Key="CodecPrimaryLineHoverBrush" Color="{StaticResource CodecPrimaryLineHoverColor}" />
    <SolidColorBrush x:Key="CodecPrimaryWashHoverBrush" Color="{StaticResource CodecPrimaryWashHoverColor}" />
    <SolidColorBrush x:Key="CodecPrimarySelectedBrush" Color="{StaticResource CodecPrimarySelectedColor}" />
    <SolidColorBrush x:Key="CodecNoticeBrush" Color="{StaticResource CodecNoticeColor}" />
    <SolidColorBrush x:Key="CodecScrollThumbBrush" Color="#26F3EDC9" />
    <SolidColorBrush x:Key="CodecScrollThumbHoverBrush" Color="#3DF3EDC9" />
    <SolidColorBrush x:Key="CodecScrollThumbDragBrush" Color="#52F3EDC9" />

    <!--
      SimpleTheme's own palette, retuned to Codec's.

      Anything the app does not template explicitly still draws from these: the toggle switch
      knob, list selection, text selection, focus adorners. Left alone they are grey and blue,
      which is where the stray bright hovers and blue accents were coming from. Retuning the
      palette fixes every one of them at the source rather than control by control.
    -->
    <Color x:Key="ThemeBackgroundColor">#1C1A17</Color>
    <Color x:Key="ThemeBorderLowColor">#2A2621</Color>
    <Color x:Key="ThemeBorderMidColor">#3A342C</Color>
    <Color x:Key="ThemeBorderHighColor">#4A4238</Color>
    <Color x:Key="ThemeControlLowColor">#201D1A</Color>
    <Color x:Key="ThemeControlMidColor">#24211E</Color>
    <Color x:Key="ThemeControlMidHighColor">#2B2722</Color>
    <Color x:Key="ThemeControlHighColor">#322D27</Color>
    <Color x:Key="ThemeControlHighlightHighColor">#322D27</Color>
    <Color x:Key="ThemeForegroundLowColor">#9E8E78</Color>
    <Color x:Key="ThemeAccentColor">#E76C2B</Color>
    <Color x:Key="ThemeAccentColor2">#F07A37</Color>
    <Color x:Key="ThemeAccentColor3">#CF5920</Color>
    <Color x:Key="ThemeAccentColor4">#B44D1B</Color>

    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1C1A17" />
    <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="#2A2621" />
    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="#3A342C" />
    <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="#4A4238" />
    <SolidColorBrush x:Key="ThemeControlLowBrush" Color="#201D1A" />
    <SolidColorBrush x:Key="ThemeControlMidBrush" Color="#24211E" />
    <SolidColorBrush x:Key="ThemeControlMidHighBrush" Color="#2B2722" />
    <SolidColorBrush x:Key="ThemeControlHighBrush" Color="#322D27" />
    <SolidColorBrush x:Key="ThemeControlHighlightHighBrush" Color="#322D27" />
    <SolidColorBrush x:Key="ThemeForegroundLowBrush" Color="#9E8E78" />
    <SolidColorBrush x:Key="ThemeAccentBrush2" Color="#F07A37" />
    <SolidColorBrush x:Key="ThemeAccentBrush3" Color="#CF5920" />
    <SolidColorBrush x:Key="ThemeAccentBrush4" Color="#B44D1B" />
    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#F3EDC9" />

    <!-- Retained so existing references keep resolving; CodecLine is the real token. -->
    <SolidColorBrush x:Key="CodecBorderBrush" Color="{StaticResource CodecLineColor}" />
    <!-- The rail's own depth: half the sink, which lands near #191715 over the canvas. -->
    <SolidColorBrush x:Key="CodecSidebarBrush" Color="#1C000000" />
  </Styles.Resources>
</Styles>
