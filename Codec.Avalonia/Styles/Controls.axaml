<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    One button language across the whole application: a ghost outline for
    everything quiet, an orange pill for the primary next action, and a circle
    for icon-only actions. Fill is reserved for the pill.
  -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="600" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource CodecTextDisabledBrush}" />
    <Setter Property="Opacity" Value="0.58" />
  </Style>

  <!-- ghost: the default quiet action, used by the rail and the library chips -->
  <Style Selector="Button.ghost">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,9" />
  </Style>

  <!-- Add. Orange speaks through colour here, not through fill. -->
  <Style Selector="Button.ghost-primary">
    <Setter Property="Foreground" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryLineBrush}" />
  </Style>
  <Style Selector="Button.ghost-primary:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryLineHoverBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryWashHoverBrush}" />
  </Style>

  <!-- play: the one filled action -->
  <Style Selector="Button.play">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="24,11" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="Foreground" Value="#221E19" />
    <Setter Property="FontFamily" Value="{StaticResource CodecDisplayFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="700" />
    <Setter Property="LetterSpacing" Value="0.56" />
    <!-- Button has no BoxShadow property, so the orange bloom comes from an effect. -->
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="28" OffsetX="0" OffsetY="10" Color="#E76C2B" Opacity="0.75" />
    </Setter>
  </Style>
  <Style Selector="Button.play.play-lg">
    <Setter Property="Padding" Value="34,15" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="LetterSpacing" Value="0.62" />
  </Style>
  <Style Selector="Button.play:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="#221E19" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button.play:disabled">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>

  <!-- icon-ghost: 44px circle beside the play pill -->
  <Style Selector="Button.icon-ghost">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>

  <!-- back: 38px circle sitting on artwork -->
  <Style Selector="Button.back">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Background" Value="#4D000000" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecOnArtLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="Button.back:pointerover">
    <Setter Property="Background" Value="#66000000" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineStrongBrush}" />
  </Style>

  <!-- icon-quiet: borderless square, used for close and collapse actions -->
  <Style Selector="Button.icon-quiet">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon-quiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
  </Style>

  <!-- text-btn: a label that happens to be clickable -->
  <Style Selector="Button.text-btn">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="400" />
  </Style>
  <Style Selector="Button.text-btn:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- window caption -->
  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Button.chrome:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecCaptionHoverBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecBackgroundBrush}" />
  </Style>

  <!-- library view tabs -->
  <Style Selector="Button.lib-tab">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="400" />
  </Style>
  <Style Selector="Button.lib-tab:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.lib-tab.on">
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryBrush}" />
  </Style>
  <Style Selector="Button.lib-tab.on:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryBrush}" />
  </Style>

  <!-- source chips share the ghost shape -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="600" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>

  <!-- sort dropdown: a chip that opens a themed popup -->
  <Style Selector="ToggleButton.dropdown">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.dropdown:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.dropdown:checked">
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryLineBrush}" />
  </Style>
  <Style Selector="Border.dropdown-popup">
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BoxShadow" Value="0 20 50 0 #80000000" />
  </Style>
  <Style Selector="ListBox.dropdown-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.dropdown-list ListBoxItem">
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.dropdown-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodecHoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>
  <Style Selector="ListBox.dropdown-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource CodecPrimaryWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>

  <!-- text entry -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource CodecPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource CodecPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.rail-search">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="400" />
    <Setter Property="WatermarkForeground" Value="{DynamicResource CodecTextMutedBrush}" />
  </Style>
  <Style Selector="TextBox.rail-search:focus">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CodecSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodecLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CodecTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CodecUiFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
</Styles>
