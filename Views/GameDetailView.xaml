<?xml version="1.0" encoding="utf-8"?>
<UserControl
        x:Class="Codec.Views.GameDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Codec.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

        <UserControl.Resources>
                <conv:ListToCommaConverter x:Key="ListToCommaConverter"/>
                <conv:SecondsToTimeConverter x:Key="SecondsToTimeConverter"/>
                <conv:DateToStringConverter x:Key="DateToStringConverter"/>
                <conv:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter"/>
                <conv:UriToMediaSourceConverter x:Key="UriToMediaSourceConverter"/>
                <conv:NullOrEmptyToFallbackConverter x:Key="NullOrEmptyToFallbackConverter"/>
                <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                <conv:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
                <Style x:Key="UnderlinedHyperlinkButton"
                       TargetType="HyperlinkButton">
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="ContentTemplate">
                                <Setter.Value>
                                        <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextDecorations="Underline"
                                                           FontWeight="SemiBold"/>
                                        </DataTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <SolidColorBrush x:Key="HeroActionPlayFallbackFillBrush"
                                 Color="#86161A1F"/>
                <SolidColorBrush x:Key="HeroActionSettingsFallbackFillBrush"
                                 Color="#7414181D"/>
                <SolidColorBrush x:Key="HeroActionPlayFallbackForegroundBrush"
                                 Color="#FFF3F6FB"/>
                <SolidColorBrush x:Key="HeroActionSettingsFallbackForegroundBrush"
                                 Color="#FFDDE5EF"/>
                <LinearGradientBrush x:Key="HeroActionPlayFallbackBorderBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#D4FFFFFF"
                                      Offset="0"/>
                        <GradientStop Color="#52F2F5F8"
                                      Offset="0.42"/>
                        <GradientStop Color="#26FFFFFF"
                                      Offset="1"/>
                </LinearGradientBrush>
                <LinearGradientBrush x:Key="HeroActionSettingsFallbackBorderBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#A4FFFFFF"
                                      Offset="0"/>
                        <GradientStop Color="#34EEF2F6"
                                      Offset="0.52"/>
                        <GradientStop Color="#18FFFFFF"
                                      Offset="1"/>
                </LinearGradientBrush>
                <Style x:Key="HeroActionInputButtonStyle"
                       TargetType="Button">
                        <Setter Property="Background"
                                Value="#01000000"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="UseSystemFocusVisuals"
                                Value="False"/>
                </Style>
        </UserControl.Resources>

        <Grid x:Name="RootLayout">
                <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="SettingsLayoutStates">
                                <VisualState x:Name="SettingsComfortableState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="340"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,24,0,24"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="22"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="14"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="17"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="2"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="7"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SettingsCompactState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="326"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,18,0,18"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="20"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="12"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="16"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="2"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="7"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SettingsTightState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="310"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,14,0,14"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="18"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="10"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="16"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="1"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="4"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DetailsLayoutStates">
                                <VisualState x:Name="DetailsComfortableState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility"
                                                        Value="Hidden"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode"
                                                        Value="Disabled"/>
                                                <Setter Target="DetailsActionsColumn.Width"
                                                        Value="Auto"/>
                                                <Setter Target="DetailsContentGrid.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Column)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsPlatformItemsControl.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsLinksPanel.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsActionsSection.Margin"
                                                        Value="0,14,12,0"/>
                                                <Setter Target="DetailsPlatformItemsControl.Margin"
                                                        Value="0,-8,4,10"/>
                                                <Setter Target="DetailsPrimaryColumn.Width"
                                                        Value="1.1*"/>
                                                <Setter Target="DetailsSecondaryColumn.Width"
                                                        Value="*"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="DetailsCompactState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility"
                                                        Value="Hidden"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode"
                                                        Value="Disabled"/>
                                                <Setter Target="DetailsActionsColumn.Width"
                                                        Value="Auto"/>
                                                <Setter Target="DetailsContentGrid.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Column)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsPlatformItemsControl.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsLinksPanel.HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Target="DetailsActionsSection.Margin"
                                                        Value="0,10,6,0"/>
                                                <Setter Target="DetailsPlatformItemsControl.Margin"
                                                        Value="0,-4,2,8"/>
                                                <Setter Target="DetailsPrimaryColumn.Width"
                                                        Value="1.05*"/>
                                                <Setter Target="DetailsSecondaryColumn.Width"
                                                        Value="*"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="DetailsTightState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility"
                                                        Value="Auto"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode"
                                                        Value="Enabled"/>
                                                <Setter Target="DetailsActionsColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="DetailsContentGrid.(Grid.ColumnSpan)"
                                                        Value="2"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="DetailsActionsSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="DetailsActionsSection.(Grid.ColumnSpan)"
                                                        Value="2"/>
                                                <Setter Target="DetailsActionsSection.HorizontalAlignment"
                                                        Value="Left"/>
                                                <Setter Target="DetailsPlatformItemsControl.HorizontalAlignment"
                                                        Value="Left"/>
                                                <Setter Target="DetailsLinksPanel.HorizontalAlignment"
                                                        Value="Left"/>
                                                <Setter Target="DetailsActionsSection.Margin"
                                                        Value="0,10,0,0"/>
                                                <Setter Target="DetailsPlatformItemsControl.Margin"
                                                        Value="0,0,0,8"/>
                                                <Setter Target="DetailsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="DetailsSecondaryColumn.Width"
                                                        Value="*"/>
                                        </VisualState.Setters>
                                </VisualState>
                        </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Hero covers upper half -->
                <Grid Grid.Row="0">
                        <Image x:Name="HeroBackdropImage"
                               Source="{Binding SelectedGame.LibraryHero}"
                               Stretch="UniformToFill"
                               Margin="-20,0,0,0"/>
                        <Grid Background="#2C000000"
                              Margin="-20,0,0,0"/>
                        <Grid x:Name="HeroOverlay"
                              Margin="20"
                              VerticalAlignment="Stretch"
                              SizeChanged="HeroOverlay_SizeChanged">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top controls and logo overlay -->
                                <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Back stays top-left -->
                                        <Grid x:Name="BackButtonChrome"
                                              Width="34"
                                              Height="34"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left"
                                              RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                        <CompositeTransform x:Name="BackButtonTransform"
                                                                            ScaleX="1"
                                                                            ScaleY="1"
                                                                            TranslateY="0"/>
                                                </Grid.RenderTransform>
                                                <Border x:Name="BackButtonShell"
                                                        Background="{StaticResource HeroActionSettingsFallbackFillBrush}"
                                                        BorderBrush="{StaticResource HeroActionSettingsFallbackBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="11"
                                                        IsHitTestVisible="False">
                                                        <FontIcon x:Name="BackButtonGlyph"
                                                                  Glyph="&#xE72B;"
                                                                  FontFamily="Segoe Fluent Icons"
                                                                  FontSize="12"
                                                                  Foreground="{StaticResource HeroActionSettingsFallbackForegroundBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                                <Border x:Name="BackButtonHighlight"
                                                        Background="#18FFFFFF"
                                                        CornerRadius="11"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>
                                                <Button x:Name="BackButton"
                                                        Style="{StaticResource HeroActionInputButtonStyle}"
                                                        Click="BackButton_Click"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        CornerRadius="11"
                                                        PointerEntered="HeroActionButton_PointerEntered"
                                                        PointerExited="HeroActionButton_PointerExited"
                                                        PointerPressed="HeroActionButton_PointerPressed"
                                                        PointerReleased="HeroActionButton_PointerReleased"
                                                        PointerCanceled="HeroActionButton_PointerCanceled"
                                                        LostFocus="HeroActionButton_LostFocus"/>
                                        </Grid>

                                        <!-- Logo overlayed with dynamic padding -->
                                        <Grid>
                                                <Image x:Name="HeroLogo"
                                                       Source="{Binding SelectedGame.LibraryLogo}"
                                                       Height="300"
                                                       MaxWidth="500"
                                                       MaxHeight="300"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       IsHitTestVisible="False"
                                                       Margin="36,78,0,0"
                                                       Visibility="{Binding SelectedGame.HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding SelectedGame.Name}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           IsHitTestVisible="False"
                                                           Margin="78,48,0,0"
                                                           FontSize="42"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="600"
                                                           Visibility="{Binding SelectedGame.HasLogo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"/>
                                        </Grid>
                                </Grid>

                                <!-- Settings button bottom-right of the hero (top half) with tighter inset -->
                                <Grid x:Name="DetailsSettingsChrome"
                                      Grid.RowSpan="3"
                                      Width="40"
                                      Height="40"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,0"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                                <CompositeTransform x:Name="DetailsSettingsTransform"
                                                                    ScaleX="1"
                                                                    ScaleY="1"
                                                                    TranslateY="0"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="DetailsSettingsShell"
                                                Background="{StaticResource HeroActionSettingsFallbackFillBrush}"
                                                BorderBrush="{StaticResource HeroActionSettingsFallbackBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                IsHitTestVisible="False">
                                                <Grid>
                                                        <FontIcon x:Name="DetailsSettingsGlyph"
                                                                  Glyph="&#xE713;"
                                                                  FontFamily="Segoe Fluent Icons"
                                                                  FontSize="16"
                                                                  Foreground="{StaticResource HeroActionSettingsFallbackForegroundBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                </Grid>
                                        </Border>
                                        <Border x:Name="DetailsSettingsHighlight"
                                                Background="#18FFFFFF"
                                                CornerRadius="16"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Button x:Name="DetailsSettingsButton"
                                                Style="{StaticResource HeroActionInputButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="16"
                                                Command="{Binding ToggleGameSettingsCommand}"
                                                Click="DetailsSettingsButton_Click"
                                                PointerEntered="HeroActionButton_PointerEntered"
                                                PointerExited="HeroActionButton_PointerExited"
                                                PointerPressed="HeroActionButton_PointerPressed"
                                                PointerReleased="HeroActionButton_PointerReleased"
                                                PointerCanceled="HeroActionButton_PointerCanceled"
                                                LostFocus="HeroActionButton_LostFocus"
                                                ToolTipService.ToolTip="Game settings">
                                                <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrush"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForeground"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                         Color="#00FFFFFF"/>
                                                </Button.Resources>
                                        </Button>
                                </Grid>

                                <!-- Import source tag bottom-center of hero -->
                                <Border Grid.Row="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#22000000"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,4"
                                        Margin="0,0,50,0"
                                        Visibility="{Binding SelectedGame.ImportedFrom, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="5">
                                                <TextBlock Text="via"
                                                           Opacity="0.55"
                                                           FontSize="12"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedGame.ImportedFromDisplay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                </Border>

                                <!-- Play button anchored to the hero's lower-left corner -->
                                <Grid x:Name="DetailsPlayChrome"
                                      Grid.Row="2"
                                      MinWidth="170"
                                      Height="58"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,2"
                                      ToolTipService.ToolTip="{Binding PlayButtonToolTip, Mode=OneWay}"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                                <CompositeTransform x:Name="DetailsPlayTransform"
                                                                    ScaleX="1"
                                                                    ScaleY="1"
                                                                    TranslateY="0"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="DetailsPlayShell"
                                                Background="{StaticResource HeroActionPlayFallbackFillBrush}"
                                                BorderBrush="{StaticResource HeroActionPlayFallbackBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="28"
                                                Opacity="{Binding PlayButtonOpacity, Mode=OneWay, FallbackValue=0.46}"
                                                IsHitTestVisible="False">
                                                <Grid Padding="24,12">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="10"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <FontIcon x:Name="DetailsPlayGlyph"
                                                                          Glyph="&#xE768;"
                                                                          FontFamily="Segoe Fluent Icons"
                                                                          FontSize="16"
                                                                          Foreground="{StaticResource HeroActionPlayFallbackForegroundBrush}"/>
                                                                <TextBlock x:Name="DetailsPlayText"
                                                                           Text="{Binding PlayButtonText, Mode=OneWay, FallbackValue='MISSING'}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           CharacterSpacing="120"
                                                                           Foreground="{StaticResource HeroActionPlayFallbackForegroundBrush}"/>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>
                                        <Border x:Name="DetailsPlayHighlight"
                                                Background="#20FFFFFF"
                                                CornerRadius="28"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Button x:Name="DetailsPlayButton"
                                                Style="{StaticResource HeroActionInputButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="28"
                                                Command="{Binding PlayGameCommand}"
                                                IsEnabled="{Binding CanPlaySelectedGame, Mode=OneWay}"
                                                PointerEntered="HeroActionButton_PointerEntered"
                                                PointerExited="HeroActionButton_PointerExited"
                                                PointerPressed="HeroActionButton_PointerPressed"
                                                PointerReleased="HeroActionButton_PointerReleased"
                                                PointerCanceled="HeroActionButton_PointerCanceled"
                                                LostFocus="HeroActionButton_LostFocus"
                                                ToolTipService.ToolTip="{Binding PlayButtonToolTip, Mode=OneWay}">
                                                <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrush"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForeground"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                         Color="#00FFFFFF"/>
                                                </Button.Resources>
                                        </Button>
                                </Grid>
                        </Grid>

                        <Grid x:Name="SettingsOverlay"
                              Visibility="{Binding IsGameSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border x:Name="SettingsPanelBorder"
                                        MinWidth="250"
                                        MaxWidth="300"
                                        MinHeight="250"
                                        MaxHeight="320"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="#1C1C1C"
                                        BorderBrush="#383838"
                                        BorderThickness="1,0,0,1"
                                        Margin="0,24,0,24"
                                        Padding="22"
                                        CornerRadius="14,0,0,14">

                                        <Grid x:Name="SettingsRootGrid"
                                              RowSpacing="14">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE713;"
                                                                          FontFamily="Segoe MDL2 Assets"
                                                                          FontSize="14"
                                                                          Foreground="#AAAAAA"/>
                                                                <TextBlock x:Name="SettingsHeaderText"
                                                                           Text="Game Settings"
                                                                           FontSize="17"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="Segoe UI Variable Display"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Content="✕"
                                                                Click="CloseGameSettingsButton_Click"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                FontSize="13"
                                                                FontFamily="Segoe UI Variable Text"
                                                                Padding="6,1,5,3"
                                                                Foreground="#666666">
                                                                <Button.Resources>
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                         Color="#22FFFFFF"/>
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                         Color="#33FFFFFF"/>
                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                         Color="#999999"/>
                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                         Color="#666666"/>
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                         Color="Transparent"/>
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                         Color="Transparent"/>
                                                                </Button.Resources>
                                                        </Button>
                                                </Grid>

                                                <Grid x:Name="SettingsContentGrid"
                                                      Grid.Row="1"
                                                      RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="SettingsPrimaryColumn"
                                                                                  Width="*"/>
                                                                <ColumnDefinition x:Name="SettingsSecondaryColumn"
                                                                                  Width="0"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="0"
                                                                Background="#252525"
                                                                BorderBrush="#383838"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,2">
                                                                <StackPanel Spacing="0">
                                                                        <StackPanel x:Name="FolderSizeSection"
                                                                                    Margin="0,8"
                                                                                    Spacing="1">
                                                                                <TextBlock x:Name="FolderSizeLabel"
                                                                                           Text="FOLDER SIZE"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           FontFamily="Segoe UI Variable Text"
                                                                                           Foreground="#444444"
                                                                                           CharacterSpacing="40"/>
                                                                                <TextBlock x:Name="FolderSizeValue"
                                                                                           Text="{Binding SelectedGame.FolderSize, Converter={StaticResource BytesToSizeConverter}, FallbackValue='Not Available'}"
                                                                                           FontWeight="SemiBold"
                                                                                           FontFamily="Segoe UI Variable Text"
                                                                                           Foreground="#CCCCCC"
                                                                                           FontSize="13"/>
                                                                        </StackPanel>

                                                                        <Border Height="1"
                                                                                Background="#383838"/>

                                                                        <StackPanel x:Name="LaunchScriptSection"
                                                                                    Margin="0,8"
                                                                                    Spacing="6">
                                                                                <StackPanel Spacing="1">
                                                                                        <TextBlock x:Name="LaunchScriptLabel"
                                                                                                   Text="LAUNCH OPTIONS"
                                                                                                   FontSize="11"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontFamily="Segoe UI Variable Text"
                                                                                                   Foreground="#444444"
                                                                                                   CharacterSpacing="40"/>

                                                                                        <TextBlock x:Name="LaunchScriptValue"
                                                                                                   Text="{Binding SelectedGame.LaunchOptionsDisplay, TargetNullValue='No launch target selected', FallbackValue='No launch target selected'}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   MaxLines="2"
                                                                                                   Padding="0"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   FontFamily="Segoe UI Variable Text"
                                                                                                   FontSize="12"/>
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="8">
                                                                                        <Button Content="Change"
                                                                                                Padding="14,7"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                FontFamily="Segoe UI Variable Text"
                                                                                                Background="#252525"
                                                                                                BorderBrush="#383838"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="8"
                                                                                                Foreground="#AAAAAA">
                                                                                                <Button.Resources>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                                         Color="#2E2E2E"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                                         Color="#333333"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                                         Color="#484848"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                                         Color="#505050"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                                         Color="#CCCCCC"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                                         Color="#AAAAAA"/>
                                                                                                </Button.Resources>
                                                                                                <Button.Flyout>
                                                                                                        <MenuFlyout>
                                                                                                                <MenuFlyoutItem Text="Launch script"
                                                                                                                                Click="ChangeLaunchScriptMenuItem_Click"/>
                                                                                                                <MenuFlyoutItem Text="Executable"
                                                                                                                                Click="ChangeExecutableMenuItem_Click"/>
                                                                                                        </MenuFlyout>
                                                                                                </Button.Flyout>
                                                                                        </Button>

                                                                                        <Button Content="Reset"
                                                                                                Command="{Binding ResetLaunchOptionsCommand}"
                                                                                                Visibility="{Binding SelectedGame.HasCustomLaunchOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                Padding="14,7"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                FontFamily="Segoe UI Variable Text"
                                                                                                Background="#252525"
                                                                                                BorderBrush="#383838"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="8"
                                                                                                Foreground="#AAAAAA">
                                                                                                <Button.Resources>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                                         Color="#2E2E2E"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                                         Color="#333333"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                                         Color="#484848"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                                         Color="#505050"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                                         Color="#CCCCCC"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                                         Color="#AAAAAA"/>
                                                                                                </Button.Resources>
                                                                                        </Button>
                                                                                </StackPanel>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </Border>
                                                </Grid>

                                                <StackPanel x:Name="DeleteSection"
                                                            Grid.Row="2"
                                                            Spacing="7">
                                                        <TextBlock x:Name="DeleteSectionLabel"
                                                                   Text="LIBRARY"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="Segoe UI Variable Text"
                                                                   Foreground="#444444"
                                                                   CharacterSpacing="40"/>
                                                        <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Content="Open Folder"
                                                                        Grid.Column="0"
                                                                        Command="{Binding OpenGameFolderCommand}"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        Padding="0,9"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        FontFamily="Segoe UI Variable Text"
                                                                        Background="#252525"
                                                                        BorderBrush="#383838"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Foreground="#AAAAAA">
                                                                        <Button.Resources>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                 Color="#2E2E2E"/>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                 Color="#333333"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                 Color="#484848"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                 Color="#505050"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                 Color="#CCCCCC"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                 Color="#AAAAAA"/>
                                                                        </Button.Resources>
                                                                </Button>
                                                                <Button x:Name="RemoveGameButton"
                                                                        Content="Remove"
                                                                        Grid.Column="1"
                                                                        Click="RemoveGameButton_Click"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        Padding="0,9"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        FontFamily="Segoe UI Variable Text"
                                                                        Background="#33FF6B6B"
                                                                        BorderBrush="#66FF6B6B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Foreground="#FF6B6B">
                                                                        <Button.Resources>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                 Color="#4DFF6B6B"/>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                 Color="#66FF6B6B"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                 Color="#99FF6B6B"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                 Color="#BBFF6B6B"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                 Color="#FF8A8A"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                 Color="#FF6B6B"/>
                                                                        </Button.Resources>
                                                                </Button>
                                                        </Grid>
                                                </StackPanel>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>

                <!-- Lower Half -->
                <Grid x:Name="DetailsLowerGrid"
                      Grid.Row="1"
                      Padding="18,10,0,10">

                        <!-- Game Info + Description + Links -->
                        <ScrollViewer x:Name="DetailsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch"
                                      Padding="{x:Bind DetailsScrollViewerPadding, Mode=OneWay}">
                                <Grid x:Name="DetailsLowerContentGrid"
                                      ColumnSpacing="{x:Bind DetailsOuterColumnSpacing, Mode=OneWay}"
                                      RowSpacing="{x:Bind DetailsSectionSpacing, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition x:Name="DetailsActionsColumn"
                                                                  Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="DetailsContentGrid"
                                              Grid.Row="0"
                                              Grid.Column="0"
                                              RowSpacing="{x:Bind DetailsDataSetSpacing, Mode=OneWay}"
                                              ColumnSpacing="{x:Bind DetailsInnerColumnSpacing, Mode=OneWay}"
                                              HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="DetailsPrimaryColumn"
                                                                          MaxWidth="280"/>
                                                        <ColumnDefinition x:Name="DetailsSecondaryColumn"
                                                                          Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel x:Name="DetailsInfoPrimarySection"
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Spacing="{x:Bind DetailsSectionSpacing, Mode=OneWay}">
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Publisher"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.Publisher, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Developer"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.Developer, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Genre"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.Genres, Converter={StaticResource ListToCommaConverter}, FallbackValue='N/A'}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </StackPanel>

                                                <StackPanel x:Name="DetailsInfoTopSecondarySection"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Margin="0,-10,0,0"
                                                            Spacing="{x:Bind DetailsSectionSpacing, Mode=OneWay}">
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Age Rating"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.DisplayAgeRating, FallbackValue='Not Available'}"
                                                                           Opacity="{Binding SelectedGame.AgeRatingOpacity, FallbackValue=0.6}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Release Date"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource DateToStringConverter}, FallbackValue='N/A'}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding SelectedGame.OriginalReleaseDisplay, FallbackValue=''}"
                                                                           Visibility="{Binding SelectedGame.HasOriginalReleaseDate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                           Opacity="0.72"
                                                                           FontSize="{x:Bind DetailsInlineFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Price"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap">
                                        <Run Text="{Binding SelectedGame.Price, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"/>
                                        <Run Text="{Binding SelectedGame.PriceDiscount, FallbackValue=''}"
                                                                        FontSize="{x:Bind DetailsInlineFontSize, Mode=OneWay}"
                                                                        Foreground="#B3FFFFFF"/>
                                                                </TextBlock>
                                                        </StackPanel>
                                                </StackPanel>

                                                <StackPanel x:Name="DetailsDescriptionSection"
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="0,-10,0,0"
                                                            Spacing="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="Description"
                                                                   Opacity="0.4"
                                                                   Margin="0,0,0,0"
                                                                   HorizontalAlignment="Left"
                                                                   FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                        <TextBlock Text="{Binding SelectedGame.Description, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"
                                                                   HorizontalAlignment="Left"
                                                                   FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                   MaxWidth="{x:Bind DetailsDescriptionMaxWidth, Mode=OneWay}"
                                                                   TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel x:Name="DetailsInfoSecondarySection"
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Spacing="{x:Bind DetailsSectionSpacing, Mode=OneWay}"
                                                            VerticalAlignment="Top">
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Steam Reviews"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Opacity="{Binding SelectedGame.SteamReviewOpacity, FallbackValue=0.6}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap">
                                                                        <Run Text="{Binding SelectedGame.DisplaySteamReviewSummary, FallbackValue='Not Available'}"/>
                                                                        <Run Text="{Binding SelectedGame.DisplaySteamReviewCount, FallbackValue=''}"
                                                                             FontSize="{x:Bind DetailsInlineFontSize, Mode=OneWay}"
                                                                             Foreground="#A0A0A0"/>
                                                                </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Main Story"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.DisplayMainStory, FallbackValue='Not Available'}"
                                                                           Opacity="{Binding SelectedGame.MainStoryOpacity, FallbackValue=0.6}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="0">
                                                                <TextBlock Text="Completionist"
                                                                           Opacity="0.4"
                                                                           FontSize="{x:Bind DetailsLabelFontSize, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding SelectedGame.DisplayCompletionist, FallbackValue='Not Available'}"
                                                                           Opacity="{Binding SelectedGame.CompletionistOpacity, FallbackValue=0.6}"
                                                                           FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </StackPanel>
                                        </Grid>

                                        <!-- Actions, platform icons, and links -->
                                        <StackPanel x:Name="DetailsActionsSection"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Spacing="{x:Bind DetailsSectionSpacing, Mode=OneWay}"
                                                    Margin="0,10,6,0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right">
                                                <ItemsControl x:Name="DetailsPlatformItemsControl"
                                                              ItemsSource="{Binding SelectedGame.PlatformLogoUris, Mode=OneWay}"
                                                              Tag="{x:Bind DetailsPlatformIconHeight, Mode=OneWay}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"
                                                              Margin="0,-10,4,10">
                                                        <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="8"/>
                                                                </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Image Source="{Binding}"
                                                                               Height="{Binding Tag, ElementName=DetailsPlatformItemsControl}"
                                                                               Stretch="Uniform"/>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel x:Name="DetailsLinksPanel"
                                                            Spacing="0"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,-6,4,0">
                                                        <StackPanel.Resources>
                                                                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver"
                                                                                 Color="Transparent"/>
                                                                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed"
                                                                                 Color="Transparent"/>
                                                        </StackPanel.Resources>
                                                        <HyperlinkButton Content="Website"
                                                                         Foreground="White"
                                                                         Margin="0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Style="{StaticResource UnderlinedHyperlinkButton}"
                                                                         HorizontalAlignment="Right"
                                                                         NavigateUri="{Binding SelectedGame.OfficialWebsiteUrl}"
                                                                         Visibility="{Binding SelectedGame.OfficialWebsiteUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <HyperlinkButton Content="Steam"
                                                                         Foreground="White"
                                                                         Margin="0,4,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Style="{StaticResource UnderlinedHyperlinkButton}"
                                                                         HorizontalAlignment="Right"
                                                                         NavigateUri="{Binding SelectedGame.SteamPageUrl}"
                                                                         Visibility="{Binding SelectedGame.SteamPageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <HyperlinkButton Content="RAWG"
                                                                         Foreground="White"
                                                                         Margin="0,6,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Style="{StaticResource UnderlinedHyperlinkButton}"
                                                                         HorizontalAlignment="Right"
                                                                         NavigateUri="{Binding SelectedGame.RawgUrl}"
                                                                         Visibility="{Binding SelectedGame.RawgUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <HyperlinkButton Content="IGDB"
                                                                         Foreground="White"
                                                                         Margin="0,6,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Style="{StaticResource UnderlinedHyperlinkButton}"
                                                                         HorizontalAlignment="Right"
                                                                         NavigateUri="{Binding SelectedGame.IgdbUrl}"
                                                                         Visibility="{Binding SelectedGame.IgdbUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <HyperlinkButton Content="HowLongToBeat"
                                                                         Foreground="White"
                                                                         Margin="0,6,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Style="{StaticResource UnderlinedHyperlinkButton}"
                                                                         HorizontalAlignment="Right"
                                                                         NavigateUri="{Binding SelectedGame.HltbUrl}"
                                                                         Visibility="{Binding SelectedGame.HltbUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <HyperlinkButton Content="Media"
                                                                         Foreground="White"
                                                                         Margin="0,6,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Opacity="0.45"
                                                                         FontWeight="SemiBold"
                                                                         HorizontalAlignment="Right"
                                                                         Command="{Binding OpenMediaOverlayCommand}"/>
                                                        <HyperlinkButton Content="Franchise"
                                                                         Foreground="White"
                                                                         Margin="0,6,0,0"
                                                                         Padding="0"
                                                                         FontSize="{x:Bind DetailsLinkFontSize, Mode=OneWay}"
                                                                         Opacity="0.45"
                                                                         FontWeight="SemiBold"
                                                                         HorizontalAlignment="Right"
                                                                         Command="{Binding OpenFranchiseOverlayCommand}"
                                                                         Visibility="{Binding SelectedGame.FranchiseGames, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                        </StackPanel>
                                </Grid>
                        </ScrollViewer>
                </Grid>

                <Canvas x:Name="SettingsPopoverLayer"
                        Grid.RowSpan="2"
                        Visibility="{Binding IsGameSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsHitTestVisible="True"
                        Canvas.ZIndex="10">
                        <Border x:Name="RemoveGameConfirmationPopover"
                                Width="240"
                                Visibility="Collapsed"
                                Background="#1C1C1C"
                                BorderBrush="#4A3434"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                                <StackPanel Spacing="10">
                                        <StackPanel Spacing="2">
                                                <TextBlock Text="Are you sure?"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Segoe UI Variable Text"
                                                           Foreground="#FFFFFF"/>
                                                <TextBlock Text="This removes the game from your library. Files stay on disk."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           FontFamily="Segoe UI Variable Text"
                                                           Foreground="#8A8A8A"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="No"
                                                        Grid.Column="0"
                                                        Click="CancelDeleteSelectedGameButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Padding="0,7"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        FontFamily="Segoe UI Variable Text"
                                                        Background="#252525"
                                                        BorderBrush="#383838"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Foreground="#AAAAAA">
                                                        <Button.Resources>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                 Color="#2E2E2E"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                 Color="#333333"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                 Color="#484848"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                 Color="#505050"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                 Color="#CCCCCC"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                 Color="#AAAAAA"/>
                                                        </Button.Resources>
                                                </Button>
                                                <Button Content="Yes"
                                                        Grid.Column="1"
                                                        Click="ConfirmDeleteSelectedGameButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Padding="0,7"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        FontFamily="Segoe UI Variable Text"
                                                        Background="#33FF6B6B"
                                                        BorderBrush="#66FF6B6B"
                                                        BorderThickness="1"
