<?xml version="1.0" encoding="utf-8"?>
<UserControl
        x:Class="Codec.Views.GameDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Codec.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

        <UserControl.Resources>
                <conv:ListToCommaConverter x:Key="ListToCommaConverter"/>
                <conv:SecondsToTimeConverter x:Key="SecondsToTimeConverter"/>
                <conv:DateToStringConverter x:Key="DateToStringConverter"/>
                <conv:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter"/>
                <conv:UriToMediaSourceConverter x:Key="UriToMediaSourceConverter"/>
                <conv:NullOrEmptyToFallbackConverter x:Key="NullOrEmptyToFallbackConverter"/>
                <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                <conv:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
                <Style x:Key="DetailMetaLabelTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontFamily"
                                Value="{StaticResource CodecSemiBoldFontFamily}"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#9E8E78"/>
                </Style>
                <Style x:Key="DetailMetaValueTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontFamily"
                                Value="{StaticResource CodecSemiBoldFontFamily}"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#F3EDC9"/>
                </Style>
                <DataTemplate x:Key="DetailTaxonomyChipTemplate">
                        <Border Margin="0,0,6,6"
                                Padding="9,4"
                                Background="{StaticResource CodecBackgroundBrush}"
                                BorderBrush="{StaticResource CodecBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                           Foreground="{StaticResource CodecTextMutedBrush}"/>
                        </Border>
                </DataTemplate>
                <Style x:Key="DetailRailButtonStyle"
                       TargetType="Button">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="14,12"/>
                        <Setter Property="MinHeight" Value="58"/>
                        <Setter Property="Background" Value="{StaticResource CodecBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CodecBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="UseSystemFocusVisuals" Value="True"/>
                </Style>
                <Style x:Key="DetailRailLinkStyle"
                       TargetType="HyperlinkButton">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,7"/>
                        <Setter Property="Foreground" Value="{StaticResource CodecTextMutedBrush}"/>
                        <Setter Property="FontFamily" Value="{StaticResource CodecSemiBoldFontFamily}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="UseSystemFocusVisuals" Value="True"/>
                </Style>
                <SolidColorBrush x:Key="HeroActionPlayFallbackFillBrush"
                                 Color="#861C1A17"/>
                <SolidColorBrush x:Key="HeroActionSettingsFallbackFillBrush"
                                 Color="#7425221F"/>
                <SolidColorBrush x:Key="HeroActionPlayFallbackForegroundBrush"
                                 Color="#FFF3EDC9"/>
                <SolidColorBrush x:Key="HeroActionSettingsFallbackForegroundBrush"
                                 Color="#FFD4A832"/>
                <LinearGradientBrush x:Key="HeroActionPlayFallbackBorderBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#D4E76C2B"
                                      Offset="0"/>
                        <GradientStop Color="#52D4A832"
                                      Offset="0.42"/>
                        <GradientStop Color="#26E76C2B"
                                      Offset="1"/>
                </LinearGradientBrush>
                <LinearGradientBrush x:Key="HeroActionSettingsFallbackBorderBrush"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#A4C4956A"
                                      Offset="0"/>
                        <GradientStop Color="#34D4A832"
                                      Offset="0.52"/>
                        <GradientStop Color="#18E76C2B"
                                      Offset="1"/>
                </LinearGradientBrush>
                <Style x:Key="HeroActionInputButtonStyle"
                       TargetType="Button">
                        <Setter Property="Background"
                                Value="#01000000"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="UseSystemFocusVisuals"
                                Value="False"/>
                </Style>
                <Style x:Key="DetailDrawerButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#9E8E78"/>
                        <Setter Property="UseSystemFocusVisuals" Value="True"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                        <ContentPresenter x:Name="DrawerIconPresenter"
                                                                          Padding="{TemplateBinding Padding}"
                                                                          HorizontalContentAlignment="Center"
                                                                          VerticalContentAlignment="Center"
                                                                          Opacity="0.72"/>
                                                        <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal"/>
                                                                        <VisualState x:Name="PointerOver">
                                                                                <VisualState.Setters>
                                                                                        <Setter Target="DrawerIconPresenter.Opacity" Value="1"/>
                                                                                </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                                <VisualState.Setters>
                                                                                        <Setter Target="DrawerIconPresenter.Opacity" Value="0.48"/>
                                                                                </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Disabled"/>
                                                                </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                </Grid>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </UserControl.Resources>

        <Grid x:Name="RootLayout">
                <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="SettingsLayoutStates">
                                <VisualState x:Name="SettingsComfortableState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="340"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,24,0,24"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="22"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="14"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="17"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="2"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="7"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SettingsCompactState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="326"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,18,0,18"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="20"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="12"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="16"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="2"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="7"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="SettingsTightState">
                                        <VisualState.Setters>
                                                <Setter Target="SettingsPanelBorder.Width"
                                                        Value="310"/>
                                                <Setter Target="SettingsPanelBorder.Margin"
                                                        Value="0,14,0,14"/>
                                                <Setter Target="SettingsPanelBorder.Padding"
                                                        Value="18"/>
                                                <Setter Target="SettingsRootGrid.RowSpacing"
                                                        Value="10"/>
                                                <Setter Target="SettingsContentGrid.RowSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsContentGrid.ColumnSpacing"
                                                        Value="0"/>
                                                <Setter Target="SettingsPrimaryColumn.Width"
                                                        Value="*"/>
                                                <Setter Target="SettingsSecondaryColumn.Width"
                                                        Value="0"/>
                                                <Setter Target="SettingsHeaderText.FontSize"
                                                        Value="16"/>
                                                <Setter Target="FolderSizeLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="LaunchScriptLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="DeleteSectionLabel.FontSize"
                                                        Value="11"/>
                                                <Setter Target="FolderSizeValue.FontSize"
                                                        Value="13"/>
                                                <Setter Target="LaunchScriptValue.FontSize"
                                                        Value="12"/>
                                                <Setter Target="LaunchScriptValue.MaxLines"
                                                        Value="1"/>
                                                <Setter Target="FolderSizeSection.Spacing"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.Spacing"
                                                        Value="4"/>
                                                <Setter Target="DeleteSection.Spacing"
                                                        Value="6"/>
                                                <Setter Target="FolderSizeSection.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="FolderSizeSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="LaunchScriptSection.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="LaunchScriptSection.(Grid.ColumnSpan)"
                                                        Value="1"/>
                                        </VisualState.Setters>
                                </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DetailsLayoutStates">
                                <VisualState x:Name="DetailsComfortableState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode" Value="Disabled"/>
                                                <Setter Target="DetailsRailColumn.Width" Value="300"/>
                                                <Setter Target="DetailsInfoCard.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.Row)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.Column)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsRightRail.Margin" Value="0"/>
                                                <Setter Target="MetricColumn1.Width" Value="*"/>
                                                <Setter Target="MetricColumn2.Width" Value="*"/>
                                                <Setter Target="MetricColumn3.Width" Value="*"/>
                                                <Setter Target="MetricColumn4.Width" Value="*"/>
                                                <Setter Target="MetricColumn5.Width" Value="*"/>
                                                <Setter Target="MetricReviews.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricReviews.(Grid.Column)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Column)" Value="1"/>
                                                <Setter Target="MetricCompletionist.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricCompletionist.(Grid.Column)" Value="2"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Column)" Value="3"/>
                                                <Setter Target="MetricController.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricController.(Grid.Column)" Value="4"/>
                                                <Setter Target="MetricController.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsDescriptionColumn.Width" Value="*"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Row)" Value="0"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Column)" Value="2"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsMetadataDivider.Visibility" Value="Visible"/>
                                                <Setter Target="DetailsMetricsCard.Padding" Value="18,14"/>
                                                <Setter Target="DetailsInfoCard.Padding" Value="20"/>
                                                <Setter Target="DetailsRightRail.Padding" Value="18"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="DetailsCompactState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode" Value="Disabled"/>
                                                <Setter Target="DetailsRailColumn.Width" Value="260"/>
                                                <Setter Target="DetailsInfoCard.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.Row)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.Column)" Value="1"/>
                                                <Setter Target="DetailsRightRail.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsRightRail.Margin" Value="0"/>
                                                <Setter Target="MetricColumn1.Width" Value="*"/>
                                                <Setter Target="MetricColumn2.Width" Value="*"/>
                                                <Setter Target="MetricColumn3.Width" Value="*"/>
                                                <Setter Target="MetricColumn4.Width" Value="*"/>
                                                <Setter Target="MetricColumn5.Width" Value="*"/>
                                                <Setter Target="MetricReviews.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricReviews.(Grid.Column)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Column)" Value="1"/>
                                                <Setter Target="MetricCompletionist.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricCompletionist.(Grid.Column)" Value="2"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Column)" Value="3"/>
                                                <Setter Target="MetricController.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricController.(Grid.Column)" Value="4"/>
                                                <Setter Target="MetricController.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsDescriptionColumn.Width" Value="*"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Row)" Value="0"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Column)" Value="2"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.ColumnSpan)" Value="1"/>
                                                <Setter Target="DetailsMetadataDivider.Visibility" Value="Visible"/>
                                                <Setter Target="DetailsMetricsCard.Padding" Value="14,12"/>
                                                <Setter Target="DetailsInfoCard.Padding" Value="16"/>
                                                <Setter Target="DetailsRightRail.Padding" Value="14"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="DetailsTightState">
                                        <VisualState.Setters>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                                <Setter Target="DetailsScrollViewer.VerticalScrollMode" Value="Enabled"/>
                                                <Setter Target="DetailsRailColumn.Width" Value="0"/>
                                                <Setter Target="DetailsInfoCard.(Grid.ColumnSpan)" Value="2"/>
                                                <Setter Target="DetailsRightRail.(Grid.Row)" Value="2"/>
                                                <Setter Target="DetailsRightRail.(Grid.Column)" Value="0"/>
                                                <Setter Target="DetailsRightRail.(Grid.ColumnSpan)" Value="2"/>
                                                <Setter Target="DetailsRightRail.Margin" Value="0"/>
                                                <Setter Target="MetricColumn1.Width" Value="*"/>
                                                <Setter Target="MetricColumn2.Width" Value="*"/>
                                                <Setter Target="MetricColumn3.Width" Value="0"/>
                                                <Setter Target="MetricColumn4.Width" Value="0"/>
                                                <Setter Target="MetricColumn5.Width" Value="0"/>
                                                <Setter Target="MetricReviews.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricReviews.(Grid.Column)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Row)" Value="0"/>
                                                <Setter Target="MetricMainStory.(Grid.Column)" Value="1"/>
                                                <Setter Target="MetricCompletionist.(Grid.Row)" Value="1"/>
                                                <Setter Target="MetricCompletionist.(Grid.Column)" Value="0"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Row)" Value="1"/>
                                                <Setter Target="MetricReleaseDate.(Grid.Column)" Value="1"/>
                                                <Setter Target="MetricController.(Grid.Row)" Value="2"/>
                                                <Setter Target="MetricController.(Grid.Column)" Value="0"/>
                                                <Setter Target="MetricController.(Grid.ColumnSpan)" Value="2"/>
                                                <Setter Target="DetailsDescriptionColumn.Width" Value="0"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Row)" Value="1"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.Column)" Value="0"/>
                                                <Setter Target="DetailsDescriptionSection.(Grid.ColumnSpan)" Value="3"/>
                                                <Setter Target="DetailsMetadataDivider.Visibility" Value="Collapsed"/>
                                                <Setter Target="DetailsMetricsCard.Padding" Value="14,12"/>
                                                <Setter Target="DetailsInfoCard.Padding" Value="14"/>
                                                <Setter Target="DetailsRightRail.Padding" Value="14"/>
                                        </VisualState.Setters>
                                </VisualState>
                        </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.RowDefinitions>
                        <RowDefinition Height="54*"/>
                        <RowDefinition Height="46*"/>
                </Grid.RowDefinitions>

                <!-- Hero covers upper half -->
                <Grid x:Name="HeroArtworkLayer"
                      Grid.Row="0"
                      SizeChanged="HeroArtworkLayer_SizeChanged">
                        <Border x:Name="HeroBackdropImage"
                                Margin="-24,0,0,0">
                                <Border.Background>
                                        <ImageBrush ImageSource="{Binding SelectedGame.LibraryHero}"
                                                    Stretch="UniformToFill"
                                                    AlignmentY="Bottom"/>
                                </Border.Background>
                        </Border>
                        <Image Source="{Binding SelectedGame.LibraryHero}"
                               Width="1"
                               Height="1"
                               Opacity="0"
                               ImageOpened="HeroBackdropImage_ImageOpened"
                               ImageFailed="HeroBackdropImage_ImageFailed"
                               IsHitTestVisible="False"/>
                        <Border x:Name="HeroBackdropBlur"
                                Margin="-24,0,0,0"
                                Visibility="Collapsed">
                                <Border.Background>
                                        <AcrylicBrush TintColor="#1C1A17"
                                                      TintOpacity="0.32"
                                                      TintLuminosityOpacity="0.18"
                                                      FallbackColor="#991C1A17"/>
                                </Border.Background>
                        </Border>
                        <Grid x:Name="HeroForegroundLayer"
                              Margin="-24,0,0,0"
                              Visibility="Collapsed"
                              IsHitTestVisible="False">
                                <Image x:Name="HeroForegroundImage"
                                       Source="{Binding SelectedGame.LibraryHero}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid Background="#441C1A17"
                              Margin="-24,0,0,0"/>
                        <Grid x:Name="HeroOverlay"
                              Margin="20"
                              VerticalAlignment="Stretch"
                              SizeChanged="HeroOverlay_SizeChanged">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top controls and logo overlay -->
                                <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid ColumnSpacing="8"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="DetailSidebarOpenButton"
                                                        Grid.Column="1"
                                                        Style="{StaticResource DetailDrawerButtonStyle}"
                                                        Command="{Binding ToggleSidebarCommand}"
                                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ToolTipService.ToolTip="Open sidebar"
                                                        AutomationProperties.Name="Open sidebar"
                                                        VerticalAlignment="Center">
                                                        <Viewbox Width="18" Height="18">
                                                                <Canvas Width="18" Height="18">
                                                                        <Path Data="M4,3.5 L14,3.5 Q15.5,3.5 15.5,5 L15.5,13 Q15.5,14.5 14,14.5 L4,14.5 Q2.5,14.5 2.5,13 L2.5,5 Q2.5,3.5 4,3.5 Z M7,3.5 L7,14.5"
                                                                              Stroke="{Binding Foreground, ElementName=DetailSidebarOpenButton}"
                                                                              StrokeThickness="1.4"
                                                                              StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                        </Viewbox>
                                                </Button>

                                                <Grid x:Name="BackButtonChrome"
                                               Width="28"
                                               Height="28"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left"
                                              RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                        <CompositeTransform x:Name="BackButtonTransform"
                                                                            ScaleX="1"
                                                                            ScaleY="1"
                                                                            TranslateY="0"/>
                                                </Grid.RenderTransform>
                                                <Border x:Name="BackButtonShell"
                                                        Background="{StaticResource HeroActionSettingsFallbackFillBrush}"
                                                        BorderBrush="{StaticResource HeroActionSettingsFallbackBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        IsHitTestVisible="False">
                                                        <Viewbox Width="11"
                                                                 Height="11"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                                <Viewbox.RenderTransform>
                                                                        <CompositeTransform TranslateX="-0.8"/>
                                                                </Viewbox.RenderTransform>
                                                                <Path x:Name="BackButtonGlyph"
                                                                      Width="11"
                                                                      Height="11"
                                                                      Data="M 8.6 3.2 L 4.2 6.5 L 8.6 9.8"
                                                                      Stroke="{StaticResource HeroActionSettingsFallbackForegroundBrush}"
                                                                      StrokeThickness="1.75"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Stretch="Uniform"
                                                                      Fill="Transparent"/>
                                                        </Viewbox>
                                                </Border>
                                                <Border x:Name="BackButtonHighlight"
                                                        Background="#22D4A832"
                                                        CornerRadius="10"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>
                                                <Button x:Name="BackButton"
                                                        Style="{StaticResource HeroActionInputButtonStyle}"
                                                        Click="BackButton_Click"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        CornerRadius="10"
                                                        PointerEntered="HeroActionButton_PointerEntered"
                                                        PointerExited="HeroActionButton_PointerExited"
                                                        PointerPressed="HeroActionButton_PointerPressed"
                                                        PointerReleased="HeroActionButton_PointerReleased"
                                                        PointerCanceled="HeroActionButton_PointerCanceled"
                                                        LostFocus="HeroActionButton_LostFocus">
                                                        <Button.Resources>
                                                                <SolidColorBrush x:Key="ButtonBackground"
                                                                                 Color="#01000000"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                 Color="#01000000"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                 Color="#01000000"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrush"
                                                                                 Color="#00FFFFFF"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                 Color="#00FFFFFF"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                 Color="#00FFFFFF"/>
                                                                <SolidColorBrush x:Key="ButtonForeground"
                                                                                 Color="#00FFFFFF"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                 Color="#00FFFFFF"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                 Color="#00FFFFFF"/>
                                                        </Button.Resources>
                                                </Button>
                                                </Grid>
                                        </Grid>

                                        <!-- Logo overlayed with dynamic padding -->
                                        <Grid>
                                                <Image x:Name="HeroLogo"
                                                       Source="{Binding SelectedGame.LibraryLogo}"
                                                       Height="300"
                                                       MaxWidth="500"
                                                       MaxHeight="300"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       IsHitTestVisible="False"
                                                       Margin="36,78,0,0"
                                                       Visibility="{Binding SelectedGame.HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                </Grid>

                                <!-- Settings stays beside the primary action so its purpose is clear. -->
                                <Grid x:Name="DetailsSettingsChrome"
                                      Grid.Row="2"
                                      Width="58"
                                      Height="58"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="184,0,0,18"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                                <CompositeTransform x:Name="DetailsSettingsTransform"
                                                                    ScaleX="1"
                                                                    ScaleY="1"
                                                                    TranslateY="0"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="DetailsSettingsShell"
                                                Background="{StaticResource HeroActionSettingsFallbackFillBrush}"
                                                BorderBrush="{StaticResource HeroActionSettingsFallbackBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="28"
                                                IsHitTestVisible="False">
                                                <Grid>
                                                        <FontIcon x:Name="DetailsSettingsGlyph"
                                                                  Glyph="&#xE713;"
                                                                  FontFamily="Segoe Fluent Icons"
                                                                  FontSize="16"
                                                                  Foreground="{StaticResource HeroActionSettingsFallbackForegroundBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                </Grid>
                                        </Border>
                                        <Border x:Name="DetailsSettingsHighlight"
                                                Background="#18E76C2B"
                                                CornerRadius="28"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Button x:Name="DetailsSettingsButton"
                                                Style="{StaticResource HeroActionInputButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="28"
                                                Command="{Binding ToggleGameSettingsCommand}"
                                                Click="DetailsSettingsButton_Click"
                                                PointerEntered="HeroActionButton_PointerEntered"
                                                PointerExited="HeroActionButton_PointerExited"
                                                PointerPressed="HeroActionButton_PointerPressed"
                                                PointerReleased="HeroActionButton_PointerReleased"
                                                PointerCanceled="HeroActionButton_PointerCanceled"
                                                LostFocus="HeroActionButton_LostFocus"
                                                ToolTipService.ToolTip="Game settings">
                                                <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrush"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForeground"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                         Color="#00FFFFFF"/>
                                                </Button.Resources>
                                        </Button>
                                </Grid>

                                <!-- Play button anchored to the hero's lower-left corner -->
                                <Grid x:Name="DetailsPlayChrome"
                                      Grid.Row="2"
                                      MinWidth="170"
                                      Height="58"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,18"
                                      ToolTipService.ToolTip="{Binding PlayButtonToolTip, Mode=OneWay}"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                                <CompositeTransform x:Name="DetailsPlayTransform"
                                                                    ScaleX="1"
                                                                    ScaleY="1"
                                                                    TranslateY="0"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="DetailsPlayShell"
                                                Background="{StaticResource HeroActionPlayFallbackFillBrush}"
                                                BorderBrush="{StaticResource HeroActionPlayFallbackBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="28"
                                                Opacity="{Binding PlayButtonOpacity, Mode=OneWay, FallbackValue=0.46}"
                                                IsHitTestVisible="False">
                                                <Grid Padding="24,12">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="10"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <Grid Width="18" Height="18">
                                                                        <FontIcon x:Name="DetailsPlayGlyph"
                                                                                  Glyph="{Binding PlayButtonGlyph, Mode=OneWay}"
                                                                                  FontFamily="Segoe Fluent Icons"
                                                                                  FontSize="16"
                                                                                  Foreground="{StaticResource HeroActionPlayFallbackForegroundBrush}"
                                                                                  Visibility="{Binding IsPlayGlyphVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        <ProgressRing Width="18"
                                                                                      Height="18"
                                                                                      IsActive="{Binding IsLaunchSpinnerVisible, Mode=OneWay}"
                                                                                      Foreground="#D4A832"
                                                                                      Visibility="{Binding IsLaunchSpinnerVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </Grid>
                                                                <TextBlock x:Name="DetailsPlayText"
                                                                           Text="{Binding PlayButtonText, Mode=OneWay, FallbackValue='MISSING'}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           FontFamily="{StaticResource CodecBoldFontFamily}"
                                                                           CharacterSpacing="120"
                                                                           Foreground="{StaticResource HeroActionPlayFallbackForegroundBrush}"/>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>
                                        <Border x:Name="DetailsPlayHighlight"
                                                Background="#20E76C2B"
                                                CornerRadius="28"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Button x:Name="DetailsPlayButton"
                                                Style="{StaticResource HeroActionInputButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="28"
                                                Command="{Binding PlayGameCommand}"
                                                IsEnabled="{Binding CanPlaySelectedGame, Mode=OneWay}"
                                                PointerEntered="HeroActionButton_PointerEntered"
                                                PointerExited="HeroActionButton_PointerExited"
                                                PointerPressed="HeroActionButton_PointerPressed"
                                                PointerReleased="HeroActionButton_PointerReleased"
                                                PointerCanceled="HeroActionButton_PointerCanceled"
                                                LostFocus="HeroActionButton_LostFocus"
                                                ToolTipService.ToolTip="{Binding PlayButtonToolTip, Mode=OneWay}">
                                                <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                         Color="#01000000"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrush"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForeground"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                         Color="#00FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                         Color="#00FFFFFF"/>
                                                </Button.Resources>
                                        </Button>
                                </Grid>
                        </Grid>

                        <Grid x:Name="SettingsOverlay"
                              Visibility="{Binding IsGameSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border x:Name="SettingsPanelBorder"
                                        MinWidth="250"
                                        MaxWidth="300"
                                        MinHeight="250"
                                        MaxHeight="320"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="#1C1A17"
                                        BorderBrush="#3E3830"
                                        BorderThickness="1,0,0,1"
                                        Margin="0,24,0,24"
                                        Padding="22"
                                        CornerRadius="14,0,0,14">

                                        <Grid x:Name="SettingsRootGrid"
                                              RowSpacing="14">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE713;"
                                                                          FontFamily="Segoe MDL2 Assets"
                                                                          FontSize="14"
                                                                          Foreground="#9E8E78"/>
                                                                <TextBlock x:Name="SettingsHeaderText"
                                                                           Text="Game Settings"
                                                                           FontSize="17"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                           Foreground="#F3EDC9"
                                                                           VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Content="✕"
                                                                Click="CloseGameSettingsButton_Click"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                FontSize="13"
                                                                FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                Padding="6,1,5,3"
                                                                Foreground="#9E8E78">
                                                                <Button.Resources>
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                         Color="#22E76C2B"/>
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                         Color="#33E76C2B"/>
                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                         Color="#F3EDC9"/>
                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                         Color="#9E8E78"/>
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                         Color="Transparent"/>
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                         Color="Transparent"/>
                                                                </Button.Resources>
                                                        </Button>
                                                </Grid>

                                                <Grid x:Name="SettingsContentGrid"
                                                      Grid.Row="1"
                                                      RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="SettingsPrimaryColumn"
                                                                                  Width="*"/>
                                                                <ColumnDefinition x:Name="SettingsSecondaryColumn"
                                                                                  Width="0"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="0"
                                                                Background="#25221F"
                                                                BorderBrush="#3E3830"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,2">
                                                                <StackPanel Spacing="0">
                                                                        <Border Margin="0,8,0,0"
                                                                                Padding="9,6"
                                                                                Background="#18D4A832"
                                                                                BorderBrush="#55D4A832"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Visibility="{Binding SelectedGame.IsAlsoOwnedOnSteam, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="7">
                                                                                        <FontIcon Glyph="&#xE8A7;"
                                                                                                  FontFamily="Segoe Fluent Icons"
                                                                                                  FontSize="12"
                                                                                                  Foreground="#D4A832"
                                                                                                  VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="You also own this on Steam"
                                                                                                   FontSize="11"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                   Foreground="#F3EDC9"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                        </Border>

                                                                        <StackPanel x:Name="FolderSizeSection"
                                                                                    Margin="0,8"
                                                                                    Spacing="1">
                                                                                <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <StackPanel Grid.Column="0"
                                                                                                    Spacing="1">
                                                                                                <TextBlock x:Name="FolderSizeLabel"
                                                                                                           Text="FOLDER SIZE"
                                                                                                           FontSize="11"
                                                                                                           FontWeight="SemiBold"
                                                                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                           Foreground="#D4A832"
                                                                                                           CharacterSpacing="40"/>
                                                                                                <TextBlock x:Name="FolderSizeValue"
                                                                                                           Text="{Binding SelectedGame.FolderSize, Converter={StaticResource BytesToSizeConverter}, FallbackValue='Not Available'}"
                                                                                                           FontWeight="SemiBold"
                                                                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                           Foreground="#F3EDC9"
                                                                                                           FontSize="13"/>
                                                                                        </StackPanel>

                                                                                        <Border Grid.Column="1"
                                                                                                Width="1"
                                                                                                Margin="12,0"
                                                                                                Background="#3E3830"
                                                                                                VerticalAlignment="Stretch"
                                                                                                Visibility="{Binding SelectedGame.ImportedFrom, Converter={StaticResource NullToVisibilityConverter}}"/>

                                                                                        <StackPanel Grid.Column="2"
                                                                                                    Orientation="Horizontal"
                                                                                                    Spacing="5"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Visibility="{Binding SelectedGame.ImportedFrom, Converter={StaticResource NullToVisibilityConverter}}">
                                                                                                <TextBlock Text="via"
                                                                                                           FontSize="12"
                                                                                                           FontFamily="{StaticResource CodecRegularFontFamily}"
                                                                                                           Foreground="#9E8E78"
                                                                                                           VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding SelectedGame.ImportedFromDisplay}"
                                                                                                           FontSize="13"
                                                                                                           FontWeight="SemiBold"
                                                                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                           Foreground="#F3EDC9"
                                                                                                           VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                </Grid>
                                                                        </StackPanel>

                                                                        <Border Height="1"
                                                                                Background="#3E3830"/>

                                                                        <StackPanel x:Name="LaunchScriptSection"
                                                                                    Margin="0,8"
                                                                                    Spacing="6">
                                                                                <StackPanel Spacing="1">
                                                                                        <TextBlock x:Name="LaunchScriptLabel"
                                                                                                   Text="LAUNCH OPTIONS"
                                                                                                   FontSize="11"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                   Foreground="#D4A832"
                                                                                                   CharacterSpacing="40"/>

                                                                                        <TextBlock x:Name="LaunchScriptValue"
                                                                                                   Text="{Binding SelectedGame.LaunchOptionsDisplay, TargetNullValue='No launch target selected', FallbackValue='No launch target selected'}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   MaxLines="2"
                                                                                                   Padding="0"
                                                                                                   Foreground="#F3EDC9"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                   FontSize="12"/>
                                                                                </StackPanel>

                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="8">
                                                                                        <Button Content="Change"
                                                                                                Padding="14,7"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                Background="#25221F"
                                                                                                BorderBrush="#3E3830"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="8"
                                                                                                Foreground="#9E8E78">
                                                                                                <Button.Resources>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                                         Color="#2E2A25"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                                         Color="#342F29"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                                         Color="#5E5346"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                                         Color="#6A5A4A"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                                         Color="#F3EDC9"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                                         Color="#9E8E78"/>
                                                                                                </Button.Resources>
                                                                                                <Button.Flyout>
                                                                                                        <MenuFlyout>
                                                                                                                <MenuFlyoutItem Text="Launch script"
                                                                                                                                Click="ChangeLaunchScriptMenuItem_Click"/>
                                                                                                                <MenuFlyoutItem Text="Executable"
                                                                                                                                Click="ChangeExecutableMenuItem_Click"/>
                                                                                                        </MenuFlyout>
                                                                                                </Button.Flyout>
                                                                                        </Button>

                                                                                        <Button Content="Reset"
                                                                                                Command="{Binding ResetLaunchOptionsCommand}"
                                                                                                Visibility="{Binding SelectedGame.HasCustomLaunchOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                Padding="14,7"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                                                Background="#25221F"
                                                                                                BorderBrush="#3E3830"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="8"
                                                                                                Foreground="#9E8E78">
                                                                                                <Button.Resources>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                                         Color="#2E2A25"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                                         Color="#342F29"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                                         Color="#5E5346"/>
                                                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                                         Color="#6A5A4A"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                                         Color="#F3EDC9"/>
                                                                                                        <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                                         Color="#9E8E78"/>
                                                                                                </Button.Resources>
                                                                                        </Button>
                                                                                </StackPanel>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </Border>
                                                </Grid>

                                                <StackPanel x:Name="DeleteSection"
                                                            Grid.Row="2"
                                                            Spacing="7">
                                                        <TextBlock x:Name="DeleteSectionLabel"
                                                                   Text="LIBRARY"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                   Foreground="#D4A832"
                                                                   CharacterSpacing="40"/>
                                                        <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Content="Open Folder"
                                                                        Grid.Column="0"
                                                                        Command="{Binding OpenGameFolderCommand}"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        Padding="0,9"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                        Background="#25221F"
                                                                        BorderBrush="#3E3830"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Foreground="#9E8E78">
                                                                        <Button.Resources>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                 Color="#2E2A25"/>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                 Color="#342F29"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                 Color="#5E5346"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                 Color="#6A5A4A"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                 Color="#F3EDC9"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                 Color="#9E8E78"/>
                                                                        </Button.Resources>
                                                                </Button>
                                                                <Button x:Name="RemoveGameButton"
                                                                        Content="Remove"
                                                                        Grid.Column="1"
                                                                        Click="RemoveGameButton_Click"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        Padding="0,9"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                                        Background="#26E76C2B"
                                                                        BorderBrush="#55E76C2B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Foreground="#E76C2B">
                                                                        <Button.Resources>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                                 Color="#33E76C2B"/>
                                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                                 Color="#55E76C2B"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                                 Color="#80E76C2B"/>
                                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                                 Color="#A0E76C2B"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                                 Color="#D4A832"/>
                                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                                 Color="#E76C2B"/>
                                                                        </Button.Resources>
                                                                </Button>
                                                        </Grid>
                                                </StackPanel>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>

                <!-- The dashboard overlaps the hero slightly, matching the reference hierarchy. -->
                <Grid x:Name="DetailsLowerGrid"
                      Grid.Row="1"
                      Margin="0,-14,0,0"
                      Padding="20,0,20,18"
                      Canvas.ZIndex="2">
                        <ScrollViewer x:Name="DetailsScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch">
                                <Grid x:Name="DashboardGrid" ColumnSpacing="14" RowSpacing="14">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition x:Name="DetailsRailColumn" Width="300"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="DetailsMetricsCard"
                                                Grid.Row="0"
                                                Grid.ColumnSpan="2"
                                                Background="{StaticResource CodecSurfaceBrush}"
                                                BorderBrush="{StaticResource CodecBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="18,14">
                                                <Grid x:Name="DetailsMetricsGrid" ColumnSpacing="10" RowSpacing="12">
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition x:Name="MetricColumn1" Width="*"/>
                                                                        <ColumnDefinition x:Name="MetricColumn2" Width="*"/>
                                                                        <ColumnDefinition x:Name="MetricColumn3" Width="*"/>
                                                                        <ColumnDefinition x:Name="MetricColumn4" Width="*"/>
                                                                        <ColumnDefinition x:Name="MetricColumn5" Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                        <Grid x:Name="MetricReviews" Grid.Column="0" Padding="4,0,12,0" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE8E1;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{StaticResource CodecAccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Text="Steam reviews" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                        <TextBlock Text="{Binding SelectedGame.DisplaySteamReviewSummary, FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}" Opacity="{Binding SelectedGame.SteamReviewOpacity, FallbackValue=0.6}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding SelectedGame.DisplaySteamReviewCount, FallbackValue=''}" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/>
                                                                </StackPanel>
                                                        </Grid>
                                                        <Grid x:Name="MetricMainStory" Grid.Column="1" Padding="4,0,12,0" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource CodecAccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Main story" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.DisplayMainStory, FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}" Opacity="{Binding SelectedGame.MainStoryOpacity, FallbackValue=0.6}"/><TextBlock Text="HowLongToBeat" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/></StackPanel>
                                                        </Grid>
                                                        <Grid x:Name="MetricCompletionist" Grid.Column="2" Padding="4,0,12,0" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource CodecAccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Completionist" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.DisplayCompletionist, FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}" Opacity="{Binding SelectedGame.CompletionistOpacity, FallbackValue=0.6}"/><TextBlock Text="HowLongToBeat" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/></StackPanel>
                                                        </Grid>
                                                        <Grid x:Name="MetricReleaseDate" Grid.Column="3" Padding="4,0,12,0" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource CodecAccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Release date" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource DateToStringConverter}, FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedGame.OriginalReleaseDisplay, FallbackValue=''}" Visibility="{Binding SelectedGame.HasOriginalReleaseDate, Converter={StaticResource BoolToVisibilityConverter}}" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/></StackPanel>
                                                        </Grid>
                                                        <Grid x:Name="MetricController" Grid.Column="4" Padding="4,0" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource CodecAccentBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Controller" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.ControllerSupportDisplay, Converter={StaticResource NullOrEmptyToFallbackConverter}, ConverterParameter='Not available', FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="{x:Bind DetailsValueFontSize, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="Recommended" FontSize="11" Foreground="{StaticResource CodecSecondaryBrush}" Visibility="{Binding SelectedGame.HasControllerRecommendation, Converter={StaticResource BoolToVisibilityConverter}}"/></StackPanel>
                                                        </Grid>
                                                </Grid>
                                        </Border>

                                        <Border x:Name="DetailsInfoCard" Grid.Row="1" Grid.Column="0" Background="{StaticResource CodecSurfaceBrush}" BorderBrush="{StaticResource CodecBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                                <Grid x:Name="DetailsBodyGrid" ColumnSpacing="24" RowSpacing="18">
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition x:Name="DetailsMetadataColumn" Width="250"/>
                                                                        <ColumnDefinition Width="1"/>
                                                                        <ColumnDefinition x:Name="DetailsDescriptionColumn" Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel x:Name="DetailsMetadataSection" Grid.Column="0" Spacing="13">
                                                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7FB;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource CodecTextMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Developer" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.Developer, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="13" TextWrapping="Wrap"/></StackPanel></Grid>
                                                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE719;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource CodecTextMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Publisher" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.Publisher, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="13" TextWrapping="Wrap"/></StackPanel></Grid>
                                                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource CodecTextMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Age rating" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.DisplayAgeRating, FallbackValue='Not available'}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="13" Opacity="{Binding SelectedGame.AgeRatingOpacity, FallbackValue=0.6}" TextWrapping="Wrap"/></StackPanel></Grid>
                                                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource CodecTextMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Price" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><TextBlock Style="{StaticResource DetailMetaValueTextStyle}" FontSize="13" TextWrapping="Wrap"><Run Text="{Binding SelectedGame.Price, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"/><Run Text="{Binding SelectedGame.PriceDiscount, FallbackValue=''}" FontSize="11" Foreground="{StaticResource CodecSecondaryBrush}"/></TextBlock></StackPanel></Grid>
                                                                </StackPanel>
                                                                <Border x:Name="DetailsMetadataDivider" Grid.Column="1" Width="1" Background="{StaticResource CodecBorderBrush}"/>
                                                                <StackPanel x:Name="DetailsDescriptionSection" Grid.Column="2" Spacing="12">
                                                                        <StackPanel Spacing="3">
                                                                                <TextBlock Text="Description" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                                <TextBlock Text="{Binding SelectedGame.Description, Converter={StaticResource NullOrEmptyToFallbackConverter}, FallbackValue='N/A'}"
                                                                                           Style="{StaticResource DetailMetaValueTextStyle}"
                                                                                           FontSize="13"
                                                                                           TextWrapping="Wrap"
                                                                                           MaxLines="4"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <StackPanel Spacing="8"
                                                                                    Visibility="{Binding SelectedGame.HasAnyIgdbTaxonomy, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <StackPanel Spacing="3"
                                                                                            Visibility="{Binding SelectedGame.HasIgdbGenres, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="Genres" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                                        <ItemsControl ItemsSource="{Binding SelectedGame.Genres}"
                                                                                                      ItemTemplate="{StaticResource DetailTaxonomyChipTemplate}">
                                                                                                <ItemsControl.ItemsPanel>
                                                                                                        <ItemsPanelTemplate>
                                                                                                                <ItemsWrapGrid Orientation="Horizontal"/>
                                                                                                        </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>
                                                                                        </ItemsControl>
                                                                                </StackPanel>
                                                                                <StackPanel Spacing="3"
                                                                                            Visibility="{Binding SelectedGame.HasThemes, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="Themes" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                                        <ItemsControl ItemsSource="{Binding SelectedGame.Themes}"
                                                                                                      ItemTemplate="{StaticResource DetailTaxonomyChipTemplate}">
                                                                                                <ItemsControl.ItemsPanel>
                                                                                                        <ItemsPanelTemplate>
                                                                                                                <ItemsWrapGrid Orientation="Horizontal"/>
                                                                                                        </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>
                                                                                        </ItemsControl>
                                                                                </StackPanel>
                                                                                <StackPanel Spacing="3"
                                                                                            Visibility="{Binding SelectedGame.HasGameModes, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="Game modes" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                                        <ItemsControl ItemsSource="{Binding SelectedGame.GameModes}"
                                                                                                      ItemTemplate="{StaticResource DetailTaxonomyChipTemplate}">
                                                                                                <ItemsControl.ItemsPanel>
                                                                                                        <ItemsPanelTemplate>
                                                                                                                <ItemsWrapGrid Orientation="Horizontal"/>
                                                                                                        </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>
                                                                                        </ItemsControl>
                                                                                </StackPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Spacing="5"
                                                                                    Visibility="{Binding SelectedGame.HasSteamAchievementProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Grid ColumnSpacing="12">
                                                                                        <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="Steam achievements" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedGame.SteamAchievementProgressDisplay}" Style="{StaticResource DetailMetaValueTextStyle}" FontSize="12"/>
                                                                                </Grid>
                                                                                <ProgressBar Minimum="0"
                                                                                             Maximum="{Binding SelectedGame.SteamAchievementsTotal, FallbackValue=1}"
                                                                                             Value="{Binding SelectedGame.SteamAchievementsUnlocked, FallbackValue=0}"
                                                                                             Height="4"
                                                                                             CornerRadius="2"
                                                                                             Foreground="{StaticResource CodecAccentBrush}"
                                                                                             Background="{StaticResource CodecBorderBrush}"/>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                </Grid>
                                        </Border>

                                        <Border x:Name="DetailsRightRail"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Background="{StaticResource CodecSurfaceBrush}"
                                                BorderBrush="{StaticResource CodecBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="18">
                                                <StackPanel Spacing="13">
                                                        <ItemsControl x:Name="DetailsPlatformItemsControl"
                                                                      ItemsSource="{Binding SelectedGame.PlatformLogoUris, Mode=OneWay}"
                                                                      Tag="{x:Bind DetailsPlatformIconHeight, Mode=OneWay}"
                                                                      HorizontalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                                                                        </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <Image Source="{Binding}" Height="{Binding Tag, ElementName=DetailsPlatformItemsControl}" Stretch="Uniform"/>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Style="{StaticResource DetailRailButtonStyle}"
                                                                BorderBrush="{StaticResource CodecPrimaryBrush}"
                                                                Command="{Binding OpenFranchiseOverlayCommand}"
                                                                Visibility="{Binding SelectedGame.FranchiseGames, Converter={StaticResource NullToVisibilityConverter}}">
                                                                <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <FontIcon Glyph="&#xE81E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource CodecAccentBrush}"/>
                                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                                                <TextBlock Text="Franchise" FontFamily="{StaticResource CodecBoldFontFamily}" FontWeight="Bold" FontSize="13"/>
                                                                                <TextBlock Text="Related games" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/>
                                                                        </StackPanel>
                                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/>
                                                                </Grid>
                                                        </Button>

                                                        <Border Background="{StaticResource CodecBackgroundBrush}" BorderBrush="{StaticResource CodecBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Visibility="{Binding SelectedGame.HasMedia, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Spacing="8">
                                                                        <Grid><TextBlock Text="Media" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11"/><Border HorizontalAlignment="Right" Background="{StaticResource CodecSurfaceBrush}" CornerRadius="5" Padding="6,1"><TextBlock Text="{Binding SelectedGame.MediaCount}" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/></Border></Grid>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <ItemsControl ItemsSource="{Binding SelectedGame.MediaPreviewItems}">
                                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <Border Width="52" Height="34" CornerRadius="7" BorderBrush="{StaticResource CodecBorderBrush}" BorderThickness="1" Background="{StaticResource CodecSurfaceBrush}">
                                                                                                                <Grid>
                                                                                                                        <MediaPlayerElement Source="{Binding Converter={StaticResource UriToMediaSourceConverter}}" AutoPlay="False" AreTransportControlsEnabled="False" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}"/>
                                                                                                                        <Image Source="{Binding}" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=image}"/>
                                                                                                                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}"/>
                                                                                                                        <Button Background="#01000000" BorderThickness="0" Command="{Binding DataContext.OpenMediaOverlayCommand, ElementName=RootLayout}" CommandParameter="{Binding}" AutomationProperties.Name="Open media item" ToolTipService.ToolTip="Open media"/>
                                                                                                                </Grid>
                                                                                                        </Border>
                                                                                                </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Button Width="38" Height="34" Padding="0" Background="{StaticResource CodecSurfaceBrush}" BorderBrush="{StaticResource CodecBorderBrush}" BorderThickness="1" CornerRadius="7" Command="{Binding OpenMediaOverlayCommand}" Visibility="{Binding SelectedGame.HasAdditionalMedia, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.Name="Open all media"><TextBlock Text="{Binding SelectedGame.AdditionalMediaDisplay}" FontSize="11" Foreground="{StaticResource CodecTextMutedBrush}"/></Button>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </Border>

                                                        <Border Background="{StaticResource CodecBackgroundBrush}" BorderBrush="{StaticResource CodecBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                                                        <StackPanel x:Name="DetailsLinksPanel" Spacing="0">
                                                                <TextBlock Text="External links" Style="{StaticResource DetailMetaLabelTextStyle}" FontSize="11" Margin="0,0,0,3"/>
                                                                <HyperlinkButton Style="{StaticResource DetailRailLinkStyle}" NavigateUri="{Binding SelectedGame.OfficialWebsiteUrl}" Visibility="{Binding SelectedGame.OfficialWebsiteUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Website"/><FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Grid>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton Style="{StaticResource DetailRailLinkStyle}" NavigateUri="{Binding SelectedGame.SteamPageUrl}" Visibility="{Binding SelectedGame.SteamPageUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Steam"/><FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Grid>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton Style="{StaticResource DetailRailLinkStyle}" NavigateUri="{Binding SelectedGame.RawgUrl}" Visibility="{Binding SelectedGame.RawgUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RAWG"/><FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Grid>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton Style="{StaticResource DetailRailLinkStyle}" NavigateUri="{Binding SelectedGame.IgdbUrl}" Visibility="{Binding SelectedGame.IgdbUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="IGDB"/><FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Grid>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton Style="{StaticResource DetailRailLinkStyle}" NavigateUri="{Binding SelectedGame.HltbUrl}" Visibility="{Binding SelectedGame.HltbUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="HowLongToBeat"/><FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Grid>
                                                                </HyperlinkButton>
                                                        </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </Border>
                                </Grid>
                        </ScrollViewer>
                </Grid>

                <Canvas x:Name="SettingsPopoverLayer"
                        Grid.RowSpan="2"
                        Visibility="{Binding IsGameSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsHitTestVisible="True"
                        Canvas.ZIndex="10">
                        <Border x:Name="RemoveGameConfirmationPopover"
                                Width="240"
                                Visibility="Collapsed"
                                Background="#1C1A17"
                                BorderBrush="#5E5346"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                                <StackPanel Spacing="10">
                                        <StackPanel Spacing="2">
                                                <TextBlock Text="Are you sure?"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                           Foreground="#F3EDC9"/>
                                                <TextBlock Text="This removes the game from your library. Files stay on disk."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                           Foreground="#9E8E78"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="No"
                                                        Grid.Column="0"
                                                        Click="CancelDeleteSelectedGameButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Padding="0,7"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                        Background="#25221F"
                                                        BorderBrush="#3E3830"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Foreground="#9E8E78">
                                                        <Button.Resources>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                 Color="#2E2A25"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                 Color="#342F29"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                 Color="#5E5346"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                 Color="#6A5A4A"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                 Color="#F3EDC9"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                 Color="#9E8E78"/>
                                                        </Button.Resources>
                                                </Button>
                                                <Button Content="Yes"
                                                        Grid.Column="1"
                                                        Click="ConfirmDeleteSelectedGameButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Padding="0,7"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                        Background="#26E76C2B"
                                                        BorderBrush="#55E76C2B"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Foreground="#E76C2B">
                                                        <Button.Resources>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                                 Color="#33E76C2B"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                                 Color="#55E76C2B"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                                                 Color="#80E76C2B"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                                                 Color="#A0E76C2B"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                                                 Color="#D4A832"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                                                 Color="#E76C2B"/>
                                                        </Button.Resources>
                                                </Button>
                                        </Grid>
                                </StackPanel>
                        </Border>
                </Canvas>
        </Grid>

</UserControl>
