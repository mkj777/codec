<Window
    x:Class="Codec.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Codec.Models"
    xmlns:conv="using:Codec.Helpers"
    xmlns:views="using:Codec.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          MinWidth="420"
          MinHeight="520">
        <Grid.Resources>
            <x:Double x:Key="SidebarSearchRowHeight">40</x:Double>
            <x:Double x:Key="SidebarGameRowHeight">32</x:Double>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter"/>
            <conv:UriToMediaSourceConverter x:Key="UriToMediaSourceConverter"/>
            <conv:IntEqualsToBoolConverter x:Key="IntEqualsToBoolConverter"/>
            <Style x:Key="FranchiseFilterRadioButtonStyle"
                   TargetType="RadioButton">
                <Setter Property="Padding"
                        Value="12,5"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="FontFamily"
                        Value="{StaticResource CodecSemiBoldFontFamily}"/>
                <Setter Property="Foreground"
                        Value="#F3EDC9"/>
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderBrush"
                        Value="#60E76C2B"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  Content="{TemplateBinding Content}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="#33E76C2B"/>
                                                <Setter Target="Root.BorderBrush"
                                                        Value="#E76C2B"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Softer default blur overlay -->
            <AcrylicBrush x:Key="BlurOverlayBrush"
                          TintColor="#661C1A17"
                          TintOpacity="0.25"
                          TintLuminosityOpacity="0.8"
                          FallbackColor="#661C1A17"/>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="FontFamily"
                        Value="{StaticResource CodecSemiBoldFontFamily}"/>
                <Setter Property="Foreground"
                        Value="#F3EDC9"/>
            </Style>
            <Style x:Key="SidebarSettingsButtonStyle"
                   TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Background" Value="#29251F"/>
                <Setter Property="BorderBrush" Value="#3E3830"/>
                <Setter Property="BorderThickness" Value="0,1,1,0"/>
                <Setter Property="CornerRadius" Value="0,10,0,0"/>
                <Setter Property="Foreground" Value="#9E8E78"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{StaticResource CodecSemiBoldFontFamily}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SidebarDrawerButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Foreground" Value="#9E8E78"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="DrawerIconPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Opacity="0.72"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="DrawerIconPresenter.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="DrawerIconPresenter.Opacity" Value="0.48"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarActionButtonStyle"
                   TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Background" Value="#D525221F"/>
                <Setter Property="BorderBrush" Value="#703E3830"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Foreground" Value="#F3EDC9"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{StaticResource CodecSemiBoldFontFamily}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="AppTitleBar"
              Height="48"
              Visibility="Collapsed"/>

        <!-- Main content with sidebar and library/details area -->
        <Grid Grid.Row="1">
            <Grid x:Name="MainContentGrid" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="#1C1A17"
                        BorderBrush="#3E3830"
                        BorderThickness="1.5"
                        CornerRadius="5,24,0,5"
                        Canvas.ZIndex="3">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SidebarTranslateTransform"/>
                    </Border.RenderTransform>
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="12,8,8,8">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Click="LibraryTitle_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackground"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"
                                                 Color="Transparent"/>
                            </Button.Resources>
                                <TextBlock Text="Codec"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           FontFamily="{StaticResource CodecBoldFontFamily}"
                                           Foreground="#F3EDC9"/>
                            </Button>
                            <Button x:Name="SidebarCloseButton"
                                    Style="{StaticResource SidebarDrawerButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTipService.ToolTip="Close sidebar"
                                    AutomationProperties.Name="Close sidebar">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="18" Height="18">
                                        <Path Data="M4,3.5 L14,3.5 Q15.5,3.5 15.5,5 L15.5,13 Q15.5,14.5 14,14.5 L4,14.5 Q2.5,14.5 2.5,13 L2.5,5 Q2.5,3.5 4,3.5 Z M7,3.5 L7,14.5"
                                              Stroke="{Binding Foreground, ElementName=SidebarCloseButton}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1"
                              Height="28"
                              Margin="10,0,10,4">
                             <TextBox x:Name="SidebarSearchTextBox"
                                     Margin="0"
                                     Height="26"
                                     MinHeight="0"
                                     Padding="30,3,10,3"
                                     Background="#25221F"
                                     BorderThickness="1"
                                     BorderBrush="#3E3830"
                                     CornerRadius="8"
                                     Foreground="#F3EDC9"
                                     PlaceholderForeground="#9E8E78"
                                     HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="Search"
                                     IsEnabled="{Binding IsUiEnabled}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground">#25221F</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#2E2A25</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#2E2A25</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled">#25221F</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlForeground">#F3EDC9</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused">#F3EDC9</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#F3EDC9</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground">#9E8E78</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#9E8E78</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#9E8E78</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBorderBrush">#3E3830</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#E76C2B</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#5E5346</SolidColorBrush>
                                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled">#2E2A25</SolidColorBrush>
                                    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <FontIcon Margin="11,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="#9E8E78"
                                      Glyph="&#xE721;"
                                      IsHitTestVisible="False"/>
                        </Grid>

                        <ListView x:Name="SidebarGameList"
                                  Grid.Row="2"
                                  ItemsSource="{Binding SidebarFilteredGames}"
                                  SelectedItem="{Binding SidebarSelectedItem, Mode=TwoWay}"
                                  IsEnabled="{Binding IsUiEnabled}"
                                  SelectionMode="Single"
                                  SelectionChanged="SidebarGameList_SelectionChanged"
                                  ContainerContentChanging="SidebarGameList_ContainerContentChanging"
                                  BorderThickness="0"
                                  Background="Transparent">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#15E76C2B"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#25E76C2B"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#30E76C2B"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#40E76C2B"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#F3EDC9"/>
                            </ListView.Resources>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection/>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Height"
                                            Value="{StaticResource SidebarGameRowHeight}"/>
                                    <Setter Property="MinHeight"
                                            Value="0"/>
                                    <Setter Property="Padding"
                                            Value="17,0,17,0"/>
                                    <Setter Property="Margin"
                                            Value="-4,-2,-4,-2"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                             <ListView.ItemTemplate>
                                 <DataTemplate x:DataType="local:Game">
                                     <Grid Opacity="{x:Bind SidebarOpacity, Mode=OneWay}">
                                         <TextBlock Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"/>
                                     </Grid>
                                 </DataTemplate>
                             </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="3"
                              BorderBrush="#3E3830"
                              BorderThickness="0,1,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,8,8,-12" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="SidebarAddExecutableButton"
                                        Style="{StaticResource SidebarActionButtonStyle}"
                                        Background="#E76C2B"
                                        BorderBrush="#E76C2B"
                                        Foreground="#1C1A17"
                                        IsEnabled="{Binding IsUiEnabled}"
                                        Click="SidebarAddExecutableButton_Click"
                                        ToolTipService.ToolTip="Add by executable">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F87D3C"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D65C1A"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F87D3C"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D65C1A"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1C1A17"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1C1A17"/>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE710;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11"
                                                  Foreground="{Binding Foreground, ElementName=SidebarScanButton}"/>
                                        <TextBlock Text="Add"
                                                   Foreground="{Binding Foreground, ElementName=SidebarScanButton}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        x:Name="SidebarScanButton"
                                        Style="{StaticResource SidebarActionButtonStyle}"
                                        IsEnabled="{Binding CanStartScan}"
                                        Click="SidebarScanButton_Click"
                                        ToolTipService.ToolTip="Scan for games">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EA3E3830"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE76C2B"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B0E76C2B"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFE76C2B"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3EDC9"/>
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1C1A17"/>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE721;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11"/>
                                        <TextBlock Text="Scan"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Mascot stays above the edge-mounted settings control. -->
                            <Grid Grid.Row="1"
                                  Height="150"
                                  VerticalAlignment="Bottom">
                                <Image Source="ms-appx:///Assets/shrimpSleep.png"
                                       Stretch="Uniform"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,-14"/>
                            </Grid>

                            <Button Grid.Row="2"
                                    x:Name="SidebarSettingsButton"
                                    Style="{StaticResource SidebarSettingsButtonStyle}"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{Binding IsUiEnabled}"
                                    Click="SidebarSettingsButton_Click"
                                    ToolTipService.ToolTip="Settings">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#332E27"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3E3830"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3E3830"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5E5346"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3EDC9"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F3EDC9"/>
                                </Button.Resources>
                                <TextBlock Text="Settings"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Library grid UserControl -->
                <views:LibraryView Grid.Column="1"
                                   Margin="22,32,22,0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Visibility="{Binding IsLibraryGridVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Canvas.ZIndex="0"/>

                <!-- Game detail UserControl -->
                <views:GameDetailView x:Name="GameDetailHost"
                                      Grid.Column="1"
                                      Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Canvas.ZIndex="1"/>

            </Grid>
        </Grid>

        <!-- Global app-level overlays -->
        <Grid Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="True">
            <!-- Admin warning toast -->
            <Border x:Name="AdminWarningToast"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,32,32,0"
                    Background="#1C1A17"
                    BorderBrush="#D4A832"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7BA;"
                              FontSize="16"
                              Foreground="#D4A832"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                MaxWidth="260">
                        <TextBlock Text="Running as Administrator"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D4A832"/>
                        <TextBlock Text="Some features may not work correctly."
                                   FontSize="12"
                                   Foreground="#D4A832"
                                   TextWrapping="Wrap"
                                   Opacity="0.8"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#D4A832"
                            FontSize="12"
                            Padding="4,0"
                            VerticalAlignment="Top"
                            Click="AdminWarningClose_Click"/>
                </Grid>
            </Border>



            <StackPanel Visibility="{Binding IsScanProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#D51C1A17"
                        Padding="24"
                        CornerRadius="8"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ScanProgressMessage}"
                           Foreground="#F3EDC9"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                <ProgressBar Width="320"
                             Height="8"
                             IsIndeterminate="{Binding ScanProgressIsIndeterminate}"
                             Minimum="{Binding ScanProgressMinimum}"
                             Maximum="{Binding ScanProgressMaximum}"
                             Value="{Binding ScanProgressValue}"/>
            </StackPanel>

            <ProgressRing IsActive="{Binding IsAppSpinnerActive}"
                          Visibility="{Binding IsAppSpinnerActive, Converter={StaticResource BoolToVisibilityConverter}}"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <Grid x:Name="MediaOverlay"
                  Visibility="{Binding IsMediaOverlayOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid Background="#E61C1A17"
                      Tapped="MediaScrim_Tapped"/>

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="64">
                    <Grid MaxWidth="1200"
                          MaxHeight="800"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Button Content="✕"
                                Command="{Binding CloseMediaOverlayCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="24"
                                FontWeight="Bold"
                                FontFamily="{StaticResource CodecBoldFontFamily}"
                                Margin="0,-48,0,0"
                                Foreground="#F3EDC9"/>

                        <FlipView x:Name="MediaOverlayFlipView"
                                  ItemsSource="{Binding SelectedGame.Media}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent">
                            <FlipView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <MediaPlayerElement AreTransportControlsEnabled="True"
                                                            Source="{Binding Converter={StaticResource UriToMediaSourceConverter}}"
                                                            AutoPlay="False"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}"/>
                                        <Image Source="{Binding}"
                                               Stretch="Uniform"
                                               Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=image}"/>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Franchise Timeline Overlay -->
            <Grid x:Name="FranchiseOverlay"
                  Visibility="{Binding IsFranchiseOverlayOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid Background="#E61C1A17"
                      Tapped="FranchiseScrim_Tapped"/>
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="48,72,48,48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <RadioButton Content="{Binding FranchiseMainlineLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=0, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                            <RadioButton Content="{Binding FranchiseExtendedLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                            <RadioButton Content="{Binding FranchiseAllLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                        </StackPanel>
                        <Button Content="✕"
                                Command="{Binding CloseFranchiseOverlayCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="24"
                                FontWeight="Bold"
                                FontFamily="{StaticResource CodecBoldFontFamily}"
                                Foreground="#F3EDC9"/>
                    </Grid>

                    <!-- Timeline fills remaining vertical space -->
                    <views:FranchiseTimelineControl Grid.Row="1"
                                                    Items="{Binding FranchiseTimelineItems}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>

        </Grid>

        <!-- Warm one-choice onboarding: no setup form, only ways into library. -->
        <Grid x:Name="OnboardingOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#FF1C1A17"
              IsHitTestVisible="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="OnboardingLayoutStates">
                    <VisualState x:Name="OnboardingCompact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="OnboardingContentGrid.MaxWidth" Value="520"/>
                            <Setter Target="OnboardingContentGrid.Margin" Value="28"/>
                            <Setter Target="OnboardingMascot.(Grid.Row)" Value="0"/>
                            <Setter Target="OnboardingMascot.(Grid.Column)" Value="0"/>
                            <Setter Target="OnboardingMascot.(Grid.ColumnSpan)" Value="3"/>
                            <Setter Target="OnboardingMascot.Width" Value="220"/>
                            <Setter Target="OnboardingMascot.Height" Value="235"/>
                            <Setter Target="OnboardingMascot.HorizontalAlignment" Value="Center"/>
                            <Setter Target="OnboardingCopy.(Grid.Row)" Value="1"/>
                            <Setter Target="OnboardingCopy.(Grid.Column)" Value="0"/>
                            <Setter Target="OnboardingCopy.(Grid.ColumnSpan)" Value="3"/>
                            <Setter Target="OnboardingCopy.HorizontalAlignment" Value="Center"/>
                            <Setter Target="OnboardingActions.Orientation" Value="Vertical"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="OnboardingWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="780"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="OnboardingContentGrid.MaxWidth" Value="940"/>
                            <Setter Target="OnboardingContentGrid.Margin" Value="42"/>
                            <Setter Target="OnboardingMascot.(Grid.Row)" Value="0"/>
                            <Setter Target="OnboardingMascot.(Grid.Column)" Value="0"/>
                            <Setter Target="OnboardingMascot.(Grid.ColumnSpan)" Value="1"/>
                            <Setter Target="OnboardingMascot.Width" Value="310"/>
                            <Setter Target="OnboardingMascot.Height" Value="330"/>
                            <Setter Target="OnboardingCopy.(Grid.Row)" Value="0"/>
                            <Setter Target="OnboardingCopy.(Grid.Column)" Value="2"/>
                            <Setter Target="OnboardingCopy.(Grid.ColumnSpan)" Value="1"/>
                            <Setter Target="OnboardingActions.Orientation" Value="Horizontal"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="OnboardingContentGrid"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="940"
                  Margin="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="OnboardingMascot"
                      Grid.Column="0"
                      Width="310"
                      Height="330"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform/>
                    </Grid.RenderTransform>
                    <Border Width="112"
                            Height="158"
                            Margin="0,12,18,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#C4956A"
                            CornerRadius="9"
                            Opacity="0.45">
                        <Border.RenderTransform>
                            <CompositeTransform Rotation="9"/>
                        </Border.RenderTransform>
                    </Border>
                    <Border Width="112"
                            Height="158"
                            Margin="0,25,44,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#D4A832"
                            CornerRadius="9"
                            Opacity="0.55">
                        <Border.RenderTransform>
                            <CompositeTransform Rotation="2"/>
                        </Border.RenderTransform>
                    </Border>
                    <Image Source="ms-appx:///Assets/shrimpStand.png"
                           Height="285"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"/>
                </Grid>

                <StackPanel x:Name="OnboardingCopy"
                            Grid.Column="2"
                            Spacing="10"
                            VerticalAlignment="Center"
                            MaxWidth="500"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <CompositeTransform/>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Let’s find your games."
                               FontSize="38"
                               FontWeight="Bold"
                               FontFamily="{StaticResource CodecBoldFontFamily}"
                               Foreground="#F3EDC9"/>
                    <TextBlock Text="I can look for them, or you can add one yourself."
                               FontSize="17"
                               TextWrapping="WrapWholeWords"
                               FontFamily="{StaticResource CodecRegularFontFamily}"
                               Foreground="#9E8E78"/>
                    <StackPanel x:Name="OnboardingActions"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="0,18,0,0">
                        <Button Content="Find my games"
                                FontWeight="SemiBold"
                                Background="#E76C2B"
                                BorderBrush="#E76C2B"
                                Foreground="#1C1A17"
                                CornerRadius="10"
                                Padding="22,11"
                                Command="{Binding FindGamesFromOnboardingCommand}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F5803F"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F5803F"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1C1A17"/>
                            </Button.Resources>
                        </Button>
                        <Button Content="Add a game"
                                FontWeight="SemiBold"
                                Background="#25221F"
                                BorderBrush="#3E3830"
                                Foreground="#F3EDC9"
                                CornerRadius="10"
                                Padding="22,11"
                                Click="OnboardingAddGame_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#332E27"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5E5346"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3EDC9"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <Button Content="Maybe later"
                            Command="{Binding MaybeLaterFromOnboardingCommand}"
                            HorizontalAlignment="Left"
                            Margin="-12,2,0,0"
                            Padding="12,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#9E8E78">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3EDC9"/>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True">
            <Grid Background="#CC1C1A17"
                  Tapped="SettingsScrim_Tapped"/>
            <Border Background="#1C1A17"
                    CornerRadius="14"
                    Padding="22"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer MaxHeight="680"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Padding="0,0,8,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="#9E8E78"/>
                            <TextBlock Text="Settings"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                       Foreground="#F3EDC9"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                Padding="7,4,6,4"
                                Foreground="#9E8E78"
                                Click="SettingsClose_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="#22E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="#33E76C2B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                 Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                 Color="#9E8E78"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="7">
                        <TextBlock Text="STARTUP"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                   Foreground="#D4A832"
                                   CharacterSpacing="40"/>

                        <Border Background="#25221F"
                                BorderBrush="#3E3830"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,2">
                            <StackPanel Spacing="0">
                                <Grid ColumnSpacing="10"
                                      Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Scan for games"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                   Foreground="#F3EDC9"/>
                                        <TextBlock Text="On Startup: Run Library scan"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                   Foreground="#9E8E78"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{Binding ScanOnStartup, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  VerticalAlignment="Center"
                                                  MinWidth="56"/>
                                </Grid>

                                <Border Height="1"
                                        Background="#3E3830"/>

                                <Grid ColumnSpacing="10"
                                      Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Launch Steam"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                   Foreground="#F3EDC9"/>
                                        <TextBlock Text="On Startup: Start Steam silently"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                   Foreground="#9E8E78"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{Binding LaunchSteamSilent, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  VerticalAlignment="Center"
                                                  MinWidth="56"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="STEAM LIBRARY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                   Foreground="#D4A832"
                                   CharacterSpacing="40"/>
                        <Border Background="#25221F"
                                BorderBrush="#3E3830"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#22D4A832">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="#D4A832"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SteamAccountDisplay}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                                   Foreground="#F3EDC9"/>
                                        <TextBlock Text="{Binding SteamLastSyncText}"
                                                   FontSize="11" Foreground="#9E8E78"/>
                                    </StackPanel>
                                </Grid>

                                <Border Width="210"
                                        Height="210"
                                        CornerRadius="18"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsSteamQrVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding SteamQrCode}"
                                           Stretch="UniformToFill"
                                           AutomationProperties.Name="Steam sign-in QR code"/>
                                </Border>
                                <Button Content="Cancel sign-in"
                                        Command="{Binding CancelSteamSignInCommand}"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="#9E8E78"
                                        Visibility="{Binding IsSteamQrVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="{Binding SteamStatusMessage}"
                                           FontSize="11.5" Foreground="#9E8E78"
                                           TextWrapping="WrapWholeWords"/>

                                <ProgressBar IsIndeterminate="True"
                                             Height="3"
                                             Foreground="#E76C2B"
                                             Visibility="{Binding IsSteamSyncing, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Connect Steam"
                                            Command="{Binding ConnectSteamCommand}"
                                            IsEnabled="{Binding IsSteamSyncing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"
                                            Visibility="{Binding IsSteamConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="14,9"
                                            Background="#E76C2B" BorderBrush="#E76C2B"
                                            Foreground="#1C1A17" CornerRadius="7"/>
                                    <Button Content="Sync now"
                                            Command="{Binding SyncSteamLibraryCommand}"
                                            IsEnabled="{Binding IsSteamSyncing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"
                                            Visibility="{Binding IsSteamConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                            HorizontalAlignment="Stretch"
                                            Padding="14,9"
                                            Background="#E76C2B" BorderBrush="#E76C2B"
                                            Foreground="#1C1A17" CornerRadius="7"/>
                                    <Button Grid.Column="1"
                                            Content="Disconnect"
                                            Click="SteamDisconnect_Click"
                                            Visibility="{Binding IsSteamConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Padding="12,9"
                                            Background="Transparent" BorderBrush="#5E5346"
                                            Foreground="#9E8E78" CornerRadius="7"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="MAINTENANCE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                   Foreground="#D4A832"
                                   CharacterSpacing="40"/>

                        <Button Content="Reset Codec"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,9"
                                FontSize="13"
                                FontWeight="SemiBold"
                                FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                Background="#26E76C2B"
                                BorderBrush="#55E76C2B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="#E76C2B"
                                Click="ResetApp_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#55E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#80E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A0E76C2B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#D4A832"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E76C2B"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="ABOUT"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                   Foreground="#D4A832"
                                   CharacterSpacing="40"/>

                        <Grid ColumnSpacing="10"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Version"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind AppVersion}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="SidebarDebugButton"
                            Content="Debug"
                            IsEnabled="{Binding IsUiEnabled}"
                            Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,9"
                            FontSize="13"
                            FontWeight="SemiBold"
                            FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                            Background="#25221F"
                            BorderBrush="#3E3830"
                            BorderThickness="1"
                            CornerRadius="8"
                            Foreground="#9E8E78">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                             Color="#2E2A25"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                             Color="#342F29"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                             Color="#5E5346"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                             Color="#6A5A4A"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                             Color="#F3EDC9"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"
                                             Color="#9E8E78"/>
                        </Button.Resources>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Debug Data"
                                                Click="Debug_Click"/>
                                <MenuFlyoutItem Text="Refresh Covers"
                                                Click="RefreshCovers_Click"/>
                                <MenuFlyoutItem Text="Check IDs"
                                                Click="DebugCheckIds_Click"/>
                                <MenuFlyoutItem Text="Start Steam Silent"
                                                Click="DebugLaunchSteamSilent_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Reset confirmation overlay -->
        <Grid x:Name="ResetConfirmOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsResetConfirmVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True">
            <Grid Background="#CC1C1A17"
                  Tapped="ResetScrim_Tapped"/>
            <Border Background="#1C1A17"
                    CornerRadius="14"
                    Padding="28"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20">

                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,0">
                            <Border BorderBrush="#60E76C2B"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="0">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="#E76C2B"/>
                            </Border>
                            <TextBlock Text="Full reset"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource CodecBoldFontFamily}"
                                       Foreground="#F3EDC9"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Padding="7,2,6,4"
                                Foreground="#9E8E78"
                                Click="ResetCancel_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="#22E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="#33E76C2B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                 Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                 Color="#9E8E78"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Codec will close immediately."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#F3EDC9"
                                   TextWrapping="Wrap"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="THIS WILL DELETE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#D4A832"
                                       CharacterSpacing="100"/>
                            <TextBlock Text="Library · Artwork · Caches · Logs · Settings · Steam sign-in"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#9E8E78"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="THIS WONT DELETE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#D4A832"
                                       CharacterSpacing="100"/>
                            <TextBlock Text="Installed games · Save files · Launcher data"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#9E8E78"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel -->
                        <Button Grid.Column="0"
                                Content="Cancel"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,11"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="#25221F"
                                BorderBrush="#3E3830"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="#9E8E78"
                                Click="ResetCancel_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="#2E2A25"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="#342F29"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="#5E5346"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="#6A5A4A"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                 Color="#F3EDC9"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                 Color="#9E8E78"/>
                            </Button.Resources>
                        </Button>

                        <!-- Delete -->
                        <Button Grid.Column="1"
                                Content="Reset"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,11"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="#26E76C2B"
                                BorderBrush="#55E76C2B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="#E76C2B"
                                Click="ResetConfirm_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="#33E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="#55E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="#80E76C2B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="#A0E76C2B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                                 Color="#D4A832"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                                 Color="#E76C2B"/>
                            </Button.Resources>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Full reset progress -->
        <Grid x:Name="ResetProgressOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Background="#F51C1A17"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing Width="34"
                              Height="34"
                              IsActive="True"
                              Foreground="#E76C2B"
                              HorizontalAlignment="Center"/>
                <TextBlock Text="Your data is being deleted"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="{StaticResource CodecBoldFontFamily}"
                           Foreground="#F3EDC9"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Codec will restart with a clean slate."
                           FontSize="12"
                           FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                           Foreground="#9E8E78"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Startup cover mosaic. Library loads behind it; only cached covers are used. -->
        <Border x:Name="StartupOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="#FF1C1A17"
                IsHitTestVisible="True">
            <Border.RenderTransform>
                <CompositeTransform/>
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="StartupMosaic"
                      Width="390"
                      Height="390"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="StartupMosaicTransform"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StartupTile0" Grid.Row="0" Grid.Column="0" Margin="5" CornerRadius="12" Background="#E76C2B" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[0].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile1" Grid.Row="0" Grid.Column="1" Margin="5" CornerRadius="12" Background="#D4A832" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[1].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile2" Grid.Row="0" Grid.Column="2" Margin="5" CornerRadius="12" Background="#C4956A" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[2].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile3" Grid.Row="1" Grid.Column="0" Margin="5" CornerRadius="12" Background="#D4A832" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[3].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile4" Grid.Row="1" Grid.Column="1" Margin="5" CornerRadius="12" Background="#25221F" BorderBrush="#5AE76C2B" BorderThickness="1" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[4].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile5" Grid.Row="1" Grid.Column="2" Margin="5" CornerRadius="12" Background="#E76C2B" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[5].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile6" Grid.Row="2" Grid.Column="0" Margin="5" CornerRadius="12" Background="#C4956A" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[6].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile7" Grid.Row="2" Grid.Column="1" Margin="5" CornerRadius="12" Background="#E76C2B" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[7].LibraryCapsule}" Stretch="UniformToFill"/></Border>
                    <Border x:Name="StartupTile8" Grid.Row="2" Grid.Column="2" Margin="5" CornerRadius="12" Background="#D4A832" Opacity="0"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform><Image Source="{Binding StartupCoverGames[8].LibraryCapsule}" Stretch="UniformToFill"/></Border>

                    <Rectangle x:Name="StartupScanLine"
                               Grid.RowSpan="3"
                               Grid.ColumnSpan="3"
                               Height="2"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               Fill="#E76C2B"
                               Opacity="0">
                        <Rectangle.RenderTransform>
                            <CompositeTransform x:Name="StartupScanTransform" TranslateY="-170"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <StackPanel x:Name="StartupBrand"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Opacity="0">
                    <Image Source="ms-appx:///Assets/iconHigh.png"
                           Width="68"
                           Height="68"
                           Stretch="Uniform"/>
                    <TextBlock Text="CODEC"
                               FontFamily="{StaticResource CodecBoldFontFamily}"
                               FontSize="18"
                               CharacterSpacing="300"
                               Foreground="#F3EDC9"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Unified Notification Stack ===== -->
        <StackPanel x:Name="NotificationStack"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Spacing="10"
                    IsHitTestVisible="True">

            <!-- Update: downloading toast -->
            <Border Visibility="{Binding IsUpdateDownloadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE896;"
                              FontSize="20"
                              Foreground="#D4A832"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <TextBlock Text="Downloading update"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F3EDC9"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                            <TextBlock Text="{Binding UpdateDownloadProgress}"
                                       FontSize="13"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                            <TextBlock Text="%"
                                       FontSize="13"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding UpdateDownloadProgress}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="4"
                                     HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update: error toast -->
            <Border Visibility="{Binding IsUpdateErrorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE783;"
                              FontSize="20"
                              Foreground="#E76C2B"
                              VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Update failed"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E76C2B"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                        <TextBlock Text="{Binding UpdateErrorMessage}"
                                   FontSize="11"
                                   Foreground="#9E8E78"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update: ready banner -->
            <Border Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE777;"
                              FontSize="20"
                              Foreground="#D4A832"
                              VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Update available"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#9E8E78"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                        <TextBlock Text="Downloaded and ready to install"
                                   FontSize="11"
                                   Foreground="#F3EDC9"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2"
                            Content="Restart"
                            VerticalAlignment="Center"
                            Click="RestartToUpdate_Click"
                            Background="#E76C2B"
                            Foreground="#1C1A17"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Padding="10,5"
                            CornerRadius="6"/>
                </Grid>
            </Border>

            <!-- Steam sync status card -->
            <Border Visibility="{Binding IsSteamSyncProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="340">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="24"
                          Height="24"
                          VerticalAlignment="Center">
                        <ProgressRing IsActive="{Binding IsSteamSyncProgressIndeterminate, Mode=OneWay}"
                                      Width="22"
                                      Height="22"
                                      Visibility="{Binding IsSteamSyncProgressIndeterminate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xE895;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="18"
                                  Foreground="#D4A832"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsSteamSyncProgressIndeterminate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SteamSyncProgressTitle, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F3EDC9"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                        <TextBlock Text="{Binding SteamSyncProgressMessage, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="#9E8E78"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                        <ProgressBar Value="{Binding SteamSyncProgressValue, Mode=OneWay}"
                                     Maximum="{Binding SteamSyncProgressMaximum, Mode=OneWay}"
                                     Minimum="0"
                                     Height="3"
                                     HorizontalAlignment="Stretch"
                                     Visibility="{Binding IsSteamSyncProgressIndeterminate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Import status card -->
            <Border Visibility="{Binding IsImportStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ProgressRing Grid.Column="0"
                                  IsActive="{Binding IsImportStatusVisible, Mode=OneWay}"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding AddedCount, Mode=OneWay}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F3EDC9"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodecBoldFontFamily}"/>
                            <TextBlock Text="added"
                                       FontSize="12"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ImportRemainingCount, Mode=OneWay}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodecBoldFontFamily}"/>
                            <TextBlock Text="processing"
                                       FontSize="12"
                                       Foreground="#9E8E78"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan complete card -->
            <Border Visibility="{Binding IsScanCompleteEffectiveVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE73E;"
                              FontSize="20"
                              Foreground="#D4A832"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScanCompleteAddedCount, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#F3EDC9"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CodecBoldFontFamily}"/>
                        <TextBlock Text="games added"
                                   FontSize="12"
                                   Foreground="#9E8E78"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Game not added toast -->
            <Border Visibility="{Binding IsGameNotAddedToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE783;"
                              FontSize="20"
                              Foreground="#E76C2B"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Game could not be added"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F3EDC9"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                </Grid>
            </Border>

            <!-- Game already in library toast -->
            <Border Visibility="{Binding IsGameAlreadyAddedToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE8F1;"
                              FontSize="20"
                              Foreground="#C4956A"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Game already in library"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F3EDC9"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                </Grid>
            </Border>

            <!-- Startup background scan toast -->
            <Border Visibility="{Binding IsStartupScanToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#25221F"
                    BorderBrush="#3E3830"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ProgressRing Grid.Column="0"
                                  IsActive="True"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Looking for new games"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F3EDC9"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Loading overlay for initial load or scanning -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsLoadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#FF1C1A17"
              IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,32,0">
                <Image Source="ms-appx:///Assets/shrimpRun.png"
                       Height="320"
                       Stretch="Uniform"/>
                <StackPanel Spacing="4"
                            VerticalAlignment="Center"
                            MaxWidth="460">
                    <TextBlock Text="{Binding LoadingTitle}"
                               FontSize="28"
                               TextWrapping="WrapWholeWords"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"/>
                    <TextBlock Text="{Binding LoadingSubtitle}"
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                               Foreground="#9E8E78"/>
                    <ProgressBar Width="445"
                                 Height="8"
                                 CornerRadius="16"
                                 IsIndeterminate="True"
                                 Foreground="#E76C2B"
                                 Background="#25221F"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
