<Window
    x:Class="Codec.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Codec.Models"
    xmlns:conv="using:Codec.Helpers"
    xmlns:views="using:Codec.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          MinWidth="420"
          MinHeight="520">
        <Grid.Resources>
            <x:Double x:Key="SidebarGameRowHeight">40</x:Double>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter"/>
            <conv:UriToMediaSourceConverter x:Key="UriToMediaSourceConverter"/>
            <conv:IntEqualsToBoolConverter x:Key="IntEqualsToBoolConverter"/>
            <Style x:Key="FranchiseFilterRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  Content="{TemplateBinding Content}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#66FFFFFF"/>
                                                <Setter Target="Root.BorderBrush" Value="#AAFFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Softer default blur overlay -->
            <AcrylicBrush x:Key="BlurOverlayBrush"
                          TintColor="#66000000"
                          TintOpacity="0.25"
                          TintLuminosityOpacity="0.8"
                          FallbackColor="#66000000"/>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="ShakeTransform"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="AppTitleBar"
              Height="48"
              Visibility="Collapsed"/>

        <!-- Main content with sidebar and library/details area -->
        <Grid Grid.Row="1">
            <Grid ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="#191919"
                        CornerRadius="8,20,20,8"
                        Canvas.ZIndex="3">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,12,0,8"
                                HorizontalAlignment="Center"
                                Click="LibraryTitle_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackground"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"
                                                 Color="Transparent"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                <TextBlock Text="Codec"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind AppVersion}"
                                           FontSize="11"
                                           Foreground="#888888"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,2"/>
                            </StackPanel>
                        </Button>
                        <TextBox Grid.Row="1"
                                 Margin="0,0,0,0"
                                 Height="{StaticResource SidebarGameRowHeight}"
                                 Padding="14,10,10,10"
                                 Background="#222222"
                                 BorderThickness="0"
                                 BorderBrush="Transparent"
                                 CornerRadius="0"
                                 Foreground="White"
                                 PlaceholderForeground="#FF9A9A9A"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="Search games"
                                 IsEnabled="{Binding IsUiEnabled}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground">#222222</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused">#222222</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#222222</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled">#222222</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForeground">White</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundFocused">White</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver">White</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground">#FF9A9A9A</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#FF9A9A9A</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#FF9A9A9A</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBorderBrush">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled">Transparent</SolidColorBrush>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <ListView x:Name="SidebarGameList"
                                  Grid.Row="2"
                                  ItemsSource="{Binding SidebarFilteredGames}"
                                  SelectedItem="{Binding SidebarSelectedItem, Mode=TwoWay}"
                                  IsEnabled="{Binding IsUiEnabled}"
                                  SelectionMode="Single"
                                  SelectionChanged="SidebarGameList_SelectionChanged"
                                  ContainerContentChanging="SidebarGameList_ContainerContentChanging"
                                  BorderThickness="0"
                                  Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Height"
                                            Value="{StaticResource SidebarGameRowHeight}"/>
                                    <Setter Property="Padding"
                                            Value="12,0,14,0"/>
                                    <Setter Property="Margin"
                                            Value="-4,-2,-4,-2"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Game">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3"
                                    Spacing="6"
                                    Margin="4,0,4,0">
                            <Grid Height="160"
                                  Margin="0,0,0,8">
                                <Image Source="ms-appx:///Assets/shrimpSleep.png"
                                       Stretch="Uniform"/>
                                <Button x:Name="SidebarAddButton"
                                        Content="Settings"
                                        IsEnabled="{Binding IsUiEnabled}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,105,4"
                                        Padding="12,6"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Background="#A0363636"
                                        BorderBrush="#A9363636"
                                        Click="ManageButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Library grid UserControl -->
                <views:LibraryView Grid.Column="1"
                                   Margin="22,32,22,0"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Visibility="{Binding IsLibraryGridVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Canvas.ZIndex="0"/>

                <!-- Game detail UserControl -->
                <views:GameDetailView Grid.Column="1"
                                      Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Canvas.ZIndex="1"/>
            </Grid>
        </Grid>

        <!-- Global app-level overlays -->
        <Grid Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="True">
            <!-- Admin warning toast -->
            <Border x:Name="AdminWarningToast"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,32,32,0"
                    Background="#1C1C1C"
                    BorderBrush="#FFD700"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7BA;"
                              FontSize="16"
                              Foreground="#FFD700"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" MaxWidth="260">
                        <TextBlock Text="Running as Administrator"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD700"/>
                        <TextBlock Text="Some features may not work correctly."
                                   FontSize="12"
                                   Foreground="#FFD700"
                                   TextWrapping="Wrap"
                                   Opacity="0.8"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FFD700"
                            FontSize="12"
                            Padding="4,0"
                            VerticalAlignment="Top"
                            Click="AdminWarningClose_Click"/>
                </Grid>
            </Border>

            <!-- Import status card -->
            <Border Visibility="{Binding IsImportStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="16,14"
                    MinWidth="220">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ProgressRing Grid.Column="0"
                                  IsActive="{Binding IsImportStatusVisible, Mode=OneWay}"
                                  Width="28"
                                  Height="28"
                                  VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Adding to Library"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AddedCount, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                                <TextBlock Text="added"
                                           FontSize="12"
                                           Foreground="#555555"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImportRemainingCount, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#444444"
                                           VerticalAlignment="Center"
                                           FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                                <TextBlock Text="processing"
                                           FontSize="12"
                                           Foreground="#444444"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scan complete card -->
            <Border Visibility="{Binding IsScanCompleteEffectiveVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="16,14"
                    MinWidth="220">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE73E;"
                              FontSize="22"
                              Foreground="#4CAF50"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Scan Complete"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScanCompleteAddedCount, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                            <TextBlock Text="games added"
                                       FontSize="12"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Game not added toast -->
            <Border Visibility="{Binding IsGameNotAddedToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="16,14"
                    MinWidth="220">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE783;"
                              FontSize="22"
                              Foreground="#E57373"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Game could not be added"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </Grid>
            </Border>

            <!-- Game already in library toast -->
            <Border Visibility="{Binding IsGameAlreadyAddedToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="16,14"
                    MinWidth="220">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE8F1;"
                              FontSize="22"
                              Foreground="#FFB74D"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Game already in library"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </Grid>
            </Border>

            <!-- Startup background scan toast -->
            <Border Visibility="{Binding IsStartupScanToastVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="#1C1C1C"
                    CornerRadius="8"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Looking for new games"
                               FontSize="13"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsScanProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#BF1C1C1C"
                        Padding="24"
                        CornerRadius="8"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ScanProgressMessage}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                <ProgressBar Width="320"
                             Height="8"
                             IsIndeterminate="{Binding ScanProgressIsIndeterminate}"
                             Minimum="{Binding ScanProgressMinimum}"
                             Maximum="{Binding ScanProgressMaximum}"
                             Value="{Binding ScanProgressValue}"/>
            </StackPanel>

            <ProgressRing IsActive="{Binding IsAppSpinnerActive}"
                          Visibility="{Binding IsAppSpinnerActive, Converter={StaticResource BoolToVisibilityConverter}}"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <Grid x:Name="MediaOverlay"
                  Visibility="{Binding IsMediaOverlayOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid Background="#E0000000"
                      Tapped="MediaScrim_Tapped"/>

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="64">
                    <Grid MaxWidth="1200"
                          MaxHeight="800"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Button Content="✕"
                                Command="{Binding CloseMediaOverlayCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="24"
                                FontWeight="Bold"
                                Margin="0,-48,0,0"
                                Foreground="White"/>

                        <FlipView x:Name="MediaOverlayFlipView"
                                  ItemsSource="{Binding SelectedGame.Media}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent">
                            <FlipView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <MediaPlayerElement AreTransportControlsEnabled="True"
                                                            Source="{Binding Converter={StaticResource UriToMediaSourceConverter}}"
                                                            AutoPlay="False"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}"/>
                                        <Image Source="{Binding}"
                                               Stretch="Uniform"
                                               Visibility="{Binding Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=image}"/>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Franchise Timeline Overlay -->
            <Grid x:Name="FranchiseOverlay"
                  Visibility="{Binding IsFranchiseOverlayOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid Background="#E0000000"
                      Tapped="FranchiseScrim_Tapped"/>
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="48,72,48,48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <RadioButton Content="{Binding FranchiseMainlineLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=0, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                            <RadioButton Content="{Binding FranchiseExtendedLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                            <RadioButton Content="{Binding FranchiseAllLabel}"
                                         IsChecked="{Binding FranchiseFilterMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"
                                         GroupName="FranchiseFilter"
                                         Style="{StaticResource FranchiseFilterRadioButtonStyle}"/>
                        </StackPanel>
                        <Button Content="✕"
                                Command="{Binding CloseFranchiseOverlayCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="White"/>
                    </Grid>

                    <!-- Timeline fills remaining vertical space -->
                    <views:FranchiseTimelineControl Grid.Row="1"
                                                    Items="{Binding FranchiseTimelineItems}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>

        </Grid>

        <!-- Onboarding overlay for first launch / empty library -->
        <Grid x:Name="OnboardingOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#FF1C1C1C"
              IsHitTestVisible="True">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="1100"
                  Margin="0,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="ms-appx:///Assets/shrimpStand.png"
                       Height="360"
                       Stretch="Uniform"/>

                <StackPanel Grid.Column="2"
                            Spacing="12"
                            VerticalAlignment="Center"
                            MaxWidth="520">
                    <TextBlock Text="Welcome to Codec!"
                               FontSize="28"
                               FontWeight="Bold"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="I'm Shrimp, and I'd love to guide you through Codec."
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="I'll try to find all your games for you, but you can always add any that I miss later on. If you'd rather skip that for now, you're free to use the button below."
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="My goal is to make collecting games as easy and fun as possible—no matter where they came from. If something doesn't work right or you need a hand, you can reach out to my creator on GitHub."
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"
                               Foreground="#FF868686"/>
                    <TextBlock Text="Thank you for giving Codec a try."
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="4,0,0,0">
                        <Button Content="Start"
                                FontWeight="SemiBold"
                                Padding="24,8"
                                Click="OnboardingStart_Click"/>
                        <Button Content="Skip"
                                FontWeight="SemiBold"
                                Padding="24,8"
                                Click="OnboardingSkip_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True">
            <Grid Background="#BF000000"
                  Tapped="SettingsScrim_Tapped"/>
            <Border Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="32"
                    MinWidth="320"
                    MaxWidth="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Settings"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="8,4"
                                Click="SettingsClose_Click"/>
                    </Grid>
                    <ToggleSwitch Header="Scan for games on startup"
                                  IsOn="{Binding ScanOnStartup, Mode=TwoWay}"
                                  Margin="0,-8,0,-8"/>
                    <ToggleSwitch Header="Launch Steam on startup"
                                  IsOn="{Binding LaunchSteamSilent, Mode=TwoWay}"
                                  Margin="0,-8,0,-8"/>
                    <Border Height="1"
                            Background="#333333"/>
                    <Button Content="Scan for Games"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding CanStartScan}"
                            Click="SidebarAddGames_Click"/>
                    <Button Content="Add by Executable"
                            HorizontalAlignment="Stretch"
                            Click="AddGame_Click"/>
                    <Button Content="Reset App"
                            HorizontalAlignment="Stretch"
                            Foreground="#FF6B6B"
                            Click="ResetApp_Click"/>
                    <Button x:Name="SidebarDebugButton"
                            Content="Debug"
                            IsEnabled="{Binding IsUiEnabled}"
                            Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"
                            FontWeight="SemiBold">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Debug Data"
                                                Click="Debug_Click"/>
                                <MenuFlyoutItem Text="Refresh Covers"
                                                Click="RefreshCovers_Click"/>
                                <MenuFlyoutItem Text="Check IDs"
                                                Click="DebugCheckIds_Click"/>
                                <MenuFlyoutItem Text="Start Steam Silent"
                                                Click="DebugLaunchSteamSilent_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Reset confirmation overlay -->
        <Grid x:Name="ResetConfirmOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsResetConfirmVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True">
            <Grid Background="#CC000000"
                  Tapped="ResetScrim_Tapped"/>
            <Border Background="#1C1C1C"
                    CornerRadius="14"
                    Padding="28"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20">

                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,0">
                            <Border BorderBrush="#44FF6B6B"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="0">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="#FF6B6B"/>
                            </Border>
                            <TextBlock Text="Reset Codec"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Padding="7,2,6,4"
                                Foreground="#666666"
                                Click="ResetCancel_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#999999"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#666666"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                                <TextBlock Text="THIS WILL DELETE"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           CharacterSpacing="100"/>
                                <TextBlock Text="Game library Data · Cached artwork · App settings"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="#666666"
                                           TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                        <TextBlock Text="THIS WONT DELETE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#444444"
                                       CharacterSpacing="100"/>
                            <TextBlock Text="Your Games · Your game files or saves."
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel -->
                        <Button Grid.Column="0"
                                Content="Cancel"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,11"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="#252525"
                                BorderBrush="#383838"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="#AAAAAA"
                                Click="ResetCancel_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E2E2E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#484848"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#505050"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#CCCCCC"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#AAAAAA"/>
                            </Button.Resources>
                        </Button>

                        <!-- Delete -->
                        <Button Grid.Column="1"
                                Content="Delete Everything"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,11"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="#33FF6B6B"
                                BorderBrush="#66FF6B6B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="#FF6B6B"
                                Click="ResetConfirm_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4DFF6B6B"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66FF6B6B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#99FF6B6B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#BBFF6B6B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF8A8A"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF6B6B"/>
                            </Button.Resources>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Fire reset animation overlay -->
        <Grid x:Name="FireOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Rectangle x:Name="FireDarkBackground"
                       Fill="#FF000000"
                       Opacity="0"/>
            <Canvas x:Name="FireParticleCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Rectangle x:Name="FireBottomGlow"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Stretch"
                       Height="360"
                       Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1"
                                         EndPoint="0,0">
                        <GradientStop Color="#FF000000"
                                      Offset="0"/>
                        <GradientStop Color="#DDFF3300"
                                      Offset="0.35"/>
                        <GradientStop Color="#AAFF8800"
                                      Offset="0.65"/>
                        <GradientStop Color="#00FF4400"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Startup overlay — fades out via code-behind when library is ready -->
        <Border x:Name="StartupOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="#FF1C1C1C"
                IsHitTestVisible="True">
            <Border.RenderTransform>
                <CompositeTransform/>
            </Border.RenderTransform>
        </Border>

        <!-- ===== Update toasts (above StartupOverlay so visible during launch) ===== -->

        <!-- Update: checking toast -->
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsUpdateCheckingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Background="#1C1C1C"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <ProgressRing IsActive="True"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Checking for updates..."
                           FontSize="13"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
            </StackPanel>
        </Border>

        <!-- Update: downloading toast -->
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsUpdateDownloadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Background="#1C1C1C"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                MinWidth="260">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE896;"
                              FontSize="16"
                              Foreground="#64B5F6"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Downloading update"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="{Binding UpdateDownloadProgress}"
                               FontSize="13"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="%"
                               FontSize="13"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </StackPanel>
                <ProgressBar Value="{Binding UpdateDownloadProgress}"
                             Minimum="0"
                             Maximum="100"
                             Width="228"
                             Height="4"
                             HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Update: error toast -->
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsUpdateErrorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Background="#1C1C1C"
                BorderBrush="#552222"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                MinWidth="260"
                MaxWidth="360">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE783;"
                          FontSize="20"
                          Foreground="#E57373"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Update failed"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E57373"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="{Binding UpdateErrorMessage}"
                               FontSize="11"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888888"
                        FontSize="12"
                        Padding="4,0"
                        VerticalAlignment="Top"
                        Click="UpdateErrorClose_Click"/>
            </Grid>
        </Border>

        <!-- Update: no update found toast -->
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsUpdateNoUpdateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Background="#1C1C1C"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                MinWidth="220">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE73E;"
                          FontSize="20"
                          Foreground="#4CAF50"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="You're on the latest version"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888888"
                        FontSize="12"
                        Padding="4,0"
                        VerticalAlignment="Top"
                        Click="UpdateNoUpdateClose_Click"/>
            </Grid>
        </Border>

        <!-- Update: ready banner -->
        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Background="#1C1C1C"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                MinWidth="260">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE777;"
                          FontSize="22"
                          Foreground="#64B5F6"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Update available"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#999999"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="Downloaded and ready to install"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Restart"
                        VerticalAlignment="Center"
                        Click="RestartToUpdate_Click"
                        Background="#1976D2"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Padding="12,6"
                        CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Loading overlay for initial load or scanning -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsLoadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#FF1C1C1C"
              IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,32,0">
                <Image Source="ms-appx:///Assets/shrimpRun.png"
                       Height="320"
                       Stretch="Uniform"/>
                <StackPanel Spacing="4"
                            VerticalAlignment="Center"
                            MaxWidth="460">
                    <TextBlock Text="{Binding LoadingTitle}"
                               FontSize="28"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"/>
                    <TextBlock Text="{Binding LoadingSubtitle}"
                               FontSize="18"
                               TextWrapping="WrapWholeWords"
                               FontFamily="ms-appx:///Assets/Fonts/Sansation-Bold.ttf#Sansation"
                               Foreground="#FF868686"/>
                    <ProgressBar Width="445"
                                 Height="8"
                                 CornerRadius="16"
                                 IsIndeterminate="True"
                                 Foreground="#FF5BDFFF"
                                 Background="#FF2A2A2A"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
