<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Codec.Views.LibraryView"
    x:Name="LibraryViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codec.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SortOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid CornerRadius="6">
                            <Border x:Name="HoverBorder"
                                    CornerRadius="6"
                                    Background="Transparent"/>
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Background" Value="#252525"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Background" Value="#2E2E2E"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryCoverButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid x:Name="CardHost"
                                  Margin="4,4,4,10">
                                <Border x:Name="ShadowLayer"
                                        Margin="0,8,0,0"
                                        Background="#24000000"
                                        CornerRadius="12"
                                        Opacity="0.42">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ShadowTranslateTransform"/>
                                    </Border.RenderTransform>
                                </Border>

                                <Grid x:Name="ContentLift">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ContentLiftTransform"/>
                                    </Grid.RenderTransform>

                                    <ContentPresenter x:Name="ContentPresenter"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                    <Border x:Name="HoverTint"
                                            Background="#FFFFFF"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="0"/>

                                    <Border x:Name="HoverOutline"
                                            Background="Transparent"
                                            BorderBrush="#FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="0.08"/>
                                </Grid>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.24"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.24"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.42"
                                                             Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08"
                                                             Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-4"
                                                             Duration="0:0:0.28"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="4"
                                                             Duration="0:0:0.28"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7"
                                                             Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.04"
                                                             Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14"
                                                             Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-2"
                                                             Duration="0:0:0.18"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="2"
                                                             Duration="0:0:0.18"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.58"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.07"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.16"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardHost.Opacity"
                                                    Value="0.6"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#9E8E78"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#2E2E2E"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#484848"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#F3EDC9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#333333"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#505050"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#9E8E78"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                    
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#E76C2B"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#E76C2B"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#F87D3C"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#F87D3C"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#D65C1A"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#D65C1A"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sort bar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,-20,0,8">
            <Button x:Name="SortButton"
                    Background="#252525"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E2E2E"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#484848"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#505050"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#AAAAAA"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding SortLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE70D;"
                               FontSize="9"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="Bottom">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="#1C1C1C"/>
                                <Setter Property="BorderBrush" Value="#383838"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="MinWidth" Value="160"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Spacing="2">
                            <Button x:Name="SortAlphaButton"
                                    Content="Alphabetic"
                                    Tag="0"
                                    Foreground="#FFFFFF"
                                    Style="{StaticResource SortOptionButtonStyle}"
                                    Click="SortOption_Click"/>
                            <Button x:Name="SortFolderSizeButton"
                                    Content="Folder Size"
                                    Tag="1"
                                    Foreground="#888888"
                                    Style="{StaticResource SortOptionButtonStyle}"
                                    Click="SortOption_Click"/>
                            <Button x:Name="SortDateAddedButton"
                                    Content="Date Added"
                                    Tag="2"
                                    Foreground="#888888"
                                    Style="{StaticResource SortOptionButtonStyle}"
                                    Click="SortOption_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ItemsControl ItemsSource="{Binding AvailableImportSources}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ImportFilterItem">
                        <ToggleButton Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource FilterToggleButtonStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      x:Name="LibraryScroller"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="LibraryItemsRepeater"
                           Width="{x:Bind LibraryScroller.ViewportWidth, Mode=OneWay}"
                           ItemsSource="{Binding DisplayedGames}"
                           HorizontalAlignment="Stretch">
                <ItemsRepeater.Layout>
                    <UniformGridLayout x:Name="LibraryItemsLayout"
                                       MinItemWidth="210"
                                       MinItemHeight="315"
                                       MinColumnSpacing="12"
                                       MinRowSpacing="12"
                                       ItemsStretch="Uniform"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Button Click="LibraryItem_Click"
                                Style="{StaticResource LibraryCoverButtonStyle}"
                                ClickMode="Press"
                                Tag="{x:Bind}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Grid>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8">
                                    <Image Source="{x:Bind LibraryCapsule}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>

</UserControl>
