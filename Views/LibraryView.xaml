<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Codec.Views.LibraryView"
    x:Name="LibraryViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Codec.Models"
    xmlns:conv="using:Codec.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SortOptionToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource CodecSemiBoldFontFamily}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#9E8E78"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#25221F"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#F3EDC9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#2E2A25"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#9E8E78"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>

                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#E76C2B"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#F87D3C"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#D65C1A"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25221F"/>
            <Setter Property="BorderBrush" Value="#3E3830"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#9E8E78"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#2E2A25"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#5E5346"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#F3EDC9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#342F29"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#6A5A4A"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#9E8E78"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryDrawerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#9E8E78"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="DrawerIconPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Opacity="0.72"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="DrawerIconPresenter.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="DrawerIconPresenter.Opacity" Value="0.48"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryCoverButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid x:Name="CardHost"
                                  Margin="4,4,4,10">
                                <Border x:Name="ShadowLayer"
                                        Margin="0,8,0,0"
                                        Background="#331C1A17"
                                        CornerRadius="12"
                                        Opacity="0.42">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ShadowTranslateTransform"/>
                                    </Border.RenderTransform>
                                </Border>

                                <Grid x:Name="ContentLift">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ContentLiftTransform"/>
                                    </Grid.RenderTransform>

                                    <ContentPresenter x:Name="ContentPresenter"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                    <Border x:Name="HoverTint"
                                            Background="#F3EDC9"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="0"/>

                                    <Border x:Name="HoverOutline"
                                            Background="Transparent"
                                            BorderBrush="#F3EDC9"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Opacity="0.08"/>
                                </Grid>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.24"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.24"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.42"
                                                             Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08"
                                                             Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-4"
                                                             Duration="0:0:0.28"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="4"
                                                             Duration="0:0:0.28"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7"
                                                             Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.04"
                                                             Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14"
                                                             Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentLiftTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-2"
                                                             Duration="0:0:0.18"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowTranslateTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="2"
                                                             Duration="0:0:0.18"
                                                             EnableDependentAnimation="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.58"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverTint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.07"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.16"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardHost.Opacity"
                                                    Value="0.6"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#25221F"/>
            <Setter Property="BorderBrush" Value="#3E3830"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#9E8E78"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource CodecSemiBoldFontFamily}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#2E2A25"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#5E5346"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#F3EDC9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#342F29"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#6A5A4A"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#9E8E78"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                    
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#E76C2B"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#E76C2B"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#F87D3C"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#F87D3C"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundBorder.Background" Value="#D65C1A"/>
                                            <Setter Target="BackgroundBorder.BorderBrush" Value="#D65C1A"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#1C1A17"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#D91C1A17"/>
            <Setter Property="BorderBrush" Value="#70D4A832"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Foreground" Value="#D4A832"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Library toolbar -->
        <Grid Grid.Row="0"
              Margin="0,-20,0,8"
              Visibility="{Binding IsEmptyLibrary, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LibrarySidebarOpenButton"
                            Style="{StaticResource LibraryDrawerButtonStyle}"
                            Command="{Binding ToggleSidebarCommand}"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Open sidebar"
                            AutomationProperties.Name="Open sidebar"
                            VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="18" Height="18">
                                <Path Data="M4,3.5 L14,3.5 Q15.5,3.5 15.5,5 L15.5,13 Q15.5,14.5 14,14.5 L4,14.5 Q2.5,14.5 2.5,13 L2.5,5 Q2.5,3.5 4,3.5 Z M7,3.5 L7,14.5"
                                      Stroke="{Binding Foreground, ElementName=LibrarySidebarOpenButton}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="SortButton"
                    Style="{StaticResource SortButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding SortLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                               VerticalAlignment="Center"/>
                    <FontIcon Glyph="{Binding SortIconGlyph}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedLeft">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="#1C1A17"/>
                                <Setter Property="BorderBrush" Value="#3E3830"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="MinWidth" Value="160"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Spacing="2">
                            <ToggleButton x:Name="SortAlphaAscButton"
                                          Tag="0"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Alphabetic"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74B;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SortAlphaDescButton"
                                          Tag="1"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Alphabetic"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74A;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SortFolderDescButton"
                                          Tag="2"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Folder Size"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74B;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SortFolderAscButton"
                                          Tag="3"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Folder Size"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74A;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SortDateDescButton"
                                          Tag="4"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Date Added"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74B;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SortDateAscButton"
                                          Tag="5"
                                          Style="{StaticResource SortOptionToggleButtonStyle}"
                                          Click="SortOption_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Date Added"
                                               FontFamily="{StaticResource CodecSemiBoldFontFamily}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE74A;" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                    </Button>

                    <ToggleButton x:Name="InstallFilterAll"
                                  Content="All"
                                  Tag="0"
                                  Click="InstallFilter_Click"
                                  Style="{StaticResource FilterToggleButtonStyle}"/>
                    <ToggleButton x:Name="InstallFilterInstalled"
                                  Content="Installed"
                                  Tag="1"
                                  IsChecked="True"
                                  Click="InstallFilter_Click"
                                  Style="{StaticResource FilterToggleButtonStyle}"/>
                    <ToggleButton x:Name="InstallFilterOwnedOnly"
                                  Content="Not installed"
                                  Tag="2"
                                  Click="InstallFilter_Click"
                                  Style="{StaticResource FilterToggleButtonStyle}"/>

                    <ItemsControl ItemsSource="{Binding AvailableImportSources}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ImportFilterItem">
                                <ToggleButton Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <ScrollViewer Grid.Row="1"
                      x:Name="LibraryScroller"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsEmptyLibrary, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}">
            <ItemsRepeater x:Name="LibraryItemsRepeater"
                           Width="{x:Bind LibraryScroller.ViewportWidth, Mode=OneWay}"
                           ItemsSource="{Binding DisplayedGames}"
                           HorizontalAlignment="Stretch">
                <ItemsRepeater.Layout>
                    <UniformGridLayout x:Name="LibraryItemsLayout"
                                       MinItemWidth="210"
                                       MinItemHeight="315"
                                       MinColumnSpacing="12"
                                       MinRowSpacing="12"
                                       ItemsStretch="Uniform"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:Game">
                        <Grid>
                            <Button Click="LibraryItem_Click"
                                    Style="{StaticResource LibraryCoverButtonStyle}"
                                    ClickMode="Press"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Grid>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8">
                                    <Image Source="{x:Bind LibraryCapsule}"
                                           Stretch="UniformToFill"
                                           ImageOpened="LibraryCover_ImageOpened"
                                           Opacity="{x:Bind LibraryCardOpacity, Mode=OneWay}"/>
                                </Border>

                                <Border Background="#E61C1A17"
                                        BorderBrush="#90D4A832"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="10"
                                        Padding="7,4"
                                        Visibility="{x:Bind IsOwnedOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="NOT INSTALLED"
                                               FontSize="9"
                                               CharacterSpacing="45"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource CodecBoldFontFamily}"
                                               Foreground="#D4A832"/>
                                </Border>

                                <!-- Folder Size Tag -->
                                <Border Background="#D51C1A17"
                                        BorderBrush="#60E76C2B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="6,3"
                                        Visibility="{Binding ElementName=LibraryViewRoot, Path=DataContext.ShowFolderSizeTag, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind FolderSizeDisplay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource CodecBoldFontFamily}"
                                               Foreground="#F3EDC9"/>
                                </Border>

                                <!-- Date Added Tag -->
                                <Border Background="#D51C1A17"
                                        BorderBrush="#60E76C2B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10"
                                        Padding="6,3"
                                        Visibility="{Binding ElementName=LibraryViewRoot, Path=DataContext.ShowDateAddedTag, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind DateAddedDisplay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource CodecBoldFontFamily}"
                                               Foreground="#F3EDC9"/>
                                </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource FavoriteIconButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Command="{Binding ElementName=LibraryViewRoot, Path=DataContext.ToggleFavoriteCommand}"
                                    CommandParameter="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind FavoriteToolTip, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind FavoriteToolTip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="15"
                                          Foreground="#D4A832"
                                          Opacity="{x:Bind FavoriteOpacity, Mode=OneWay}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Grid Grid.RowSpan="2"
              Visibility="{Binding IsEmptyLibrary, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <StackPanel Width="420"
                        MaxWidth="{Binding ActualWidth, ElementName=LibraryViewRoot}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="24">
                <Grid Height="210" Margin="0,0,0,4">
                    <Border Width="280"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#1025221F"
                            BorderBrush="#303E3830"
                            BorderThickness="1"
                            CornerRadius="140,140,18,18"/>
                    <Image Source="ms-appx:///Assets/shrimpSleep.png"
                           Width="260"
                           Height="200"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Opacity="0.82"/>
                </Grid>
                <TextBlock Text="No games here yet"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"
                           FontFamily="{StaticResource CodecBoldFontFamily}"
                           Foreground="#F3EDC9"/>
                <TextBlock Text="Scan your PC or add a game by executable from the sidebar."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="390"
                           FontSize="13"
                           FontFamily="{StaticResource CodecRegularFontFamily}"
                           Foreground="#9E8E78"/>
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>
